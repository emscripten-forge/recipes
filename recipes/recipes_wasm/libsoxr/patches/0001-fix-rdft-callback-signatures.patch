The rdft callback tables (fn_t arrays) are called through the prototypes in
rdft_t.h, e.g. rdft_delete_setup as void(*)(void *) and rdft_forward /
rdft_reorder_back as void(*)(int, void *, void *, void *). In 0.1.3 the plain
C FFT backends define null(void), nothing(void) and 3-argument
forward/backward, so the indirect calls have a different signature than the
callee. That happens to work natively but traps in WebAssembly with
"RuntimeError: function signature mismatch" (call_indirect type check).
Backport of the upstream fix (libsoxr git master after 0.1.3).

diff --git a/src/avfft32.c b/src/avfft32.c
--- a/src/avfft32.c
+++ b/src/avfft32.c
@@ -9,9 +9,9 @@

 static void * forward_setup(int len) {return av_rdft_init((int)(log(len)/log(2)+.5),DFT_R2C);}
 static void * backward_setup(int len) {return av_rdft_init((int)(log(len)/log(2)+.5),IDFT_C2R);}
-static void rdft(int length, void * setup, float * h) {av_rdft_calc(setup, h); (void)length;}
+static void rdft(int length, void * setup, float * h, void * scratch) {av_rdft_calc(setup, h); (void)length; (void)scratch;}
 static int multiplier(void) {return 2;}
-static void nothing(void) {}
+static void nothing(int length, void * setup, void * H, void * scratch) {(void)length; (void)setup; (void)H; (void)scratch;}
 static int flags(void) {return 0;}

 fn_t _soxr_rdft32_cb[] = {
