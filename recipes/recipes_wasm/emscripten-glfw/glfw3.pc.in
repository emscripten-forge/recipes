prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${prefix}/lib
includedir=${prefix}/include

Name: GLFW
Description: A multi-platform library for OpenGL, window and input (Emscripten port)
Version: @GLFW_API_VERSION@
URL: https://www.glfw.org/
Libs: ${libdir}/@GLFW_LIBRARY_FILE@ -lGL --js-library=${prefix}/share/glfw/glfw3.js -sMAX_WEBGL_VERSION=2 -sDEFAULT_TO_CXX
Cflags: -I${includedir} -DEMSCRIPTEN_USE_PORT_CONTRIB_GLFW3=@PKG_VERSION_TAG@
