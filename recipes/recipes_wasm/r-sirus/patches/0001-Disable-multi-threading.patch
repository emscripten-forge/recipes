From e8b1d09aa430e688aa82292d893ff4178c2fca48 Mon Sep 17 00:00:00 2001
From: Isabel Paredes <isabel.paredes@quantstack.net>
Date: Thu, 15 Oct 2026 18:46:36 +0200
Subject: [PATCH] Disable multi-threading

---
 src/Forest.h | 2 +-
 src/Makevars | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/Forest.h b/src/Forest.h
index 21f85ec..347c925 100644
--- a/src/Forest.h
+++ b/src/Forest.h
@@ -17,12 +17,12 @@
 #include <random>
 #include <ctime>
 #include <memory>
+#include <map>
 #ifndef OLD_WIN_R_BUILD
 #include <thread>
 #include <chrono>
 #include <mutex>
 #include <condition_variable>
-#include <map>
 #endif
 
 #include "globals.h"
diff --git a/src/Makevars b/src/Makevars
index 89fd506..60cbe90 100644
--- a/src/Makevars
+++ b/src/Makevars
@@ -1,4 +1,4 @@
 ## Use c++11
 CXX_STD = CXX11
-PKG_CPPFLAGS = -DR_BUILD
+PKG_CPPFLAGS = -DR_BUILD -DOLD_WIN_R_BUILD
 
-- 
2.56.0

