 ThreadLogger::~ThreadLogger()
 {
+#if !defined(__EMSCRIPTEN__)
   if (m_Thread.joinable())
   {
     m_TerminationRequested = true;
     m_Thread.join(); // waits for it to finish if necessary
   }
+#endif
 }
 
