From 15797414692fc9f98b921bb08bdb556bcf25a6e6 Mon Sep 17 00:00:00 2001
From: Gyeongjae Choi <def6488@gmail.com>
Date: Mon, 16 Nov 2026 21:16:55 +0900
Subject: [PATCH] Fall back to a pure-Python PBKDF2 when hashlib.pbkdf2_hmac is
 missing

---
 asyncpg/protocol/scram.pyx | 11 ++++++++++-
 1 file changed, 10 insertions(+), 1 deletion(-)

diff --git a/asyncpg/protocol/scram.pyx b/asyncpg/protocol/scram.pyx
index 0ce3093..af1f0d2 100644
--- a/asyncpg/protocol/scram.pyx
+++ b/asyncpg/protocol/scram.pyx
@@ -241,7 +241,16 @@ cdef class SCRAMAuthentication:
         # hashlib.pbkdf2_hmac is PBKDF2-HMAC-SHA256: the same output as the
         # Python loop this replaces, computed in C.  SHA-256 is hardcoded
         # because SCRAM-SHA-256 is the only method this class supports.
-        return hashlib.pbkdf2_hmac("sha256", p, s, iterations)
+        if hasattr(hashlib, "pbkdf2_hmac"):
+            return hashlib.pbkdf2_hmac("sha256", p, s, iterations)
+        # hashlib.pbkdf2_hmac needs OpenSSL, which is not available in
+        # e.g. Pyodide; fall back to the pure-Python RFC 5802 "Hi" loop.
+        ui = hmac.new(p, s + b'\x00\x00\x00\x01', self.DIGEST)
+        u = ui.digest()
+        for x in range(iterations - 1):
+            ui = hmac.new(p, ui.digest(), hashlib.sha256)
+            u = self._bytes_xor(u, ui.digest())
+        return u
 
     cdef _normalize_password(self, str original_password):
         """Normalize the password using the SASLprep from RFC4013"""
