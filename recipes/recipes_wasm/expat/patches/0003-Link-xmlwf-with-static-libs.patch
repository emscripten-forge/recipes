From: Isabel Paredes <isabel.paredes@quantstack.net>
Date: Wed, 23 Sep 2026 18:49:21 +0200
Subject: [PATCH 3/3] Link xmlwf with static libs

---
 xmlwf/Makefile.in | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/xmlwf/Makefile.in b/xmlwf/Makefile.in
index 480fd3e..518db91 100644
--- a/xmlwf/Makefile.in
+++ b/xmlwf/Makefile.in
@@ -379,7 +379,7 @@ xmlwf_SOURCES = \
     @FILEMAP@.c
 
 xmlwf_CPPFLAGS = @AM_CPPFLAGS@ -I$(srcdir)/../lib $(am__append_1)
-xmlwf_LDFLAGS = @AM_LDFLAGS@ @LIBM@ $(am__append_2)
+xmlwf_LDFLAGS = @AM_LDFLAGS@ @LIBM@ $(am__append_2) -static
 EXTRA_DIST = \
     codepage.h \
     ct.c \
