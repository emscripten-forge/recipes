From fc2e01c2de5a9a7cad41960da1baf58b0de228bf Mon Sep 17 00:00:00 2001
From: Isabel Paredes <isabel.paredes@quantstack.net>
Date: Wed, 23 Sep 2026 18:17:02 +0200
Subject: [PATCH 1/3] Enable shared libs

---
 configure | 27 ++++++++++++++++++++++++++-
 1 file changed, 26 insertions(+), 1 deletion(-)

diff --git a/configure b/configure
index c2f7bb7..052a974 100755
--- a/configure
+++ b/configure
@@ -6773,7 +6773,7 @@ irix5* | irix6* | nonstopux*)
   ;;
 
 # This must be glibc/ELF.
-linux* | k*bsd*-gnu | kopensolaris*-gnu | gnu*)
+linux* | k*bsd*-gnu | kopensolaris*-gnu | gnu* | emscripten*)
   lt_cv_deplibs_check_method=pass_all
   ;;
 
@@ -13089,6 +13089,15 @@ uts4*)
   shlibpath_var=LD_LIBRARY_PATH
   ;;
 
+emscripten*)
+  version_type=none
+  need_lib_prefix=no
+  need_version=no
+  library_names_spec='$libname$shared_ext'
+  finish_cmds=
+  dynamic_linker='Emscripten linker'
+  ;;
+
 *)
   dynamic_linker=no
   ;;
@@ -16404,6 +16413,13 @@ fi
         ld_shlibs_CXX=no
         ;;
 
+      emscripten*)
+        archive_cmds_CXX='$CC -shared $pic_flag $libobjs $deplibs $compiler_flags -o $lib'
+        archive_expsym_cmds_CXX=
+        hardcode_libdir_flag_spec_CXX='-L$libdir'
+        allow_undefined_flag_CXX=
+        ;;
+
       *)
         # FIXME: insert proper C++ library support
         ld_shlibs_CXX=no
@@ -18152,6 +18168,15 @@ uts4*)
   shlibpath_var=LD_LIBRARY_PATH
   ;;
 
+emscripten*)
+  version_type=none
+  need_lib_prefix=no
+  need_version=no
+  library_names_spec='$libname$shared_ext'
+  finish_cmds=
+  dynamic_linker='Emscripten linker'
+  ;;
+
 *)
   dynamic_linker=no
   ;;
