From d67e082c7ba8508ed9488e56bb236ace865dc22c Mon Sep 17 00:00:00 2001
From: Isabel Paredes <isabel.paredes@quantstack.net>
Date: Tue, 3 Nov 2026 19:31:38 +0100
Subject: [PATCH 3/3] Do not use system xml2-config

---
 configure | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/configure b/configure
index ba36b63..d05fe9e 100755
--- a/configure
+++ b/configure
@@ -1,7 +1,7 @@
 #!/bin/sh
 
 # Use xml2-config or pkg-config to get the include directories for libxml-2.0
-if xml2-config --version >/dev/null 2>&1; then
+if dont-use-xml2-config --version >/dev/null 2>&1; then
     libxml2_cflags=$(xml2-config --cflags)
     libxml2_libs=$(xml2-config --libs)
 elif pkg-config --version >/dev/null 2>&1; then
