From ef65e1381b2362a8c69313a322aa65fd026247dd Mon Sep 17 00:00:00 2001
From: Isabel Paredes <isabel.paredes@quantstack.net>
Date: Fri, 6 Nov 2026 14:32:51 +0100
Subject: [PATCH] Avoid NINT/IDNINT to work around wasm64 lround codegen

---
 SRC/cgejsv.f | 20 ++++++++++----------
 SRC/claqps.f |  2 +-
 SRC/dgejsv.f | 18 +++++++++---------
 SRC/dlacn2.f |  6 +++---
 SRC/dlacon.f |  6 +++---
 SRC/dlaqps.f |  2 +-
 SRC/iparmq.f |  3 ++-
 SRC/sgejsv.f | 18 +++++++++---------
 SRC/slacn2.f |  6 +++---
 SRC/slacon.f |  6 +++---
 SRC/slaqps.f |  2 +-
 SRC/zgejsv.f | 20 ++++++++++----------
 SRC/zlaqps.f |  2 +-
 13 files changed, 56 insertions(+), 55 deletions(-)

diff --git a/SRC/cgejsv.f b/SRC/cgejsv.f
index 8940c4c..8d42a5e 100644
--- a/SRC/cgejsv.f
+++ b/SRC/cgejsv.f
@@ -1540,7 +1540,7 @@
      $                N, V, LDV, CWORK, LWORK, RWORK, LRWORK, INFO )
 *
             SCALEM  = RWORK(1)
-            NUMRANK = NINT(RWORK(2))
+            NUMRANK = INT(ANINT(RWORK(2)))
 *
 *
       ELSE IF ( ( RSVEC .AND. ( .NOT. LSVEC ) .AND. ( .NOT. JRACC ) ) 
@@ -1561,7 +1561,7 @@
             CALL CGESVJ( 'L','U','N', N, NR, V, LDV, SVA, NR, A, LDA,
      $                  CWORK, LWORK, RWORK, LRWORK, INFO )
             SCALEM  = RWORK(1)
-            NUMRANK = NINT(RWORK(2))
+            NUMRANK = INT(ANINT(RWORK(2)))
 
          ELSE
 *
@@ -1584,7 +1584,7 @@
             CALL CGESVJ( 'L', 'U','N', NR, NR, V,LDV, SVA, NR, U,
      $                  LDU, CWORK(N+1), LWORK-N, RWORK, LRWORK, INFO )
             SCALEM  = RWORK(1)
-            NUMRANK = NINT(RWORK(2))
+            NUMRANK = INT(ANINT(RWORK(2)))
             IF ( NR .LT. N ) THEN
                CALL CLASET( 'A',N-NR, NR, CZERO,CZERO, V(NR+1,1),
      $                      LDV )
@@ -1616,7 +1616,7 @@
          CALL CGESVJ( 'U','N','V', N, N, A, LDA, SVA, N, V, LDV,
      $               CWORK, LWORK, RWORK, LRWORK, INFO )
           SCALEM  = RWORK(1)
-          NUMRANK = NINT(RWORK(2))
+          NUMRANK = INT(ANINT(RWORK(2)))
           CALL CLAPMR( .FALSE., N, N, V, LDV, IWORK )
 *
       ELSE IF ( LSVEC .AND. ( .NOT. RSVEC ) ) THEN
@@ -1643,7 +1643,7 @@
          CALL CGESVJ( 'L', 'U', 'N', NR,NR, U, LDU, SVA, NR, A,
      $        LDA, CWORK(N+1), LWORK-N, RWORK, LRWORK, INFO )
          SCALEM  = RWORK(1)
-         NUMRANK = NINT(RWORK(2))
+         NUMRANK = INT(ANINT(RWORK(2)))
 *
          IF ( NR .LT. M ) THEN
             CALL CLASET( 'A',  M-NR, NR,CZERO, CZERO, U(NR+1,1),
@@ -1872,7 +1872,7 @@
      $              CWORK(2*N+N*NR+NR+1),LWORK-2*N-N*NR-NR,RWORK,
      $              LRWORK, INFO )
                SCALEM  = RWORK(1)
-               NUMRANK = NINT(RWORK(2))
+               NUMRANK = INT(ANINT(RWORK(2)))
                DO 3970 p = 1, NR
                   CALL CCOPY(  NR, V(1,p), 1, U(1,p), 1 )
                   CALL CSSCAL( NR, SVA(p),    V(1,p), 1 )
@@ -1916,7 +1916,7 @@
      $              LDU, CWORK(2*N+N*NR+NR+1), LWORK-2*N-N*NR-NR,
      $              RWORK, LRWORK, INFO )
                SCALEM  = RWORK(1)
-               NUMRANK = NINT(RWORK(2))
+               NUMRANK = INT(ANINT(RWORK(2)))
                DO 3870 p = 1, NR
                   CALL CCOPY( NR, V(1,p), 1, U(1,p), 1 )
                   CALL CSSCAL( NR, SVA(p),    U(1,p), 1 )
@@ -1959,7 +1959,7 @@
      $              LDU, CWORK(2*N+N*NR+NR+1), LWORK-2*N-N*NR-NR,
      $                         RWORK, LRWORK, INFO )
                SCALEM  = RWORK(1)
-               NUMRANK = NINT(RWORK(2))
+               NUMRANK = INT(ANINT(RWORK(2)))
                IF ( NR .LT. N ) THEN
                   CALL CLASET( 'A',N-NR,NR,CZERO,CZERO,V(NR+1,1),
      $                         LDV )
@@ -2058,7 +2058,7 @@
      $       INFO )
 *
             SCALEM  = RWORK(1)
-            NUMRANK = NINT(RWORK(2))
+            NUMRANK = INT(ANINT(RWORK(2)))
             DO 6970 p = 1, N
                CALL CCOPY( N, CWORK(N+(p-1)*N+1), 1, U(1,p), 1 )
                CALL CSSCAL( N, SVA(p), CWORK(N+(p-1)*N+1), 1 )
@@ -2165,7 +2165,7 @@
      $        N, V, LDV, CWORK(2*N+N*NR+1), LWORK-2*N-N*NR,
      $         RWORK, LRWORK, INFO )
          SCALEM  = RWORK(1)
-         NUMRANK = NINT(RWORK(2))
+         NUMRANK = INT(ANINT(RWORK(2)))
 
          IF ( NR .LT. N ) THEN
             CALL CLASET( 'A',N-NR,NR,CZERO,CZERO,V(NR+1,1),LDV )
diff --git a/SRC/claqps.f b/SRC/claqps.f
index 418fe66..2c7dd70 100644
--- a/SRC/claqps.f
+++ b/SRC/claqps.f
@@ -355,7 +355,7 @@
 *
