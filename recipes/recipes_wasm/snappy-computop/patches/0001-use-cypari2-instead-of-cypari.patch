+else:  # Plain Python, use CyPari2
+    # CyPari (the standalone fork) has no source release that supports
+    # Python 3.13: its last sdist, 2.5.4, carries bindings generated by
+    # Cython 0.29.32, which use ob_digit, _PyGC_FINALIZED,
+    # curexc_traceback and the five-argument _PyLong_AsByteArray, all
+    # removed or changed by 3.13. Releases from 2.5.5 on ship wheels only.
+    #
+    # CyPari2 is the library CyPari forked from, is what the branch above
+    # already uses inside Sage, and exposes the same names. It also
+    # generates its bindings from PARI's own pari.desc at build time, so it
+    # tracks whatever PARI it is compiled against rather than a vendored
+    # copy.
+    import cypari2
+    cypari_version = parse_version(cypari2.__version__)
+    if cypari_version < parse_version('2.2.1'):
+        # 2.2.1 is "Port to Pari 2.17"; older versions do not build against
+        # the PARI this is linked to.
+        raise ValueError("you need a more recent version of CyPari2")
+    from cypari2 import Pari, Gen, PariError
+    from cypari2.pari_instance import (prec_words_to_dec,
+                                       prec_words_to_bits,
+                                       prec_bits_to_dec,
+                                       prec_dec_to_bits)
+    pari = Pari()
+
+    # CyPari's additions for silencing PARI's own output. CyPari2 has no
+    # equivalent, so these become no-ops, exactly as in the Sage branch
+    # above.
+    shut_up = lambda: None
+    speak_up = lambda: None
