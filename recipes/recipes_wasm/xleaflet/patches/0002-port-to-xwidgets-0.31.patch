diff --git a/CMakeLists.txt b/CMakeLists.txt
index 5ad7dae..5d0e097 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -101,6 +101,16 @@ if (NOT TARGET xtensor)
     find_package(xtensor ${xtensor_REQUIRED_VERSION} REQUIRED)
 endif ()
 
+# xtensor >= 0.28 needs C++20, but the xeus target exports --std=c++17 as an
+# interface compile option, which would come after (and override) ours
+if (TARGET xeus)
+    get_target_property(_xeus_opts xeus INTERFACE_COMPILE_OPTIONS)
+    if (_xeus_opts)
+        list(REMOVE_ITEM _xeus_opts "--std=c++17" "-std=c++17")
+        set_target_properties(xeus PROPERTIES INTERFACE_COMPILE_OPTIONS "${_xeus_opts}")
+    endif ()
+endif ()
+
 # Source files
 # ============
 
