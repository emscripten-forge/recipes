From: Isabel Paredes <isabel.paredes@quantstack.net>
Date: Tue, 13 Oct 2026 11:21:05 +0200
Subject: [PATCH] Avoid NINT to work around wasm64 lround codegen

---
 src/vgam.f | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/vgam.f b/src/vgam.f
index bd9f201..a327a2f 100644
--- a/src/vgam.f
+++ b/src/vgam.f
@@ -1023,7 +1023,7 @@ C Output from Public domain Ratfor, version 1.04
       if(kuzxj1lo .le. 40)then
       ndk = kuzxj1lo
       else
-      ndk = 40 + nint(dexp(0.25d0 * dlog(kuzxj1lo-40.0d0)))
+      ndk = 40 + int(anint(dexp(0.25d0 * dlog(kuzxj1lo-40.0d0))))
       endif
       else
       ndk = rvy1fpli - 6
