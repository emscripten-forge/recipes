emscripten-forge wasm64: pointers are i64, ie. BigInt in JS: the JS trampoline
returns them as BigInt and the wasm-gc trampoline pointer is passed as BigInt.
The wasm-gc trampoline module itself is built for wasm64 (build.sh).
Applies on top of 0016 / 0017.

diff --git a/Python/emscripten_trampoline.c b/Python/emscripten_trampoline.c
index 312c5a1..807064b 100644
--- a/Python/emscripten_trampoline.c
+++ b/Python/emscripten_trampoline.c
@@ -54,7 +54,12 @@ typedef PyObject* (*TrampolineFunc)(int* success,
  * Backwards compatible trampoline works with all JS runtimes
  */
 EM_JS(PyObject*, _PyEM_TrampolineCall_JS, (PyCFunctionWithKeywords func, PyObject *arg1, PyObject *arg2, PyObject *arg3), {
-    return wasmTable.get(func)(arg1, arg2, arg3);
+    // emscripten-forge wasm64: pointers are returned as BigInt
+    const ret = wasmTable.get(func)(arg1, arg2, arg3);
+    if (typeof ret === 'bigint') {
+        return ret;
+    }
+    return BigInt(ret || 0);
 }
 // Try to compile wasm-gc trampoline if possible.
 function getPyEMTrampolinePtr() {
@@ -99,7 +104,10 @@ addOnPreRun(function setEmscriptenTrampoline() {
     try {
         const ptr = getPyEMTrampolinePtr();
         if (ptr) {
-            wasmExports["_PyEM_SetTrampoline"](ptr);
+            // emscripten-forge wasm64: function pointers are i64 (BigInt);
+            // the trampoline module is built with -target wasm64-unknown-unknown
+            // (build.sh)
+            wasmExports["_PyEM_SetTrampoline"](typeof ptr === "bigint" ? ptr : BigInt(ptr));
         }
     } catch (e) {
         console.warn("python: could not set up the wasm-gc call trampoline, using the JS trampoline", e);
