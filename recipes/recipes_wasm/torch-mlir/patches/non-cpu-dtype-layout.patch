Subject: [PATCH] [Torch] Decompose dtype-layout casts on non-CPU devices

Backport to the LLVM/MLIR 23.1.2 snapshot.

diff --git a/lib/Dialect/Torch/Transforms/DecomposeComplexOps.cpp b/lib/Dialect/Torch/Transforms/DecomposeComplexOps.cpp
--- a/lib/Dialect/Torch/Transforms/DecomposeComplexOps.cpp
+++ b/lib/Dialect/Torch/Transforms/DecomposeComplexOps.cpp
@@ -9305,15 +9305,12 @@
             op, "unimplemented: pinMemory is expected to be false");
     }

-    // TODO: Add support for device arg other than cpu.
+    // Device placement is handled outside torch-mlir, as for aten.to.device.
     if (!isa<Torch::NoneType>(op.getDevice().getType())) {
       std::string device;
       if (!matchPattern(op.getDevice(), m_TorchConstantDevice(device)))
         return rewriter.notifyMatchFailure(
             op, "unimplemented: device must be a constant str");
-      else if (device != "cpu")
-        return rewriter.notifyMatchFailure(
-            op, "unimplemented: device is expected to be cpu");
     }

     // TODO: Add support for non-strided layout.
diff --git a/test/Dialect/Torch/decompose-complex-ops.mlir b/test/Dialect/Torch/decompose-complex-ops.mlir
--- a/test/Dialect/Torch/decompose-complex-ops.mlir
+++ b/test/Dialect/Torch/decompose-complex-ops.mlir
@@ -1352,3 +1352,35 @@
       -> !torch.vtensor<[5,5],f32>
   return %result : !torch.vtensor<[5,5],f32>
 }
+
+// -----
+
+// CHECK-LABEL: func.func @to_dtype_layout_non_cpu
+// CHECK-DAG: %[[DTYPE:.*]] = torch.constant.int 6
+// CHECK-DAG: %[[TRUE:.*]] = torch.constant.bool true
+// CHECK-DAG: %[[NONE:.*]] = torch.constant.none
+// CHECK: %[[CAST:.*]] = torch.aten.to.dtype %arg0, %[[DTYPE]], %[[TRUE]], %[[TRUE]], %[[NONE]]
+// CHECK: return %[[CAST]] : !torch.vtensor<[2],f32>
+func.func @to_dtype_layout_non_cpu(%arg0: !torch.vtensor<[2],si64>) -> !torch.vtensor<[2],f32> {
+  %dtype = torch.constant.int 6
+  %none = torch.constant.none
+  %device = torch.constant.device "cuda:0"
+  %true = torch.constant.bool true
+  %0 = torch.aten.to.dtype_layout %arg0, %dtype, %none, %device, %none, %true, %true, %none : !torch.vtensor<[2],si64>, !torch.int, !torch.none, !torch.Device, !torch.none, !torch.bool, !torch.bool, !torch.none -> !torch.vtensor<[2],f32>
+  return %0 : !torch.vtensor<[2],f32>
+}
+
+// -----
+
+// CHECK-LABEL: func.func @scalar_tensor_non_cpu
+// CHECK-NOT: torch.aten.to.dtype_layout
+// CHECK-NOT: torch.aten.to.device
+// CHECK: return {{.*}} : !torch.vtensor<[],f32>
+func.func @scalar_tensor_non_cpu() -> !torch.vtensor<[],f32> {
+  %zero = torch.constant.int 0
+  %dtype = torch.constant.int 6
+  %none = torch.constant.none
+  %device = torch.constant.device "cuda:0"
+  %0 = torch.aten.scalar_tensor %zero, %dtype, %none, %device, %none : !torch.int, !torch.int, !torch.none, !torch.Device, !torch.none -> !torch.vtensor<[],f32>
+  return %0 : !torch.vtensor<[],f32>
+}
