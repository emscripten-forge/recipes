From 2e14b0fa44a17de8e8cb5e3762e384e7914ebba3
Subject: [PATCH] Depend on the existing MLIR header target when installing headers
Upstream: https://github.com/llvm/torch-mlir/pull/4856 (merged)

Torch-MLIR attaches generated dialect headers to mlir-headers. The header
installer instead names torch-mlir-headers, which is not defined.

diff --git a/CMakeLists.txt b/CMakeLists.txt
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -241,7 +241,7 @@

   if (NOT LLVM_ENABLE_IDE)
     add_llvm_install_targets(install-torch-mlir-headers
-            DEPENDS torch-mlir-headers
+            DEPENDS mlir-headers
             COMPONENT torch-mlir-headers)
   endif()
 endif()
