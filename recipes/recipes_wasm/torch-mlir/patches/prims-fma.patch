+// CHECK: ^bb0(%[[A:.*]]: f32, %[[B:.*]]: f32, %[[C:.*]]: f32, %{{.*}}: f32):
+// CHECK-NEXT: %[[FMA:.*]] = math.fma %[[A]], %[[B]], %[[C]] : f32
