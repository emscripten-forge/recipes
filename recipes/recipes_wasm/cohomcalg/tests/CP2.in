% CP^2 (from the cohomCalg examples)
    vertex u1 = ( -1, -1 ) | PIC: H  | GLSM:  ( 1 );
    vertex u2 = (  1,  0 )           | GLSM:  ( 1 );
    vertex u3 = (  0,  1 )           | GLSM:  ( 1 );

    srideal [u1*u2*u3];

    monomialfile off;

% h^*(CP^2, O(-3)) = (0, 0, 1) and h^*(CP^2, O(2)) = (6, 0, 0)
    ambientcohom O( -3 );
    ambientcohom O(  2 );
