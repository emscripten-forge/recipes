diff --git a/core/packages/CMakeLists.txt b/core/packages/CMakeLists.txt
index 7898f6f..b7706b3 100644
--- a/core/packages/CMakeLists.txt
+++ b/core/packages/CMakeLists.txt
@@ -89,6 +89,24 @@ add_custom_target(
 
 find_package(GMPXX REQUIRED STATIC)
 
+if(EMBED_COMPILED_PACKAGES)
+  # The compiled packages are built into the cadabra2 module itself (see
+  # core/CMakeLists.txt); install small Python stubs which make them
+  # importable under their usual names.
+  foreach(PACKAGE ${COMPILED_PACKAGES})
+    get_filename_component(PINSTALL ${PACKAGE} DIRECTORY)
+    get_filename_component(PNAME ${PACKAGE} NAME_WE)
+    set(PSTUB "${CMAKE_CURRENT_BINARY_DIR}/cdb/${PINSTALL}/${PNAME}.py")
+    file(WRITE ${PSTUB}
+      "# The compiled package '${PNAME}' is built into the cadabra2 module.\n"
+      "import sys\n"
+      "import cadabra2\n"
+      "sys.modules[__name__] = cadabra2.${PNAME}\n")
+    install(FILES ${PSTUB} DESTINATION ${PYTHON_CDB_PACKAGE_PATH}/${PINSTALL})
+  endforeach()
+  set(COMPILED_PACKAGES "")
+endif()
+
 foreach(PACKAGE ${COMPILED_PACKAGES})
   SET(CMAKE_SKIP_BUILD_RPATH FALSE)
   SET(CMAKE_BUILD_WITH_INSTALL_RPATH TRUE)
