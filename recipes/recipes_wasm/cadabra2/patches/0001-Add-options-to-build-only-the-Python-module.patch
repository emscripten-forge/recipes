 endif()
 
 # Core/packages
-if(NOT PYPI_WHEEL)
+if(NOT PYPI_WHEEL AND NOT CADABRA_PYTHON_MODULE_ONLY)
   add_subdirectory(client_server)
 endif()
 add_subdirectory(core)
@@ -553,7 +582,7 @@ if(BUILD_TESTS)
