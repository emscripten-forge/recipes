From 700cb1c0915cfff1831c91073eadbd9e97526380 Mon Sep 17 00:00:00 2001
From: Isabel Paredes <isabel.paredes@quantstack.net>
Date: Thu, 5 Nov 2026 13:30:16 +0100
Subject: [PATCH 5/8] Avoid passing visibility flags to flang

---
 Makefile.am | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/Makefile.am b/Makefile.am
index 79ae938..f934fdc 100644
--- a/Makefile.am
+++ b/Makefile.am
@@ -61,8 +61,9 @@ if AMCOND_LIB_VISIBILITY_FLAGS
 endif
 
 # Fortran compiler flags.
+# Do not pass CFLAG_VISIBILITY (-fvisibility=hidden): flang rejects it.
 
-AM_FFLAGS = ${FPICFLAG} @FFLAGS@ $(OCTAVE_VISIBILITY_FLAGS)
+AM_FFLAGS = ${FPICFLAG} @FFLAGS@
 
 # C compiler flags.
 
