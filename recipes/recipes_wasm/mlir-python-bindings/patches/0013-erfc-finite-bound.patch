Subject: [PATCH] [mlir][math] Avoid infinity constant in erfc approximation
Upstream: https://github.com/llvm/llvm-project/pull/239507 (open)
Commit: 8edfd38e591fc8a393bc9e039ce7c9a2916754b4

diff --git a/mlir/lib/Dialect/Math/Transforms/PolynomialApproximation.cpp b/mlir/lib/Dialect/Math/Transforms/PolynomialApproximation.cpp
--- a/mlir/lib/Dialect/Math/Transforms/PolynomialApproximation.cpp
+++ b/mlir/lib/Dialect/Math/Transforms/PolynomialApproximation.cpp
@@ -1157,7 +1157,7 @@
   Value neg4 = bcast(floatCst(builder, -4.0f, et));
   Value neg2 = bcast(floatCst(builder, -2.0f, et));
   Value pos2 = bcast(floatCst(builder, 2.0f, et));
-  Value posInf = bcast(floatCst(builder, INFINITY, et));
+  Value maxFinite = bcast(f32FromBits(builder, 0x7f7fffffu));
   Value clampVal = bcast(floatCst(builder, 10.0546875f, et));

   Value a = math::AbsFOp::create(builder, x);
@@ -1207,11 +1207,13 @@
       builder, r, e,
       arith::MulFOp::create(builder, arith::MulFOp::create(builder, r, e), t));

-  Value isNotLessThanInf = arith::XOrIOp::create(
+  // a <= maxFinite is equivalent to a < +inf for IEEE floating-point values,
+  // including NaN and infinity, without introducing a non-finite constant.
+  Value isNonFinite = arith::XOrIOp::create(
       builder,
-      arith::CmpFOp::create(builder, arith::CmpFPredicate::OLT, a, posInf),
+      arith::CmpFOp::create(builder, arith::CmpFPredicate::OLE, a, maxFinite),
       trueValue);
-  r = arith::SelectOp::create(builder, isNotLessThanInf,
+  r = arith::SelectOp::create(builder, isNonFinite,
                               arith::AddFOp::create(builder, x, x), r);
   Value isGreaterThanClamp =
       arith::CmpFOp::create(builder, arith::CmpFPredicate::OGT, a, clampVal);
diff --git a/mlir/test/Dialect/Math/polynomial-approximation.mlir b/mlir/test/Dialect/Math/polynomial-approximation.mlir
--- a/mlir/test/Dialect/Math/polynomial-approximation.mlir
+++ b/mlir/test/Dialect/Math/polynomial-approximation.mlir
@@ -114,7 +114,7 @@
 // CHECK-DAG:     %[[cst_24:.*]] = arith.constant -4.000000e+00 : f32
 // CHECK-DAG:     %[[cst_25:.*]] = arith.constant -2.000000e+00 : f32
 // CHECK-DAG:     %[[cst_26:.*]] = arith.constant 2.000000e+00 : f32
-// CHECK-DAG:     %[[cst_27:.*]] = arith.constant 0x7F800000 : f32
+// CHECK-DAG:     %[[cst_27:.*]] = arith.constant 3.40282347E+38 : f32
 // CHECK-DAG:     %[[cst_28:.*]] = arith.constant 10.0546875 : f32
 // CHECK:         %[[val_2:.*]] = math.absf %[[val_arg0]] : f32
 // CHECK-NEXT:    %[[val_3:.*]] = arith.addf %[[val_2]], %[[cst_26]] : f32
@@ -174,7 +174,7 @@
 // CHECK-NEXT:    %[[val_57:.*]] = arith.mulf %[[val_27]], %[[val_54]] : f32
 // CHECK-NEXT:    %[[val_58:.*]] = arith.mulf %[[val_57]], %[[val_56]] : f32
 // CHECK-NEXT:    %[[val_59:.*]] = math.fma %[[val_27]], %[[val_54]], %[[val_58]] : f32
-// CHECK-NEXT:    %[[val_60:.*]] = arith.cmpf olt, %[[val_2]], %[[cst_27]] : f32
+// CHECK-NEXT:    %[[val_60:.*]] = arith.cmpf ole, %[[val_2]], %[[cst_27]] : f32
 // CHECK-NEXT:    %[[val_61:.*]] = arith.xori %[[val_60]], %[[cst_true]] : i1
 // CHECK-NEXT:    %[[val_62:.*]] = arith.addf %[[val_arg0]], %[[val_arg0]] : f32
 // CHECK-NEXT:    %[[val_63:.*]] = arith.select %[[val_61]], %[[val_62]], %[[val_59]] : f32
@@ -189,6 +189,19 @@
 func.func @erfc_scalar(%arg0: f32) -> f32 {
   %0 = math.erfc %arg0 : f32
   return %0 : f32
+}
+
+// CHECK-LABEL: func @erfc_vector(
+// CHECK-SAME:    %[[ARG:.*]]: vector<4xf32>) -> vector<4xf32> {
+// CHECK-DAG:     %[[MAX:.*]] = arith.constant dense<3.40282347E+38> : vector<4xf32>
+// CHECK:         %[[ABS:.*]] = math.absf %[[ARG]] : vector<4xf32>
+// CHECK-NOT:     0x7F800000
+// CHECK:         arith.cmpf ole, %[[ABS]], %[[MAX]] : vector<4xf32>
+// CHECK-NOT:     math.erfc
+// CHECK:         return
+func.func @erfc_vector(%arg0: vector<4xf32>) -> vector<4xf32> {
+  %0 = math.erfc %arg0 : vector<4xf32>
+  return %0 : vector<4xf32>
 }

 // CHECK-LABEL:   func @erf_vector(
