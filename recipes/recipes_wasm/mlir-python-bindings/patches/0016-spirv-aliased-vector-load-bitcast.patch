Subject: [PATCH] [mlir][SPIRV] Bitcast equal-width aliased vector loads

Backport to LLVM/MLIR 23.1.2.

diff --git a/mlir/lib/Dialect/SPIRV/Transforms/UnifyAliasedResourcePass.cpp b/mlir/lib/Dialect/SPIRV/Transforms/UnifyAliasedResourcePass.cpp
--- a/mlir/lib/Dialect/SPIRV/Transforms/UnifyAliasedResourcePass.cpp
+++ b/mlir/lib/Dialect/SPIRV/Transforms/UnifyAliasedResourcePass.cpp
@@ -162,7 +162,12 @@
   return std::distance(scalarNumBits.begin(), minVal);
 }

-static bool areSameBitwidthScalarType(Type a, Type b) {
+static bool areSameBitwidthScalarOrVectorType(Type a, Type b) {
+  if (auto va = dyn_cast<VectorType>(a)) {
+    auto vb = dyn_cast<VectorType>(b);
+    return vb && va.getNumElements() * va.getElementTypeBitWidth() ==
+                     vb.getNumElements() * vb.getElementTypeBitWidth();
+  }
   return a.isIntOrFloat() && b.isIntOrFloat() &&
          a.getIntOrFloatBitWidth() == b.getIntOrFloatBitWidth();
 }
@@ -426,7 +431,7 @@
     spirv::SPIRVType dstElemType = analysis.getElementType(dstVarOp);

     if (srcElemType == dstElemType ||
-        areSameBitwidthScalarType(srcElemType, dstElemType)) {
+        areSameBitwidthScalarOrVectorType(srcElemType, dstElemType)) {
       // We have the same bitwidth for source and destination element types.
       // Thie indices keep the same.
       rewriter.replaceOpWithNewOp<spirv::AccessChainOp>(
@@ -520,7 +525,7 @@
       return success();
     }

-    if (areSameBitwidthScalarType(srcElemType, dstElemType)) {
+    if (areSameBitwidthScalarOrVectorType(srcElemType, dstElemType)) {
       auto castOp = spirv::BitcastOp::create(rewriter, loc, srcElemType,
                                              newLoadOp.getValue());
       rewriter.replaceOp(loadOp, castOp->getResults());
@@ -694,7 +699,7 @@
     if (srcElemType != dstElemType) {
       if (!srcElemType.isIntOrFloat() || !dstElemType.isIntOrFloat())
         return rewriter.notifyMatchFailure(storeOp, "not scalar type");
-      if (!areSameBitwidthScalarType(srcElemType, dstElemType))
+      if (!areSameBitwidthScalarOrVectorType(srcElemType, dstElemType))
         return rewriter.notifyMatchFailure(storeOp, "different bitwidth");
       value = spirv::BitcastOp::create(rewriter, loc, dstElemType, value);
     }
diff --git a/mlir/test/Dialect/SPIRV/Transforms/unify-aliased-resource.mlir b/mlir/test/Dialect/SPIRV/Transforms/unify-aliased-resource.mlir
--- a/mlir/test/Dialect/SPIRV/Transforms/unify-aliased-resource.mlir
+++ b/mlir/test/Dialect/SPIRV/Transforms/unify-aliased-resource.mlir
@@ -867,3 +867,39 @@
     }
   }
 }
+
+// -----
+
+// CHECK-LABEL: spirv.func @load_vec2(
+// CHECK: %[[LOAD:.+]] = spirv.Load "StorageBuffer" {{.*}} : vector<2xi32>
+// CHECK-NEXT: %[[CAST:.+]] = spirv.Bitcast %[[LOAD]] : vector<2xi32> to vector<2xf32>
+// CHECK-NEXT: spirv.ReturnValue %[[CAST]] : vector<2xf32>
+spirv.module Logical GLSL450 requires #spirv.vce<v1.3, [Shader, Linkage, Float64, Int64], []> {
+  spirv.GlobalVariable @canonical bind(0, 0) {aliased} : !spirv.ptr<!spirv.struct<(!spirv.rtarray<vector<2xi32>, stride=8> [0])>, StorageBuffer>
+  spirv.GlobalVariable @view bind(0, 0) {aliased} : !spirv.ptr<!spirv.struct<(!spirv.rtarray<vector<2xf32>, stride=8> [0])>, StorageBuffer>
+  spirv.func @load_vec2(%index: i32) -> vector<2xf32> "None" {
+    %c0 = spirv.Constant 0 : i32
+    %addr = spirv.mlir.addressof @view : !spirv.ptr<!spirv.struct<(!spirv.rtarray<vector<2xf32>, stride=8> [0])>, StorageBuffer>
+    %ptr = spirv.AccessChain %addr[%c0, %index] : !spirv.ptr<!spirv.struct<(!spirv.rtarray<vector<2xf32>, stride=8> [0])>, StorageBuffer>, i32, i32 -> !spirv.ptr<vector<2xf32>, StorageBuffer>
+    %value = spirv.Load "StorageBuffer" %ptr : vector<2xf32>
+    spirv.ReturnValue %value : vector<2xf32>
+  }
+}
+
+// -----
+
+// CHECK-LABEL: spirv.func @load_vec4_i64_index(
+// CHECK: %[[LOAD:.+]] = spirv.Load "StorageBuffer" {{.*}} : vector<4xi32>
+// CHECK-NEXT: %[[CAST:.+]] = spirv.Bitcast %[[LOAD]] : vector<4xi32> to vector<4xf32>
+// CHECK-NEXT: spirv.ReturnValue %[[CAST]] : vector<4xf32>
+spirv.module Logical GLSL450 requires #spirv.vce<v1.3, [Shader, Linkage, Float64, Int64], []> {
+  spirv.GlobalVariable @canonical bind(0, 0) {aliased} : !spirv.ptr<!spirv.struct<(!spirv.rtarray<vector<4xi32>, stride=16> [0])>, StorageBuffer>
+  spirv.GlobalVariable @view bind(0, 0) {aliased} : !spirv.ptr<!spirv.struct<(!spirv.rtarray<vector<4xf32>, stride=16> [0])>, StorageBuffer>
+  spirv.func @load_vec4_i64_index(%index: i64) -> vector<4xf32> "None" {
+    %c0 = spirv.Constant 0 : i64
+    %addr = spirv.mlir.addressof @view : !spirv.ptr<!spirv.struct<(!spirv.rtarray<vector<4xf32>, stride=16> [0])>, StorageBuffer>
+    %ptr = spirv.AccessChain %addr[%c0, %index] : !spirv.ptr<!spirv.struct<(!spirv.rtarray<vector<4xf32>, stride=16> [0])>, StorageBuffer>, i64, i64 -> !spirv.ptr<vector<4xf32>, StorageBuffer>
+    %value = spirv.Load "StorageBuffer" %ptr : vector<4xf32>
+    spirv.ReturnValue %value : vector<4xf32>
+  }
+}
