From: Ian Thomas <ianthomas23@gmail.com>
Date: Mon, 8 Dec 2025 16:02:58 +0000
Subject: [PATCH 07/18] Extra char length arguments in linalg cython wrappers

---
 scipy/linalg/_generate_pyx.py     |  13 ++
 scipy/linalg/src/_matfuncs_expm.c | 232 +++++++++++++++---------------
 2 files changed, 129 insertions(+), 116 deletions(-)

diff --git a/scipy/linalg/_generate_pyx.py b/scipy/linalg/_generate_pyx.py
index 0fac032040..d8a24e98aa 100644
--- a/scipy/linalg/_generate_pyx.py
+++ b/scipy/linalg/_generate_pyx.py
@@ -539,6 +539,13 @@ def generate_decl_pyx(name, return_type, argnames, argtypes, accelerate,
         pyx_call_args[0] = ''.join([arg_casts(c_argtypes[0]), '&', argnames[0]])
     pyx_call_args = ', '.join(pyx_call_args)
     blas_macro, blas_name = get_blas_macro_and_name(name, accelerate, ilp64)
+
+    # Extra length argument for each char argument.
+    for argtype, argname in zip(argtypes, argnames):
+        if argtype == 'char':
+            c_proto += f', size_t {argname}_len'
+            pyx_call_args += ', 1'
+
     return f"""
 cdef extern from "{header_name}":
     {blas_return_type} _fortran_{name} "{blas_macro}({blas_name})"({c_proto}) nogil
@@ -692,6 +699,12 @@ def generate_decl_c(name, return_type, argnames, argtypes, accelerate,
         c_return_type = 'void'
     blas_macro, blas_name = get_blas_macro_and_name(name, accelerate, ilp64)
     c_args = ', '.join(f'{t} *{n}' for t, n in zip(c_argtypes, argnames))
+
+    # Extra length argument (passed by value) for each char argument.
+    for c_argtype, argname in zip(c_argtypes, argnames):
+        if c_argtype == 'char':
+            c_args += f', size_t {argname}_len'
+
     return f"{c_return_type} {blas_macro}({blas_name})({c_args});\n"
 
 
