From 4010a5f96516b0a63c7bb147ab0005215e891e0f Mon Sep 17 00:00:00 2001
From: Isabel Paredes <isabel.paredes@quantstack.net>
Date: Wed, 9 Sep 2026 13:46:21 +0200
Subject: [PATCH 3/5] Specialize flang to target wasm

Original wasm32 patch by serge-sans-paille
---
 flang/CMakeLists.txt                          | 10 +++++
 .../Optimizer/Builder/Runtime/RTBuilder.h     | 40 ++++++++++---------
 .../flang/Optimizer/CodeGen/DescriptorModel.h | 28 ++++++++-----
 .../flang/Optimizer/Support/DataLayout.h      | 25 ++++++++++++
 flang/lib/Optimizer/CodeGen/CodeGen.cpp       |  7 ++--
 5 files changed, 76 insertions(+), 34 deletions(-)

diff --git a/flang/CMakeLists.txt b/flang/CMakeLists.txt
index 0c5a690f8..1a53e507b 100644
--- a/flang/CMakeLists.txt
+++ b/flang/CMakeLists.txt
@@ -47,6 +47,16 @@ endif()
 
 option(FLANG_ENABLE_WERROR "Fail and stop building flang if a warning is triggered." OFF)
 
+option(FLANG_WASM64
+  "Build Flang specialized for wasm64 (LP64) instead of wasm32 (ILP32)."
+  OFF)
+if (FLANG_WASM64)
+  add_compile_definitions(FLANG_WASM64)
+  message(STATUS "Flang WASM target sizes: wasm64 (LP64)")
+else()
+  message(STATUS "Flang WASM target sizes: wasm32 (ILP32)")
+endif()
+
 # Check for a standalone build and configure as appropriate from
 # there.
 if (CMAKE_SOURCE_DIR STREQUAL CMAKE_CURRENT_SOURCE_DIR)
