From: Isabel Paredes <isabel.paredes@quantstack.net>
Date: Fri, 30 Oct 2026 13:16:45 +0100
Subject: [PATCH 2/3] Replace bplapply with lapply

---
 R/methods-BamViews.R | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/R/methods-BamViews.R b/R/methods-BamViews.R
index 709b024..6a70e39 100644
--- a/R/methods-BamViews.R
+++ b/R/methods-BamViews.R
@@ -165,7 +165,7 @@ setMethod("[", c("BamViews", "ANY", "ANY"),
     function(what, bamViews, fun, ...)
 {
     idx <- structure(seq_len(ncol(bamViews)), names=names(bamViews))
-    result <- bplapply(idx, fun, bamViews=bamViews, ...)
+    result <- lapply(idx, fun, bamViews=bamViews, ...)
     errs <- sapply(result, is, "remote-error")
     
     if (any(errs))
