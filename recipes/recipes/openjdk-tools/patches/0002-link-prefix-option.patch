From: emscripten-forge
Subject: openjdk21-wasm-link: --prefix option, run from the openjdk-tools package

The script is installed by openjdk-tools (a linux/osx package), not by the
emscripten-wasm32 openjdk21 package, so it no longer finds the JDK relative
to itself: --prefix names the emscripten-wasm32 environment with openjdk21.
gen-symbols.sh is installed next to it, in share/openjdk-tools.
---
diff --git a/openjdk21-wasm-link b/openjdk21-wasm-link
index cf787dd..b4ae19c 100644
--- a/openjdk21-wasm-link
+++ b/openjdk21-wasm-link
@@ -2,14 +2,15 @@
 # openjdk21-wasm-link -- link OpenJDK 21 (Zero) and a Java program into a
 # WebAssembly program for the browser (default) or node.
 #
-#   openjdk21-wasm-link -o out/app.html --app build/app.jar \
-#       --arg -jar --arg /app/app.jar
+#   openjdk21-wasm-link --prefix path/to/env_wasm -o out/app.html \
+#       --app build/app.jar --arg -jar --arg /app/app.jar
 #
 # Output: <name>.js/.wasm/.data (+ <name>.html for the browser, from the kit's
 # shell.html). The page needs cross-origin isolation (COOP/COEP headers) for
-# SharedArrayBuffer; share/openjdk21-wasm/serve.py serves a directory that way.
+# SharedArrayBuffer; share/openjdk-tools/serve.py serves a directory that way.
 #
 # Options:
+#   --prefix DIR        emscripten-wasm32 environment with openjdk21 [required]
 #   -o FILE             output (.html or .js)                        [required]
 #   --app SRC[@DEST]    copy a host file/dir into the virtual file system
 #                       (default DEST: /app/<basename>); repeatable
@@ -29,16 +30,13 @@ set -euo pipefail
 usage() { sed -n '2,/^set -euo/p' "$0" | sed '$d; s/^# \{0,1\}//'; exit "${1:-0}"; }
 
 HERE="$(cd "$(dirname "$0")" && pwd)"
-PREFIX_DIR="$(cd "$HERE/.." && pwd)"
-NATIVE="$PREFIX_DIR/lib/wasm-native"
-KIT="$PREFIX_DIR/share/openjdk21-wasm"
-JDK="$PREFIX_DIR/jdk-wasm"
-X11="$PREFIX_DIR/share/x11-wasm"
+TOOLS="$HERE/../share/openjdk-tools"
 
-out=""; headless=0; node=0; max_mb=2048; pool=12; opt=-O2
+prefix=""; out=""; headless=0; node=0; max_mb=2048; pool=12; opt=-O2
 apps=(); jargs=(); jenv=(); extra=()
 while [ $# -gt 0 ]; do
   case "$1" in
+    --prefix) prefix=$2; shift 2 ;;
     -o) out=$2; shift 2 ;;
     --app) apps+=("$2"); shift 2 ;;
     --arg) jargs+=("$2"); shift 2 ;;
@@ -53,7 +51,13 @@ while [ $# -gt 0 ]; do
     *) echo "openjdk21-wasm-link: unknown option $1" >&2; usage 2 ;;
   esac
 done
-[ -n "$out" ] || usage 2
+[ -n "$out" ] && [ -n "$prefix" ] || usage 2
+PREFIX_DIR="$(cd "$prefix" && pwd)"
+NATIVE="$PREFIX_DIR/lib/wasm-native"
+KIT="$PREFIX_DIR/share/openjdk21-wasm"
+JDK="$PREFIX_DIR/jdk-wasm"
+X11="$PREFIX_DIR/share/x11-wasm"
+[ -f "$NATIVE/libjvm.a" ] || { echo "openjdk21-wasm-link: no openjdk21 in $PREFIX_DIR" >&2; exit 1; }
 command -v emcc >/dev/null || { echo "openjdk21-wasm-link: emcc not on PATH" >&2; exit 1; }
 
 case "$out" in
@@ -107,7 +111,7 @@ done
 # --- launcher and symbol table ------------------------------------------------
 emcc -c -O2 -pthread -fwasm-exceptions -sSUPPORT_LONGJMP=wasm \
   -I"$KIT/include" "$KIT/jvm-main.c" -o "$work/jvm-main.o"
-bash "$KIT/gen-symbols.sh" "$work/symbols.c" "${whole[@]}" "${rest[@]}"
+bash "$TOOLS/gen-symbols.sh" "$work/symbols.c" "${whole[@]}" "${rest[@]}"
 emcc -c -O1 -pthread "$work/symbols.c" -o "$work/symbols.o"
 
 # default arguments (node: only when none are given on the command line;
