From: emscripten-forge
Subject: HotSpot Zero on Emscripten: build flags, OS layer, cooperative threads

---
diff --git a/hotspot/make/linux/makefiles/gcc.make b/hotspot/make/linux/makefiles/gcc.make
index 70b130b2..9f75e18f 100644
--- a/hotspot/make/linux/makefiles/gcc.make
+++ b/hotspot/make/linux/makefiles/gcc.make
@@ -388,3 +388,22 @@ ifndef USE_SUNCC
 endif
 
 -include $(HS_ALT_MAKE)/linux/makefiles/gcc.make
+
+#------------------------------------------------------------------------
+# WebAssembly (Emscripten) cross build: the VM is linked statically into a
+# single module and runs on cooperative threads (gthread-jspi).
+ifeq ($(ZERO_LIBARCH), wasm32)
+  # Newer clang reports many benign warnings in the 8u sources.
+  WARNINGS_ARE_ERRORS =
+  CFLAGS += -Wno-unknown-warning-option -Wno-deprecated-declarations \
+            -Wno-undef -Wno-format-nonliteral -Wno-missing-braces \
+            -Wno-unused-but-set-variable -Wno-dangling-else
+  # No assembler, no version scripts, no position independent code needed.
+  VM_PICFLAG =
+  PICFLAG =
+  MAPFLAG =
+  SONAMEFLAG =
+  LDFLAGS_HASH_STYLE =
+  STATIC_STDCXX =
+  STACK_ALIGNMENT_OPT =
+endif
