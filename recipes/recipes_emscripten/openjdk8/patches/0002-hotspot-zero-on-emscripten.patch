+#ifdef __EMSCRIPTEN__
+////////////////////////////////////////////////////////////////////////////////
+// WebAssembly (Emscripten) support
+//
+// There is a single linear memory and no virtual memory: mmap() cannot map
+// at a fixed address and munmap() cannot release part of a mapping.  Reserved
+// ranges are therefore carved out of the C heap (lazily zeroed pages at the
+// end of linear memory), commit zeroes the committed range and uncommit is a
+// no-op apart from bookkeeping.  Threads are cooperative green threads
+// (gthread-jspi), which is why the VM runs as a uniprocessor VM.
+extern "C" {
+  int gt_current_id(void);
+  void* emscripten_builtin_memalign(size_t alignment, size_t size);
+  uintptr_t emscripten_stack_get_base(void);
+  uintptr_t emscripten_stack_get_end(void);
+}
+
+// No raw system calls or symbol versioning in Emscripten.
+static inline long syscall(long number, ...) { errno = ENOSYS; return -1; }
+#define dlvsym(handle, name, version) dlsym(handle, name)
+
+#define WASM_VM_PAGE_SIZE 4096
+#define WASM_MAX_RESERVATIONS 1024
+
+struct WasmReservation { char* base; size_t size; char* alloc; };
+static WasmReservation wasm_reservations[WASM_MAX_RESERVATIONS];
+static int wasm_reservation_count = 0;
+
+static char* wasm_reserve(size_t bytes, size_t alignment) {
+  if (alignment < WASM_VM_PAGE_SIZE) alignment = WASM_VM_PAGE_SIZE;
+  if (wasm_reservation_count >= WASM_MAX_RESERVATIONS) return NULL;
+  char* p = (char*) ::emscripten_builtin_memalign(alignment, bytes);
+  if (p == NULL) return NULL;
+  WasmReservation* r = &wasm_reservations[wasm_reservation_count++];
+  r->base = p; r->size = bytes; r->alloc = p;
+  return p;
+}
+
+// Releasing only drops the bookkeeping for the range; the underlying block
+// is returned to the C heap when the whole reservation has been released.
+static bool wasm_release(char* addr, size_t bytes) {
+  for (int i = 0; i < wasm_reservation_count; i++) {
+    WasmReservation* r = &wasm_reservations[i];
+    if (addr >= r->base && addr + bytes <= r->base + r->size) {
+      if (addr == r->base && bytes == r->size) {
+        if (r->alloc == r->base) ::free(r->alloc);
+        *r = wasm_reservations[--wasm_reservation_count];
+      } else if (addr == r->base) {
+        r->base += bytes; r->size -= bytes;
+      } else if (addr + bytes == r->base + r->size) {
+        r->size -= bytes;
+      }
+      return true;
+    }
+  }
+  return false;
+}
+#endif // __EMSCRIPTEN__
