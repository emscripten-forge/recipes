-function uv_asynccb(handle::Ptr{Cvoid})
-    async = @handle_as handle AsyncCondition
-    lock(async.cond)
-    try
-        async.set = true
-        notify(async.cond, true)
-    finally
-        unlock(async.cond)
-    end
-    nothing
-end
