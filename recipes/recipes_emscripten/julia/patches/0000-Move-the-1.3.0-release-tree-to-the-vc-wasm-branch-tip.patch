-unsafe_convert(::Type{Ptr{Cvoid}}, async::AsyncCondition) = async.handle
-
-function _trywait(t::Union{Timer, AsyncCondition})
-    set = t.set
-    if !set
-        t.handle == C_NULL && return false
-        iolock_begin()
-        set = t.set
-        if !set
-            preserve_handle(t)
-            lock(t.cond)
-            try
-                set = t.set
-                if !set
-                    if t.handle != C_NULL
-                        iolock_end()
-                        set = wait(t.cond)
-                        unlock(t.cond)
-                        iolock_begin()
-                        lock(t.cond)
-                    end
-                end
-            finally
-                unlock(t.cond)
-                unpreserve_handle(t)
-            end
-        end
-        iolock_end()
-    end
-    t.set = false
-    return set
-end
-
-function wait(t::Union{Timer, AsyncCondition})
-    _trywait(t) || throw(EOFError())
-    nothing
-end
-
-
-isopen(t::Union{Timer, AsyncCondition}) = t.isopen
-
-function close(t::Union{Timer, AsyncCondition})
-    iolock_begin()
-    if t.handle != C_NULL && isopen(t)
-        t.isopen = false
-        ccall(:jl_close_uv, Cvoid, (Ptr{Cvoid},), t)
-    end
-    iolock_end()
-    nothing
-end
-
-function uvfinalize(t::Union{Timer, AsyncCondition})
-    iolock_begin()
-    lock(t.cond)
-    try
-        if t.handle != C_NULL
