From a0f24ba5c0e34d5725ccbec992f220b290e8d7b5 Mon Sep 17 00:00:00 2001
From: emscripten-forge <recipes@emscripten-forge>
Date: Tue, 22 Sep 2026 23:39:05 +0000
Subject: [PATCH] Build with current emscripten (4.0.x) and glibc

- <sys/ptrace.h> and dlinfo()/link maps do not exist in emscripten's libc
- emscripten's <fenv.h> only defines FE_ALL_EXCEPT and FE_TONEAREST, since
  WebAssembly has no exception flags and a single rounding mode; report the
  values the i686 bootstrap baked into the system image
- WebAssembly has no POSIX interval timers, so the sampling profiler is
  unavailable rather than a build error
- glibc 2.34+ turned MINSIGSTKSZ into a sysconf() call, which cannot be
  tested with #if
- emcc removed -g4, and DWARF for a module this size is enormous
---
 Make.inc           |  6 ++++--
 src/jlapi.c        | 31 +++++++++++++++++++++++++++++++
 src/signals-unix.c | 14 ++++++++++++++
 src/sys.c          |  6 ++++++
 src/task.c         |  8 +++-----
 5 files changed, 58 insertions(+), 7 deletions(-)

diff --git a/Make.inc b/Make.inc
index 9852602..4eae4b7 100644
--- a/Make.inc
+++ b/Make.inc
@@ -469,8 +469,10 @@ endif
 DEBUGFLAGS := -DJL_DEBUG_BUILD
 SHIPFLAGS := -O3 -falign-functions
 ifeq ($(OS), emscripten)
-DEBUGFLAGS += -O3 -g4
-SHIPFLAGS += -g3
+# -g4 was removed from emcc; debug info for a module this size is huge, so
+# the release build carries none (use -gsource-map when debugging).
+DEBUGFLAGS += -O1 -g
+SHIPFLAGS += -g0
 else
 DEBUGFLAGS += -O0 -ggdb2 -fstack-protector-all
 SHIPFLAGS += -ggdb2
diff --git a/src/jlapi.c b/src/jlapi.c
index c28fb9c..d911705 100644
--- a/src/jlapi.c
+++ b/src/jlapi.c
@@ -442,6 +442,37 @@ JL_DLLEXPORT void (jl_cpu_wake)(void)
     jl_cpu_wake();
 }
 
+#ifdef _OS_EMSCRIPTEN_
+// WebAssembly has no floating point exception flags and a single rounding
+// mode, so emscripten's <fenv.h> only defines FE_ALL_EXCEPT and FE_TONEAREST.
+// The system image is generated by an i686 bootstrap build, so report the
+// same (x87/SSE) values it baked in.
+#ifndef FE_INVALID
+#define FE_INVALID 0x01
+#endif
+#ifndef FE_DIVBYZERO
+#define FE_DIVBYZERO 0x04
+#endif
+#ifndef FE_OVERFLOW
+#define FE_OVERFLOW 0x08
+#endif
+#ifndef FE_UNDERFLOW
+#define FE_UNDERFLOW 0x10
+#endif
+#ifndef FE_INEXACT
+#define FE_INEXACT 0x20
+#endif
+#ifndef FE_DOWNWARD
+#define FE_DOWNWARD 0x400
+#endif
+#ifndef FE_UPWARD
+#define FE_UPWARD 0x800
+#endif
+#ifndef FE_TOWARDZERO
+#define FE_TOWARDZERO 0xc00
+#endif
+#endif
+
 JL_DLLEXPORT void jl_get_fenv_consts(int *ret)
 {
     ret[0] = FE_INEXACT;
diff --git a/src/signals-unix.c b/src/signals-unix.c
index dea1e04..51a663f 100644
--- a/src/signals-unix.c
+++ b/src/signals-unix.c
@@ -26,6 +26,8 @@
 #define HAVE_KEVENT
 #elif defined(__FreeBSD__) // generic bsd
 #define HAVE_ITIMER
+#elif defined(__EMSCRIPTEN__)
+// WebAssembly: no POSIX timers and no asynchronous signal delivery.
 #else // generic linux
 #define HAVE_TIMER
 #endif
@@ -475,6 +477,18 @@ JL_DLLEXPORT void jl_profile_stop_timer(void)
     running = 0;
 }
 
+#elif defined(__EMSCRIPTEN__)
+
+JL_DLLEXPORT int jl_profile_start_timer(void)
+{
+    return -1; // the sampling profiler is not available in WebAssembly
+}
+
+JL_DLLEXPORT void jl_profile_stop_timer(void)
+{
+    running = 0;
+}
+
 #else
 
 #error no profile tools available
diff --git a/src/sys.c b/src/sys.c
index 5cc1650..21f42db 100644
--- a/src/sys.c
+++ b/src/sys.c
@@ -23,7 +23,9 @@
 #include <sys/sysctl.h>
 #endif
 #include <sys/wait.h>
+#ifndef _OS_EMSCRIPTEN_
 #include <sys/ptrace.h>
+#endif
 #include <sys/mman.h>
 #include <dlfcn.h>
 #endif
@@ -454,6 +456,10 @@ JL_DLLEXPORT const char *jl_pathname_for_handle(void *handle)
     free(pth16);
     return filepath;
 
+#elif defined(_OS_EMSCRIPTEN_)
+
+    // No link maps: everything is statically linked into the wasm module.
+
 #else // Linux, FreeBSD, ...
 
     struct link_map *map;
diff --git a/src/task.c b/src/task.c
index d4457c1..3568dc5 100644
--- a/src/task.c
+++ b/src/task.c
@@ -50,12 +50,10 @@ volatile int jl_in_stackwalk = 0;
 #endif
 
 // empirically, jl_finish_task needs about 64k stack space to infer/run
-// and additionally, gc-stack reserves 64k for the guard pages
-#if defined(MINSIGSTKSZ) && MINSIGSTKSZ > 131072
-#define MINSTKSZ MINSIGSTKSZ
-#else
+// and additionally, gc-stack reserves 64k for the guard pages.
+// (glibc 2.34+ defines MINSIGSTKSZ as a sysconf() call, so it cannot be
+// tested with the preprocessor any more.)
 #define MINSTKSZ 131072
-#endif
 
 #define ROOT_TASK_STACK_ADJUSTMENT 3000000
 
