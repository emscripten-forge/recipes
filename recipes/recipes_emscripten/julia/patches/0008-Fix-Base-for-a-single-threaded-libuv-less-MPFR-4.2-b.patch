From 4204bfde958983828fe8614898cd774291ed3e05 Mon Sep 17 00:00:00 2001
From: emscripten-forge <recipes@emscripten-forge>
Date: Thu, 24 Sep 2026 00:33:45 +0000
Subject: [PATCH] Fix Base for a single-threaded, libuv-less, MPFR 4.2 build

  * locks. Threads.SpinLock's lock() was a no-op while islocked() still
    read the (never set) flag, and lock()/unlock() on a ReentrantLock
    returned early on jsvm. Base checks its own invariants with
    assert_havelock(), notably in wait(::GenericCondition), so every
    wait(::Task), every Channel operation and anything else built on a
    condition raised "concurrency violation detected". There is only one
    thread here, so the locks never block, but they have to keep the
    bookkeeping that Base asserts on. Threads.Mutex also never released
    ownership in unlock(), which made the second lock() report a deadlock.

  * BigFloat printing. "%.Re" meant "as many digits as it takes to read the
    value back" up to MPFR 4.0, and means a precision of zero from MPFR 4.1
    on, so every BigFloat printed as one digit against a current MPFR.
    "%Re" means the former in both.

  * stat(). The system image is generated by the native bootstrap, whose
    errno numbers are not emscripten's (which are WASI's), so the DISABLE_LIBUV
    path cannot classify the result; report "no such path" the way the libuv
    path does instead of raising a bogus SystemError on every stat.
---
 base/anti_threadding.jl | 16 ++++++++++++----
 base/lock.jl            |  2 --
 base/mpfr.jl            |  6 +++++-
 base/stat.jl            |  6 +++++-
 4 files changed, 22 insertions(+), 8 deletions(-)

diff --git a/base/anti_threadding.jl b/base/anti_threadding.jl
index cc08829..4213575 100644
--- a/base/anti_threadding.jl
+++ b/base/anti_threadding.jl
@@ -33,16 +33,23 @@ struct SpinLock <: AbstractLock
     SpinLock() = new(Ref{Int}(0))
 end
 
+# There is only ever one thread here, so a lock can never be contended and
+# these never block. They still have to keep the hold count, because Base
+# checks its own invariants with `islocked` / `assert_havelock` -- notably in
+# `wait(::GenericCondition)`, which asserts the condition's lock is held and
+# then drops and re-takes it around the task switch.
 function lock(l::SpinLock)
+    l.handle[] += 1
     return
 end
 
 function trylock(l::SpinLock)
-    return false
+    l.handle[] += 1
+    return true
 end
 
 function unlock(l::SpinLock)
-    l.handle[] = 0
+    l.handle[] > 0 && (l.handle[] -= 1)
     return
 end
 
@@ -85,12 +92,13 @@ function lock(m::Mutex)
 end
 
 function trylock(m::Mutex)
-    m.ownertid == threadid() && error("concurrency violation detected") # deadlock
-    # r = ccall(:uv_mutex_trylock, Cint, (Ptr{Cvoid},), m)#
+    m.ownertid == threadid() && return false # non-reentrant
+    m.ownertid = threadid()
     return true
 end
 
 function unlock(m::Mutex)
+    m.ownertid = 0
     return
 end
 
diff --git a/base/lock.jl b/base/lock.jl
index ba98c82..8df4e43 100644
--- a/base/lock.jl
+++ b/base/lock.jl
@@ -64,7 +64,6 @@ wait for it to become available.
 Each `lock` must be matched by an [`unlock`](@ref).
 """
 function lock(rl::ReentrantLock)
-    @static Sys.isjsvm() && return
     t = current_task()
     lock(rl.cond_wait)
     while true
@@ -96,7 +95,6 @@ If this is a recursive lock which has been acquired before, decrement an
 internal counter and return immediately.
 """
 function unlock(rl::ReentrantLock)
-    @static Sys.isjsvm() && return
     t = current_task()
     rl.reentrancy_cnt == 0 && error("unlock count must match lock count")
     rl.locked_by === t || error("unlock from wrong thread")
diff --git a/base/mpfr.jl b/base/mpfr.jl
index 5d41213..74e8c05 100644
--- a/base/mpfr.jl
+++ b/base/mpfr.jl
@@ -1008,7 +1008,11 @@ function _string(x::BigFloat, fmt::String)::String
     isfinite(x) || return string(Float64(x))
     _prettify_bigfloat(string_mpfr(x, fmt))
 end
-_string(x::BigFloat) = _string(x, "%.Re")
+# An empty precision field ("%.Re") meant "enough digits to read the value
+# back exactly" up to MPFR 4.0, but MPFR 4.1 made it mean a precision of 0,
+# as C requires, which truncates every BigFloat to one digit. Omitting the
+# field entirely ("%Re") is the spelling that means "enough digits" in both.
+_string(x::BigFloat) = _string(x, "%Re")
 _string(x::BigFloat, k::Integer) = _string(x, "%.$(k)Re")
 
 string(b::BigFloat) = _string(b)
diff --git a/base/stat.jl b/base/stat.jl
index ffea73a..c31cd08 100644
--- a/base/stat.jl
+++ b/base/stat.jl
@@ -67,7 +67,11 @@ macro stat_call(sym, arg1type, arg)
         r = ccall($(Expr(:quote, sym)), Int32, ($(esc(arg1type)), Ptr{UInt8}), $(esc(arg)), stat_buf)
         if r != 0
             if Base.DISABLE_LIBUV
-                systemerror(stat, r != -Base.Libc.ENOENT && r != -Base.Libc.ENOTDIR)
+                # The image is generated by a native bootstrap build whose
+                # errno numbering is not the target's (emscripten uses the
+                # WASI numbers), so the error cannot be classified here.
+                # Like the libuv path does for ENOENT/ENOTDIR/EINVAL, report
+                # "no such path" instead of raising.
             else
                 r in (0, Base.UV_ENOENT, Base.UV_ENOTDIR, Base.UV_EINVAL) || throw(_UVError("stat", r))
             end
