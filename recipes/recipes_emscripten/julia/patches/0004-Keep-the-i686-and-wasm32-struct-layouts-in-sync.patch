From 34265e33e8c300ebca67d6743291858916feca94 Mon Sep 17 00:00:00 2001
From: emscripten-forge <recipes@emscripten-forge>
Date: Tue, 22 Sep 2026 23:39:30 +0000
Subject: [PATCH] Keep the i686 and wasm32 struct layouts in sync

64-bit integers are 4-byte aligned inside structs on i686 and 8-byte
aligned on wasm32. jl_thread_gc_num_t sits in the middle of
jl_tls_states_t, so the difference shifts every field after it -- including
defer_signal, whose offset the code generator bakes into the system image
that the i686 bootstrap build produces. Pin the alignment so both targets
agree.
---
 src/julia_threads.h | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/src/julia_threads.h b/src/julia_threads.h
index 3e8608f..7d6f84e 100644
--- a/src/julia_threads.h
+++ b/src/julia_threads.h
@@ -79,6 +79,10 @@ typedef struct {
     uint16_t osize;      // size of objects in this pool
 } jl_gc_pool_t;
 
+// 64-bit integers are 4-byte aligned in structs on i686 but 8-byte aligned on
+// wasm32. The system image is generated by the i686 bootstrap build and its
+// code bakes in offsets of the fields that follow (jl_tls_states_t's
+// defer_signal, for instance), so pin the alignment on both targets.
 typedef struct {
     int64_t     allocd;
     int64_t     freed;
@@ -87,7 +91,7 @@ typedef struct {
     uint64_t    poolalloc;
     uint64_t    bigalloc;
     uint64_t    freecall;
-} jl_thread_gc_num_t;
+} __attribute__((aligned(8))) jl_thread_gc_num_t;
 
 typedef struct {
     // variable for tracking weak references
