+// ($(string(:mpfr_, f)), :libmpfr), ...)`), so a target can also be a String.
+// Interning it gives the interpreter's foreigncall table the same name to
+// look up. Anything else (and the missing fallthrough return, which used to
+// leave the result undefined) yields NULL, which the caller reports.
+static jl_sym_t *sym_from_value(jl_value_t *val)
+{
+    if (val == NULL)
