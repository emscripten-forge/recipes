# Minimal umbrella Boost config for the emscripten-forge boost packages, which
# only ship per-module configs (lib/cmake/boost_<module>/), while arrow asks for
# Boost in CONFIG mode. build.sh copies this template into the build tree,
# substituting the prefix and the version read from the installed boost headers,
# so it tracks the boost packages.
set(Boost_FOUND TRUE)
set(Boost_VERSION "@BOOST_VERSION@")
set(Boost_VERSION_STRING "@BOOST_VERSION@")
set(Boost_INCLUDE_DIRS "@PREFIX@/include")
set(Boost_INCLUDE_DIR "@PREFIX@/include")
foreach(_boost_target Boost::headers Boost::boost)
  if(NOT TARGET ${_boost_target})
    add_library(${_boost_target} INTERFACE IMPORTED)
    set_target_properties(${_boost_target} PROPERTIES
                          INTERFACE_INCLUDE_DIRECTORIES "@PREFIX@/include")
  endif()
endforeach()
