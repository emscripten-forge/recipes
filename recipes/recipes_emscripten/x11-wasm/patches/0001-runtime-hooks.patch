+++ b/src/libX11/OpenDis.c
@@ -130,7 +130,7 @@ BrowserInitDisplay(void)
     state->screen.backing_store = NotUseful;
     state->screen.save_unders = False;
 
-    state->display.fd = 0;
+    state->display.fd = X11WasmHookConnectionFd();
     state->display.proto_major_version = X_PROTOCOL;
     state->display.proto_minor_version = X_PROTOCOL_REVISION;
     state->display.vendor = (char *)"x11.wasm";
@@ -344,6 +344,7 @@ BrowserQueueEventInternal(
     x11wasm_eventQueue[tail].internal = internal;
     x11wasm_eventQueueCount++;
     BrowserUpdateQueueLength();
+    X11WasmHookEventQueued();
     return 1;
 }
 
