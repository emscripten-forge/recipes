On desktop Qt, QSslError is transitively included via QSslConfiguration.
On wasm Qt6 the transitive include doesn't reach it, so add an explicit
include so `QList<QSslError>` in the header signature compiles.

--- a/src/RemoteNetwork.h
+++ b/src/RemoteNetwork.h
@@ -3,6 +3,7 @@

 #include <QObject>
 #include <QtNetwork/QSslConfiguration>
+#include <QtNetwork/QSslError>

 class QNetworkAccessManager;
 class QNetworkReply;
