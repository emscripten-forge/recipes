+#ifndef __EMSCRIPTEN__
             if(interrupt_after_statements)
                 cv.wait(lk, [this](){ return may_continue_with_execution; });
+#endif
             lk.unlock();
             break;
         }
@@ -258,8 +271,10 @@ bool RunSql::executeNextStatement()
