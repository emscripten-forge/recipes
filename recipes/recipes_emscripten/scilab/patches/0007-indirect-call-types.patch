+#ifdef __EMSCRIPTEN__
+#include <stdint.h>
+#include <emscripten.h>
+/*
+ * WebAssembly checks the type of every indirect call. The computational
+ * functions are called here with as many arguments as they take: C passes
+ * all those of their type (types 0, 1 and 10001: as many pointer/size pairs
+ * as the block could have ports, 2 and 10002: the zero-crossing surfaces
+ * too), the extra ones being ignored by native calling conventions, and a
+ * type 4 block can be "trash" (a type 0 function), which takes the place of
+ * the scopes in simulations without windows.
+ */
+EM_JS(int, scicos_wasm_nparams, (voidf f), {
+    var fn = wasmTable.get(f);
+    return fn ? fn.length : -1;
+});
+
+static int scicos_nparams(voidf f)
+{
+    /* function pointer -> number of parameters (asked to JS once) */
+    enum { SCW_N = 1024 };
+    static voidf keys[SCW_N];
+    static int vals[SCW_N];
+    unsigned h = (unsigned)(((uintptr_t) f * 2654435761u) % SCW_N);
+    int i = 0;
+    for (i = 0; i < SCW_N; i++, h = (h + 1) % SCW_N)
+    {
+        if (keys[h] == f)
+        {
+            return vals[h];
+        }
+        if (keys[h] == NULL)
+        {
+            vals[h] = scicos_wasm_nparams(f);
+            keys[h] = f;
+            return vals[h];
+        }
+    }
+    return scicos_wasm_nparams(f);
+}
+
+/* call f with the first n of the cap pointers in a (n: its own count) */
+static void scicos_call_pointers(voidf f, void **a, int cap)
+{
+    int n = scicos_nparams(f);
+    if (n < 0 || n > cap)
+    {
+        n = cap;
+    }
+    switch (n)
+    {
+        case 0: ((void (*)(void)) f)(); break;
+        case 1: ((void (*)(void *)) f)(a[0]); break;
+        case 2: ((void (*)(void *, void *)) f)(a[0], a[1]); break;
+        case 3: ((void (*)(void *, void *, void *)) f)(a[0], a[1], a[2]); break;
+        case 4: ((void (*)(void *, void *, void *, void *)) f)(a[0], a[1], a[2], a[3]); break;
+        case 5: ((void (*)(void *, void *, void *, void *, void *)) f)(a[0], a[1], a[2], a[3], a[4]); break;
+        case 6: ((void (*)(void *, void *, void *, void *, void *, void *)) f)(a[0], a[1], a[2], a[3], a[4], a[5]); break;
+        case 7: ((void (*)(void *, void *, void *, void *, void *, void *, void *)) f)(a[0], a[1], a[2], a[3], a[4], a[5], a[6]); break;
