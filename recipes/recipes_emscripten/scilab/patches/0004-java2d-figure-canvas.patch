 public class SwingScilabCanvasImpl {
 
+    /**
+     * Figures are drawn with Java2D (the G2D implementation of SciRenderer,
+     * also used for the vectorial exports) instead of OpenGL (JoGL) when the
+     * system property scilab.graphics.renderer is "java2d": where there is no
+     * OpenGL, as in the WebAssembly build, or to work around a broken driver.
+     */
+    private static final boolean JAVA2D = "java2d".equalsIgnoreCase(System.getProperty("scilab.graphics.renderer"));
+
+    /**
+     * @return true if figures are drawn with Java2D rather than JoGL
+     */
+    public static boolean isJava2D() {
+        return JAVA2D;
+    }
+
+    /**
+     * Component drawing a figure with Java2D. Its name starts with the name of
+     * this class, as the JoGL components' names do, which is how
+     * GlobalMouseEventWatcher (xclick, xgetmouse...) recognizes a canvas.
+     * The figure is drawn into an image, kept between repaints: the scene is
+     * only drawn again when the figure changed (redraw) or the size did.
+     */
+    public static final class Java2DPanel extends JPanel {
+        private static final long serialVersionUID = 1L;
+
+        private final G2DCanvas canvas;
+        private BufferedImage image;
+        private boolean dirty = true;
+
+        public Java2DPanel() {
+            super(null);
+            setOpaque(true);
+            BufferedImage initial = new BufferedImage(1, 1, BufferedImage.TYPE_INT_RGB);
+            canvas = G2DCanvasFactory.createCanvas(initial.createGraphics(), 1, 1);
+            canvas.setScreenHandlers(this::requestRedraw, this::redrawAndWait, this::getImage);
+        }
+
+        /**
+         * @return the SciRenderer canvas drawn by this component
+         */
+        public G2DCanvas getCanvas() {
+            return canvas;
+        }
+
+        private void requestRedraw() {
+            synchronized (this) {
+                dirty = true;
+            }
+            repaint();
+        }
+
+        private void redrawAndWait() {
+            synchronized (this) {
+                dirty = true;
+            }
+            Runnable paint = () -> paintImmediately(0, 0, getWidth(), getHeight());
+            if (SwingUtilities.isEventDispatchThread()) {
+                paint.run();
+            } else {
+                try {
+                    SwingUtilities.invokeAndWait(paint);
+                } catch (InterruptedException e) {
+                    Thread.currentThread().interrupt();
+                } catch (InvocationTargetException e) {
+                    e.printStackTrace();
+                }
+            }
+        }
+
+        @Override
+        @SuppressWarnings("deprecation")
+        public void reshape(int x, int y, int width, int height) {
+            super.reshape(x, y, width, height);
+            canvas.setDimension(Math.max(width, 1), Math.max(height, 1));
+            synchronized (this) {
+                dirty = true;
+            }
+        }
+
+        @Override
+        protected void paintComponent(Graphics g) {
+            int width = getWidth();
+            int height = getHeight();
+            if (width <= 0 || height <= 0) {
+                return;
+            }
+            BufferedImage shown;
+            synchronized (this) {
+                if (image == null || image.getWidth() != width || image.getHeight() != height) {
+                    image = new BufferedImage(width, height, BufferedImage.TYPE_INT_RGB);
+                    dirty = true;
+                }
+                if (dirty) {
+                    dirty = false;
+                    Graphics2D g2d = image.createGraphics();
+                    try {
+                        g2d.setColor(getBackground());
+                        g2d.fillRect(0, 0, width, height);
+                        canvas.setGraphics(g2d, width, height);
+                        canvas.draw();
+                    } finally {
+                        g2d.dispose();
+                    }
+                }
+                shown = image;
+            }
+            g.drawImage(shown, 0, 0, null);
+        }
+
+        /**
+         * @return a copy of the last image painted, or null
+         */
+        public synchronized BufferedImage getImage() {
+            if (image == null) {
+                return null;
+            }
+            BufferedImage copy = new BufferedImage(image.getWidth(), image.getHeight(), BufferedImage.TYPE_INT_RGB);
+            Graphics2D g2d = copy.createGraphics();
+            g2d.drawImage(image, 0, 0, null);
+            g2d.dispose();
+            return copy;
+        }
+    }
+
     static boolean forceGLCanvas = false;
     static boolean noGLJPanel = false;
     static boolean testCanvasAtStartup = false;
