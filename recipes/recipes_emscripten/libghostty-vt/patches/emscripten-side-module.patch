 const std = @import("std");
 const builtin = @import("builtin");
 const stderr = @import("os/stderr.zig");
+
+// Emscripten owns linear memory. Keep Zig's page allocations on its libc heap
+// so memory growth updates the embedding runtime's views and allocator state.
+pub const os = if (builtin.target.os.tag == .emscripten) struct {
+    pub const heap = struct {
+        pub const page_allocator = @import("lib/allocator/emscripten.zig").allocator;
+    };
+} else struct {};
 
