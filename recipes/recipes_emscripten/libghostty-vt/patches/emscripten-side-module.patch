+//! Zero-initialized page allocations backed by the embedding Emscripten libc.
+const std = @import("std");
+const Allocator = std.mem.Allocator;
+
+pub const allocator: Allocator = .{
+    .ptr = undefined,
+    .vtable = &.{
+        .alloc = alloc,
+        .resize = Allocator.noResize,
+        .remap = Allocator.noRemap,
+        .free = free,
+    },
+};
+
+fn alloc(_: *anyopaque, len: usize, alignment: std.mem.Alignment, ret_addr: usize) ?[*]u8 {
+    const memory = std.heap.c_allocator.rawAlloc(len, alignment, ret_addr) orelse return null;
+    @memset(memory[0..len], 0);
+    return memory;
+}
+
+fn free(_: *anyopaque, memory: []u8, alignment: std.mem.Alignment, ret_addr: usize) void {
+    std.heap.c_allocator.rawFree(memory, alignment, ret_addr);
+}
