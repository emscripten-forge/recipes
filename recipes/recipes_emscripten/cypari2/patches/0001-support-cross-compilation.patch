+# The datadir is load-bearing: autogen reads pari.desc from it below, so
+# unlike the version probe it cannot simply be skipped. A cross build cannot
+# ask the target PARI where its datadir is, so allow it to be supplied in
+# the environment; native builds are unchanged.
+pari_datadir = run_command(
+  py,
+  ['-c', 'import os, sys; sys.stdout.write(os.environ.get("PARI_DATADIR", ""))'],
+  check: true,
+).stdout().strip()
+if pari_datadir == ''
+  if meson.is_cross_build()
+    error('Cross compiling: set PARI_DATADIR to the directory holding pari.desc')
+  endif
+  pari_datadir = cc.run(
+    pari_datadir_code,
+    name: 'pari datadir',
+    dependencies: [pari],
+    required: true,
+  ).stdout()
+endif
 
