+# The datadir is load-bearing: autogen reads pari.desc from it below, so
+# unlike the version probe it cannot simply be skipped. A cross build can
+# neither run the target PARI nor the target interpreter, so allow this to
+# be supplied in the environment too. Native builds are unchanged.
+pari_datadir = run_command(
+  'sh', '-c', 'printf %s "$PARI_DATADIR"',
+  check: true,
+).stdout().strip()
+if pari_datadir == ''
