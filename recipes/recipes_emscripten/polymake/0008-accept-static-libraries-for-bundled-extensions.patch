--- a/bundled/cdd/support/configure.pl	2026-09-18 23:54:17.376846043 +0000
+++ b/bundled/cdd/support/configure.pl	2026-09-18 23:54:24.568998106 +0000
@@ -57,6 +57,14 @@
       if (-f "$cdd_lib/libcddgmp.$Config::Config{so}" ) {
          $LDFLAGS = "-L$cdd_lib";
          $LDFLAGS .= " -Wl,-rpath,$cdd_lib" if $cdd_path ne "/usr";
+      } elsif (-f "$cdd_lib/libcddgmp.a") {
+         # Static-only installation, as produced by a WebAssembly cross build:
+         # $Config::Config{so} describes the perl that is *running* configure,
+         # which on such a build is the native one, so the shared library it
+         # names can never exist.  Accept the archive, and set no rpath: there is
+         # no shared object to find at runtime.  This mirrors what the bundled
+         # bliss extension already does for the same situation.
+         $LDFLAGS = "-L$cdd_lib";
       }
       if (!$CFLAGS or !$LDFLAGS) {
          die "Invalid installation location of cddlib: header file cdd.h and/or library libcddgmp.$Config::Config{so} not found.\n",
--- a/bundled/flint/support/configure.pl	2026-09-18 23:54:17.381836883 +0000
+++ b/bundled/flint/support/configure.pl	2026-09-18 23:54:27.536998038 +0000
@@ -24,6 +24,10 @@
       if (-f "$inc/flint/flint.h" && -f "$lib/libflint.$Config::Config{so}" ) {
          $cxxflags .= " -I$inc";
          $ldflags .= " -L$lib -Wl,-rpath,$lib";
+      } elsif (-f "$inc/flint/flint.h" && -f "$lib/libflint.a") {
+         # static-only installation (WebAssembly cross build); no rpath applies
+         $cxxflags .= " -I$inc";
+         $ldflags .= " -L$lib";
       } else {
          die "Invalid installation location of flint, header files and/or library not found\n";
       }
