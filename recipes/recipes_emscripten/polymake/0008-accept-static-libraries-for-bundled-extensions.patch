--- a/bundled/ppl/support/configure.pl	2026-09-18 23:54:17.391833579 +0000
+++ b/bundled/ppl/support/configure.pl	2026-09-18 23:54:38.080997797 +0000
@@ -58,8 +58,14 @@
       if (-f "$ppl_lib/libppl.$Config::Config{so}") {
          $LDFLAGS = "-L$ppl_lib";
          $LDFLAGS .= " -Wl,-rpath,$ppl_lib" unless $ppl_lib =~ m#^/usr/lib#;
-      } elsif ("$ppl_lib/libppl.a") {
-	 die "PPL found at $ppl_path is built without shared libraries.\n";
+      } elsif (-f "$ppl_lib/libppl.a") {
+         # Static-only installation, as produced by a WebAssembly cross build.
+         # polymake links libppl into its own modules rather than loading it at
+         # runtime, so an archive serves just as well and needs no rpath.
+         # (The condition replaced here was `elsif ("$ppl_lib/libppl.a")`, a
+         # non-empty string and therefore always true, so this branch used to
+         # reject every installation that had no shared library.)
+         $LDFLAGS = "-L$ppl_lib";
       } else {
          die "Invalid installation location of libppl: library libppl.$Config::Config{so} does not exist\n";
       }
