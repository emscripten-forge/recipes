 }
 
+namespace {
+
+// zero-initialized, so it is readable from a static constructor of any other
+// translation unit without an initialization order hazard
+bool registrations_enabled = false;
+
+std::vector<std::function<void()>>& deferred_registrations()
+{
+   // function-local: constructed on first use, never during static initialization
+   static std::vector<std::function<void()>> queue;
+   return queue;
+}
+
+}
+
+void defer_registration(std::function<void()> reg)
+{
+   if (registrations_enabled)
+      reg();
+   else
+      deferred_registrations().push_back(std::move(reg));
+}
+
+void run_deferred_registrations()
+{
+   registrations_enabled = true;
+   auto& queue = deferred_registrations();
+   // indexed, because a callback is in principle free to append another one
+   for (size_t i = 0; i < queue.size(); ++i)
+      queue[i]();
+   // the queue is deliberately not cleared, see the comment in perl/wrappers.h
+}
+
