 namespace pm { namespace perl {
 
 template <typename T>
 using is_mutable = bool_constant<pm::is_mutable<T>::value && !object_traits<T>::is_always_const>;
 
+/* Registration of C++ clients, deferred until the perl side is ready.
+
+   The registrators in client.h run from static constructors.  Normally every
+   application is a shared module which is dlopen'ed long after the interpreter
+   exists, so a registrator can address it straight away.  When polymake is linked
+   into a single executable together with libperl -- as the WebAssembly build has to,
+   because that perl has no dynamic loading -- all of those constructors instead run
+   before main(), and the first one to ask for its queue dereferences a
+   Polymake::Core::CPlusPlus::root that does not exist yet.
+
+   Registrations are therefore held back until Polymake::Core::CPlusPlus::init() has
+   built that structure and called run_deferred_registrations().  From then on they
+   are carried out as they arrive, so a module loaded later behaves exactly as before
+   and the standard build is unaffected apart from the order of the very first batch.
+
+   The callbacks are kept afterwards rather than discarded: the argument copies they
+   hold are what the AnyStrings handed to perl point at. */
+void defer_registration(std::function<void()> reg);
+void run_deferred_registrations();
