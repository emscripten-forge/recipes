+# In a cross build the application modules are in the target's object format, which
+# the build machine's nm cannot read -- it reports "file format not recognized" for
+# every member and this script then aborts with "no external symbols found".  NM
+# names the symbol lister to use instead, e.g. llvm-nm from the emscripten toolchain.
+my $nm = $ENV{NM} || "nm";
+
+# A symbol lister reading a static archive reports every member separately, so a
+# weak symbol -- a template instantiation, say -- shows up once per object file that
+# emitted it.  A shared module, which is what this script was written for, lists each
+# symbol only once.  Remember what has already been emitted; defining an alias twice
+# is a compile error.
+my %seen;
+
 for my $shlib (@ARGV) {
