 sub build_singular_test {
+   # Cross-compiling (POLYMAKE_TEST_RUNNER set, e.g. a WebAssembly build): locate
+   # libsingular by its path and boot it is exactly what cannot work here.  There
+   # is no shared object for dladdr() to report in a statically linked test
+   # program, so the original probe throws before it gets anywhere, and siInit()
+   # would then abort because the resource tree recorded in the singular package
+   # does not exist inside the target runtime.  Neither is what this probe is for:
+   # it establishes that libsingular links and was built with NTL.  Taking the
+   # address of siInit keeps that a genuine test of the whole link.
+   if (length($ENV{POLYMAKE_TEST_RUNNER} // "")) {
+      return Polymake::Configure::build_test_program(<<"---", CXXFLAGS => $CXXFLAGS, LDFLAGS => $LDFLAGS, LIBS => $LIBS);
+#include "Singular/libsingular.h"
+#include <string>
+#include <iostream>
+int main() {
+   if ((void*)&siInit == nullptr) return 1;
+#ifdef HAVE_NTL
+   std::cout << "Version: " << VERSION << std::endl;
+   return 0;
+#else
+   std::cout << "Your singular installation was not build with NTL support." << std::endl;
+   std::cout << "Please reconfigure and rebuild singular with --with-ntl=PATH." << std::endl;
+   return 1;
+#endif
+}
+---
+   }
+
    return Polymake::Configure::build_test_program(<<"---", CXXFLAGS => $CXXFLAGS, LDFLAGS => $LDFLAGS, LIBS => $LIBS);
