+# Cross-compilation support.
+#
+# When polymake is built for a target which cannot execute its binaries directly
+# (e.g. WebAssembly via Emscripten), the configuration test programs still have to
+# be *run* in order to probe the target libraries.  Setting POLYMAKE_TEST_RUNNER to
+# an emulator/loader command (e.g. "node") makes run_test_program invoke the test
+# program through it.  POLYMAKE_TEST_SUFFIX additionally appends a suffix to the
+# linker output so that the toolchain picks the intended output format; Emscripten
+# infers the output type from the file extension, and ".js" yields a launcher which
+# node can execute together with the generated sidecar .wasm file.
+my $test_runner = $ENV{POLYMAKE_TEST_RUNNER} // "";
+my $test_suffix = $ENV{POLYMAKE_TEST_SUFFIX} // "";
+
+sub test_program_path {
+   my $dir = get_tempdir();
+   "$dir/polymake_${$}_configure$test_suffix"
+}
+
 # "C++ source text", ( VarName => "value to prepend locally", ... ) => "error msg"
 # Compiles and links the given program.
 # @return error message from the compiler/linker.
@@ -269,7 +287,8 @@
