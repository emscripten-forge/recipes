--- a/cypari/macros.h
+++ b/cypari/macros.h
@@ -263,6 +263,8 @@
 #if defined(__MINGW32__) || defined(_WIN32)
 	// FIX ME!!!!
 	raise(SIGFPE);
+#elif defined(__EMSCRIPTEN__)
+        raise(SIGABRT);
 #else
         abort();
 #endif
@@ -309,6 +311,15 @@
     }
     DEBUG("sig_error raising SIGFPE\n")
     raise(SIGFPE);
+#elif defined(__EMSCRIPTEN__)
+    /*
+     * Emscripten's abort() traps the WebAssembly module immediately instead
+     * of raising SIGABRT, so the handler installed by cysignals would never
+     * run and every PARI error would kill the interpreter.  raise() does
+     * call the handler, which is what we want here.
+     */
+    DEBUG("sig_error raising SIGABRT\n")
+    raise(SIGABRT);
 #else
     abort();
 #endif
