+#include <emscripten/stack.h>
+extern void _emscripten_stack_restore(uintptr_t sp);
+extern void *_emscripten_stack_alloc(size_t size);
+EMSCRIPTEN_KEEPALIVE uintptr_t ffi_wasm_stack_save(void) {
+  return emscripten_stack_get_current();
+}
+EMSCRIPTEN_KEEPALIVE void ffi_wasm_stack_restore(uintptr_t sp) {
+  _emscripten_stack_restore(sp);
+}
+EMSCRIPTEN_KEEPALIVE uintptr_t ffi_wasm_stack_alloc(size_t size) {
+  return (uintptr_t) _emscripten_stack_alloc(size);
