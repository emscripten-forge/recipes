+/*
+ * Calls without a JavaScript frame.
+ *
+ * ffi_call_js performs the onward call from JavaScript.  With JavaScript
+ * Promise Integration (JSPI) the callee then cannot suspend ("trying to
+ * suspend JS frames").  For signatures made of integers, pointers, floats
+ * and doubles (everything except structures, long double, complex and
+ * varargs) ffi_call instead converts the arguments in C and calls a small
+ * WebAssembly trampoline:
+ *
+ *    void trampoline(fn, const ffi_wasm_value *args, ffi_wasm_value *ret)
+ *      loads args[0..n) with the types of the signature, call_indirect fn,
+ *      stores the result in *ret
+ *
+ * The trampoline module is generated at run time, once per signature, and
+ * its function is added to the indirect function table (this needs
+ * -sALLOW_TABLE_GROWTH; without it the JavaScript implementation is used).
+ * Only WebAssembly frames are on the stack during the call.
+ */
+typedef union {
+  int32_t i;
+  int64_t j;
+  float f;
+  double d;
+} ffi_wasm_value;
+
+#define TRAMPOLINE_MAX_ARGS 64
+
+EM_JS_MACROS(
+unsigned int,
+ffi_call_trampoline_js, (const char *sig_ptr),
+{
+  var sig = UTF8ToString(sig_ptr);
+  var cache = Module['_ffiCallTrampolines'] || (Module['_ffiCallTrampolines'] = {});
+  if (sig in cache) return cache[sig];
+  var VT = { i: 0x7f, j: 0x7e, f: 0x7d, d: 0x7c };
+  var LOAD = { i: [0x28, 2], j: [0x29, 3], f: [0x2a, 2], d: [0x2b, 3] };
+  var STORE = { i: [0x36, 2], j: [0x37, 3], f: [0x38, 2], d: [0x39, 3] };
+  var ret = sig[0];
+  var args = sig.slice(2);
+  var uleb = function (out, n) {
+    do { var b = n & 0x7f; n >>>= 7; if (n) b |= 0x80; out.push(b); } while (n);
+  };
+  var bytes = [0x00, 0x61, 0x73, 0x6d, 0x01, 0x00, 0x00, 0x00];
+  var section = function (id, content) {
+    bytes.push(id);
+    uleb(bytes, content.length);
+    for (var i = 0; i < content.length; i++) bytes.push(content[i]);
+  };
+  // types: 0 = trampoline (i32 i32 i32) -> (), 1 = target
+  var types = [2, 0x60, 3, 0x7f, 0x7f, 0x7f, 0, 0x60];
+  uleb(types, args.length);
+  for (var i = 0; i < args.length; i++) types.push(VT[args[i]]);
+  if (ret === 'v') types.push(0); else types.push(1, VT[ret]);
+  section(1, types);
+  // imports: e.t = the function table, e.m = the memory
+  section(2, [2, 1, 0x65, 1, 0x74, 0x01, 0x70, 0x00, 0x00,
+                 1, 0x65, 1, 0x6d, 0x02, 0x00, 0x00]);
+  section(3, [1, 0]);
+  section(7, [1, 1, 0x66, 0x00, 0x00]);
+  var body = [0];
+  if (ret !== 'v') body.push(0x20, 2);
+  for (var k = 0; k < args.length; k++) {
+    body.push(0x20, 1, LOAD[args[k]][0], LOAD[args[k]][1]);
+    uleb(body, 8 * k);
+  }
+  body.push(0x20, 0, 0x11, 1, 0);
+  if (ret !== 'v') body.push(STORE[ret][0], STORE[ret][1], 0);
+  body.push(0x0b);
+  var code = [1];
+  uleb(code, body.length);
+  for (var i = 0; i < body.length; i++) code.push(body[i]);
+  section(10, code);
+  var index = 0;
+  try {
+    var instance = new WebAssembly.Instance(new WebAssembly.Module(new Uint8Array(bytes)),
+                                            { e: { t: wasmTable, m: wasmMemory } });
+    index = getEmptyTableSlot();
+    setWasmTableEntry(index, instance.exports['f']);
+  } catch (e) {
+    LOG_DEBUG("CALL_TRAMPOLINE_FAILED", sig, e);
+    index = 0;
+  }
+  cache[sig] = index;
+  return index;
+})
+
+static char
+ffi_wasm_kind(const ffi_type *type)
+{
+  switch (type->type) {
+  case FFI_TYPE_VOID:
+    return 'v';
+  case FFI_TYPE_INT:
+  case FFI_TYPE_UINT8:
+  case FFI_TYPE_SINT8:
+  case FFI_TYPE_UINT16:
+  case FFI_TYPE_SINT16:
+  case FFI_TYPE_UINT32:
+  case FFI_TYPE_SINT32:
+  case FFI_TYPE_POINTER:
+    return 'i';
+  case FFI_TYPE_UINT64:
+  case FFI_TYPE_SINT64:
+    return 'j';
+  case FFI_TYPE_FLOAT:
+    return 'f';
+  case FFI_TYPE_DOUBLE:
+    return 'd';
+  default:
+    return 0;
+  }
+}
+
+static unsigned int
+ffi_call_trampoline_for(const ffi_cif *cif)
+{
+  char sig[TRAMPOLINE_MAX_ARGS + 3];
+  unsigned int n = 0, i;
+
+  if ((cif->flags & VARARGS_FLAG) || cif->nargs > TRAMPOLINE_MAX_ARGS)
+    return 0;
+  if (!(sig[n++] = ffi_wasm_kind(cif->rtype)))
+    return 0;
+  sig[n++] = '_';
+  for (i = 0; i < cif->nargs; i++) {
+    char k = ffi_wasm_kind(cif->arg_types[i]);
+    if (!k || k == 'v')
+      return 0;
+    sig[n++] = k;
+  }
+  sig[n] = 0;
+  return ffi_call_trampoline_js(sig);
+}
+
+static void
+ffi_call_trampoline(ffi_cif *cif, unsigned int trampoline, ffi_fp fn,
+                    void *rvalue, void **avalue)
+{
+  ffi_wasm_value args[TRAMPOLINE_MAX_ARGS];
+  ffi_wasm_value ret;
+  unsigned int i;
+
+  for (i = 0; i < cif->nargs; i++) {
+    const void *p = avalue[i];
+    switch (cif->arg_types[i]->type) {
+    case FFI_TYPE_UINT8:   args[i].i = *(const uint8_t *) p; break;
+    case FFI_TYPE_SINT8:   args[i].i = *(const int8_t *) p; break;
+    case FFI_TYPE_UINT16:  args[i].i = *(const uint16_t *) p; break;
+    case FFI_TYPE_SINT16:  args[i].i = *(const int16_t *) p; break;
+    case FFI_TYPE_UINT64:
+    case FFI_TYPE_SINT64:  memcpy(&args[i].j, p, 8); break;
+    case FFI_TYPE_FLOAT:   memcpy(&args[i].f, p, 4); break;
+    case FFI_TYPE_DOUBLE:  memcpy(&args[i].d, p, 8); break;
+    default:               memcpy(&args[i].i, p, 4); break;  /* 32-bit, pointer */
+    }
+  }
+  ret.j = 0;
+  ((void (*)(ffi_fp, ffi_wasm_value *, ffi_wasm_value *)) (uintptr_t) trampoline)(fn, args, &ret);
+  if (rvalue == NULL)
+    return;
+  /* integral results narrower than ffi_arg are widened to ffi_arg */
+  switch (cif->rtype->type) {
+  case FFI_TYPE_UINT8:   *(ffi_arg *) rvalue = (uint8_t) ret.i; break;
+  case FFI_TYPE_SINT8:   *(ffi_sarg *) rvalue = (int8_t) ret.i; break;
+  case FFI_TYPE_UINT16:  *(ffi_arg *) rvalue = (uint16_t) ret.i; break;
+  case FFI_TYPE_SINT16:  *(ffi_sarg *) rvalue = (int16_t) ret.i; break;
+  case FFI_TYPE_INT:
+  case FFI_TYPE_SINT32:
+  case FFI_TYPE_UINT32:
+  case FFI_TYPE_POINTER: memcpy(rvalue, &ret.i, 4); break;
+  case FFI_TYPE_UINT64:
+  case FFI_TYPE_SINT64:  memcpy(rvalue, &ret.j, 8); break;
+  case FFI_TYPE_FLOAT:   memcpy(rvalue, &ret.f, 4); break;
+  case FFI_TYPE_DOUBLE:  memcpy(rvalue, &ret.d, 8); break;
+  default: break;
+  }
+}
+
 void ffi_call(ffi_cif *cif, void (*fn)(void), void *rvalue, void **avalue) {
+  unsigned int trampoline = cif->flags >> TRAMPOLINE_SHIFT;
+  if (trampoline) {
+    ffi_call_trampoline(cif, trampoline, fn, rvalue, avalue);
+    return;
+  }
   ffi_call_js(cif, fn, rvalue, avalue);
 }
 
