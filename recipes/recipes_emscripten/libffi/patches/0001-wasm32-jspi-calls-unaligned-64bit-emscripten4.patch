+/* likewise malloc/free for closures */
+EMSCRIPTEN_KEEPALIVE void *ffi_wasm_malloc(size_t size) { return malloc(size); }
+EMSCRIPTEN_KEEPALIVE void ffi_wasm_free(void *p) { free(p); }
