diff --git a/CMakeLists.txt b/CMakeLists.txt
index 442146c..bea5e83 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -169,8 +169,30 @@ endif()
 # Switch between GTK4 and GTK3.
 option(USE_GTK4 "Build for GTK4 (instead of GTK3)" OFF)
 
-# Include packaging logic.
-include(cmake/packaging.cmake)
+# Only build the 'cadabra2' Python module, its Python support files and
+# the 'cdb' packages; skip the command line tools, the client/server
+# and all GUI components. This is what is needed to use Cadabra from
+# an existing Python interpreter (e.g. for WebAssembly/Pyodide-like
+# environments), and it avoids the dependencies on glibmm, sqlite,
+# openssl and the compiled Boost libraries.
+option(CADABRA_PYTHON_MODULE_ONLY "Only build the cadabra2 Python module and the cdb packages" OFF)
+
+# Build the compiled 'cdb' packages (cdb.core._component, cdb.utils._algorithm)
+# into the main cadabra2 Python module instead of as separate extension
+# modules which link against it. Required on platforms without a regular
+# dynamic linker (e.g. Emscripten/WebAssembly).
+option(EMBED_COMPILED_PACKAGES "Build the compiled cdb packages into the cadabra2 module" OFF)
+
+if(CADABRA_PYTHON_MODULE_ONLY)
+  message(STATUS "Only building the cadabra2 Python module")
+  set(ENABLE_FRONTEND OFF CACHE BOOL "" FORCE)
+  set(ENABLE_JUPYTER OFF CACHE BOOL "" FORCE)
+  set(ENABLE_PY_JUPYTER OFF CACHE BOOL "" FORCE)
+  set(BUILD_TESTS OFF CACHE BOOL "" FORCE)
+else()
+  # Include packaging logic.
+  include(cmake/packaging.cmake)
+endif()
 
 #---------------------------------------------------------------------------
