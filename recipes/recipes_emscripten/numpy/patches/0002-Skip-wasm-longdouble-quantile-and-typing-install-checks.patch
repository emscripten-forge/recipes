From cf2d4f2181a3787d815f91e8c2b77f463a53c5a3 Mon Sep 17 00:00:00 2001
From: Julien Jerphanion <git@jjerphan.xyz>
Date: Tue, 8 Sep 2026 13:34:24 +0200
Subject: [PATCH] Skip wasm longdouble quantile interpolation and typing
 install checks

np.test(label="full") on wasm fails these remaining cases after the
Dragon4 / strtold print tests are skipped by 0001. They are wasm
longdouble / packaging issues, not BLAS or LAPACK.

Observed on the allow-noblas control (#6613, 7 failed including print
tests) and on the OpenBLAS-linked build (#6310, 3 failed with print
skips already applied):

1. TestPercentile.test_linear_interpolation longdouble quantile 0.4
   inverted_cdf:        actual 35.0, expected 20.0
   averaged_inverted_cdf: actual 35.0, expected 27.5
   Emscripten long double is IEEE binary128. The 0.4 quantile is still
   a binary64 value (or parsed as one by strtold), so inverted_cdf
   methods pick the wrong order statistic.

2. typing.tests.test_isfile.TestIsFile.test_isfile
   Asserts numpy/py.typed and *.pyi stubs exist. numpy-tests overlays
   *.pyi, but py.typed is not in the installed tree.

Skip those cases on IS_WASM. Print skips stay in 0001.

Signed-off-by: Julien Jerphanion <git@jjerphan.xyz>
---
 numpy/lib/tests/test_function_base.py | 9 +++++++++
 numpy/typing/tests/test_isfile.py     | 7 ++++++-
 2 files changed, 16 insertions(+), 1 deletion(-)

diff --git a/numpy/lib/tests/test_function_base.py b/numpy/lib/tests/test_function_base.py
index cd3d348..be45eb6 100644
--- a/numpy/lib/tests/test_function_base.py
+++ b/numpy/lib/tests/test_function_base.py
@@ -3434,6 +3434,15 @@ class TestPercentile:
                                   expected_dtype):
         expected_dtype = np.dtype(expected_dtype)
 
+        # Emscripten long double is IEEE binary128. np.quantile(..., 0.4)
+        # still sees 0.4 as a binary64 value (or strtold binary64), so
+        # inverted_cdf / averaged_inverted_cdf pick the wrong order
+        # statistic (35 instead of 20 / 27.5).
+        if IS_WASM and input_dtype is np.longdouble:
+            pytest.skip(
+                "wasm IEEE-quad longdouble makes quantile 0.4 pick the wrong order statistic"
+            )
+
         arr = np.asarray([15.0, 20.0, 35.0, 40.0, 50.0], dtype=input_dtype)
         weights = np.ones_like(arr) if weighted else None
         if input_dtype is np.longdouble:
diff --git a/numpy/typing/tests/test_isfile.py b/numpy/typing/tests/test_isfile.py
index 250686a..d9c02b5 100644
--- a/numpy/typing/tests/test_isfile.py
+++ b/numpy/typing/tests/test_isfile.py
@@ -4,7 +4,7 @@ from pathlib import Path
 import pytest
 
 import numpy as np
-from numpy.testing import assert_
+from numpy.testing import IS_WASM, assert_
 
 ROOT = Path(np.__file__).parents[0]
 FILES = [
@@ -29,6 +29,10 @@ FILES = [
            "Expected to only be a problem in 3.14.0"
 )
 class TestIsFile:
+    # numpy-tests overlays *.pyi, but py.typed is not installed.
+    @pytest.mark.skipif(IS_WASM, reason=(
+        "emscripten-forge numpy package does not install py.typed"
+    ))
     def test_isfile(self):
         """Test if all ``.pyi`` files are properly installed."""
         for file in FILES:
