 libgnu/Makefile.am |  418 +++++++++---------
 libgnu/Makefile.in | 1021 ++++++++++++++++++++++----------------------
 2 files changed, 721 insertions(+), 718 deletions(-)

diff --git a/libgnu/Makefile.am b/libgnu/Makefile.am
index 2a42348..b40bce1 100644
