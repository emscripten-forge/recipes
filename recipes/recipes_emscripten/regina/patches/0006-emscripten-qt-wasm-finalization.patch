--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -565,6 +565,23 @@
 ELSE(DISABLE_GUI)
   set(CMAKE_AUTOMOC ON)
 
+  if (EMSCRIPTEN)
+    # Qt6's wasm target-finalization (the step that actually generates a
+    # <target>.html host page plus qtloader.js, rather than Emscripten's
+    # own generic default shell) lives in a CMake module that qt-cmake
+    # normally injects automatically via Qt's own toolchain file.
+    # emscripten-forge invokes cmake directly against Emscripten's own
+    # Emscripten.cmake toolchain file instead of qt-cmake, so that
+    # auto-inclusion never happens. Include it by hand, before Qt6 is even
+    # looked up, so QT_ADD_EXECUTABLE() in qtui/src/CMakeLists.txt picks up
+    # its wasm finalization logic.
+    find_file(QT_WASM_HELPERS
+        NAMES QtPublicWasmToolchainHelpers.cmake
+        PATHS "$ENV{PREFIX}/lib/cmake/Qt6" "$ENV{PREFIX}/lib/cmake/Qt6Core"
+        NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH REQUIRED)
+    include("${QT_WASM_HELPERS}")
+  endif (EMSCRIPTEN)
+
   # At present, regina only supports Qt6 (not Qt5).  However, we still use
   # regina's own Qt-related variables in case at some point in the future we
   # support multiple Qt versions again (e.g., Qt6 and Qt7?).
--- a/qtui/src/CMakeLists.txt
+++ b/qtui/src/CMakeLists.txt
@@ -162,9 +162,83 @@
 
 set(REGINA_BUNDLE_DEST bin)
 
-ADD_EXECUTABLE(${REGINA_APP_NAME} MACOSX_BUNDLE WIN32 ${SOURCES})
+if (EMSCRIPTEN)
+  # QT_ADD_EXECUTABLE (rather than plain ADD_EXECUTABLE) is what actually
+  # triggers Qt6's wasm target-finalization: generating a Qt-aware
+  # <target>.html and copying qtloader.js next to it, instead of a bare
+  # regina-gui.js/.wasm with no host page at all. This only takes effect
+  # because QtPublicWasmToolchainHelpers.cmake was included by hand up in
+  # the top-level CMakeLists.txt (see the EMSCRIPTEN block there) -- on
+  # every other platform this is identical to plain ADD_EXECUTABLE.
+  QT_ADD_EXECUTABLE(${REGINA_APP_NAME} MACOSX_BUNDLE WIN32 ${SOURCES})
+else (EMSCRIPTEN)
+  ADD_EXECUTABLE(${REGINA_APP_NAME} MACOSX_BUNDLE WIN32 ${SOURCES})
+endif (EMSCRIPTEN)
+
+if (EMSCRIPTEN)
+  # QT_ADD_EXECUTABLE() links this target to Qt::Core itself, internally,
+  # using the *keyword* target_link_libraries() signature (PRIVATE/PUBLIC/
+  # INTERFACE). CMake requires every target_link_libraries() call against
+  # the same target to use one signature style consistently -- mixing
+  # keyword and plain calls on one target is a hard configure-time error.
+  # So on this platform we must also use the keyword form here.
+  TARGET_LINK_LIBRARIES(${REGINA_APP_NAME} PRIVATE ${LINK_LIBS})
+else (EMSCRIPTEN)
+  TARGET_LINK_LIBRARIES(${REGINA_APP_NAME} ${LINK_LIBS})
+endif (EMSCRIPTEN)
 
-TARGET_LINK_LIBRARIES(${REGINA_APP_NAME} ${LINK_LIBS})
+if (EMSCRIPTEN)
+  # Preload icons and census databases directly into this target's own
+  # regina-gui.js at link time (rather than as a separate file_packager.py
+  # post-processing step), so the fetch/mount logic ships inside
+  # regina-gui.js itself instead of a second regina-gui.data.js loader that
+  # has to be ordered carefully against qtloader.js in the host page.
+  # Destinations mirror ${PREFIX}/share/regina/{icons,data/census} exactly
+  # (see GlobalDirs in engine/file/globaldirs.cpp), since that is the
+  # compile-time default GlobalDirs falls back to when REGINA_HOME is
+  # unset. Sources are read from *before* `ninja install` runs: the icon
+  # PNGs straight from the source tree, and the census .tkh databases from
+  # where mkcensusdb generates them during the build
+  # (PROJECT_BINARY_DIR/engine/data/census) -- both already exist by the
+  # time this target links, unlike the installed copies under ${PREFIX},
+  # which only exist after a later, separate `ninja install` step.
+  #
+  # Each --preload-file is wrapped as one "SHELL:" unit deliberately:
+  # target_link_options() de-duplicates identical string entries across a
+  # target's accumulated link options, and the bare flag "--preload-file"
+  # is byte-identical between the two calls below, so without SHELL:
+  # CMake silently drops the second occurrence, leaving the census path
+  # as an orphaned positional argument with no flag in front of it --
+  # which em++ then tries (and fails) to treat as an input file to
+  # compile. Wrapping flag+value as one SHELL: string keeps each entry
+  # unique and keeps them paired correctly.
+  #
+  # -sJSPI=1 is here because Regina's "New <packet type>" dialogs (and
+  # others) call QDialog::exec(), which Qt for WebAssembly cannot support
+  # without either Asyncify or JSPI. Asyncify was tried first and crashes
+  # (SIGABRT, an internal Binaryen assertion failure) at the wasm-opt
+  # instrumentation step, because Binaryen's Asyncify pass does not support
+  # the native wasm exception-handling constructs -fwasm-exceptions
+  # produces -- and dropping -fwasm-exceptions isn't an option, since Qt's
+  # own prebuilt libraries in this channel were built with it and Regina's
+  # engine has to match that exception model to link/behave correctly
+  # against them (see the ABI note in build.sh). JSPI is a different
+  # mechanism -- host-level stack switching, not a Binaryen bytecode pass
+  # -- so it doesn't hit that crash. It requires the qt6-main-jspi variant
+  # of Qt6 (see requirements: host: in recipe.yaml) since Qt's own
+  # QEventDispatcherWasm needs JSPI-aware code paths compiled in; this
+  # explicit flag is redundant with what qt6-main-jspi's CMake config
+  # already propagates via INTERFACE_LINK_OPTIONS, but belt-and-braces,
+  # matching the qt-calculator-experimental recipe's own rationale. Note
+  # JSPI needs a fairly recent browser (roughly Chrome 137+, Firefox 141+,
+  # Safari 18.4+ at the time of writing) -- if the "no screens"/exec()
+  # crashes reappear, check the browser's JSPI support first.
+  target_link_options(${REGINA_APP_NAME} PRIVATE
+      -sJSPI=1
+      "SHELL:--preload-file ${CMAKE_CURRENT_SOURCE_DIR}/icons@$ENV{PREFIX}/share/regina/icons"
+      "SHELL:--preload-file ${PROJECT_BINARY_DIR}/engine/data/census@$ENV{PREFIX}/share/regina/data/census"
+  )
+endif (EMSCRIPTEN)
 
 if (APPLE)
   set_target_properties(${REGINA_APP_NAME}
