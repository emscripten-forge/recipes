@@ -0,0 +1,112 @@
+
+/**************************************************************************
+ *                                                                        *
+ *  Regina - A Normal Surface Theory Calculator                           *
+ *  Qt User Interface                                                     *
+ *                                                                        *
+ *  Synchronous stand-in for std::thread on wasm32-emscripten.            *
+ *                                                                        *
+ **************************************************************************/
+
+/*! \file wasmsyncthread.h
+ *  \brief Provides ReginaGuiThread, which is std::thread everywhere except
+ *  under Emscripten, where it runs the given task synchronously instead.
+ *
+ *  Regina's GUI runs every long computation on a worker thread while a
+ *  progress dialog polls a ProgressTracker on the main thread:
+ *
+ *      regina::ProgressTrackerOpen tracker;
+ *      ProgressDialogOpen dlg(&tracker, ...);
+ *      std::thread t(&Link::simplifyExhaustive, link, height,
+ *          ReginaPrefSet::threads(), std::addressof(tracker));
+ *      result = dlg.run();
+ *      t.join();
+ *
+ *  This build has no pthreads (Qt for WebAssembly is built without thread
+ *  support, and enabling it would additionally require SharedArrayBuffer
+ *  and COOP/COEP headers on whatever serves the page). Constructing a
+ *  std::thread therefore fails, and because the failure is a C++ exception
+ *  thrown inside a Qt event handler, it unwinds all the way out of main()
+ *  under JSPI -- surfacing only as an unhandled promise rejection with no
+ *  usable stack, and killing the application. Every such computation in the
+ *  GUI is affected: normal surface and hypersurface enumeration, angle
+ *  structures, the knot polynomials, Turaev-Viro invariants, exhaustive
+ *  simplification and treewidth improvement.
+ *
+ *  ReginaGuiThread runs the task to completion inside its own constructor,
+ *  and makes join() and detach() no-ops. The surrounding code needs no
+ *  other change: all four ProgressDialog::run() implementations are of the
+ *  form
+ *
+ *      show(); ... while (! tracker_->isFinished()) { ... }
+ *      return ! tracker_->isCancelled();
+ *
+ *  so when the work has already finished they skip the wait loop entirely
+ *  and report success.
+ *
+ *  The cost is real and unavoidable here: these computations now block the
+ *  browser's main thread, so the interface does not repaint while they run
+ *  and the progress dialog's Cancel button cannot be used. A long
+ *  exhaustive search will appear to hang the page until it completes.
+ *  Callers should also pass a thread count of 1 to the engine, so that it
+ *  does not try to spawn workers of its own; ReginaPrefSet::threads()
+ *  returns 1 on this platform for exactly that reason.
+ */
+
+#ifndef __WASMSYNCTHREAD_H
+#define __WASMSYNCTHREAD_H
+
+#ifdef __EMSCRIPTEN__
+
+#include <functional>
+#include <utility>
+
+namespace regina::wasm {
+
+/**
+ * Runs a task synchronously, presenting the small part of the std::thread
+ * interface that Regina's GUI uses.
+ */
+class SyncThread {
+    public:
+        SyncThread() = default;
+
+        /**
+         * Invokes the given callable immediately, with the given arguments,
+         * and returns only once it has finished.
+         *
+         * The argument list is forwarded through std::invoke, which accepts
+         * the same forms std::thread does -- in particular both a lambda and
+         * a pointer-to-member-function followed by an object.
+         *
+         * Unlike std::thread, arguments are not decay-copied; since the call
+         * happens here and now, passing them through by reference is both
+         * safe and cheaper.
+         */
+        template <typename Fn, typename... Args>
+        explicit SyncThread(Fn&& fn, Args&&... args) {
+            std::invoke(std::forward<Fn>(fn), std::forward<Args>(args)...);
+        }
+
+        SyncThread(const SyncThread&) = delete;
+        SyncThread& operator = (const SyncThread&) = delete;
+
+        /** Does nothing: the task has already finished. */
+        void join() {}
+        /** Does nothing: the task has already finished. */
+        void detach() {}
+};
+
+} // namespace regina::wasm
+
+#define ReginaGuiThread regina::wasm::SyncThread
+
+#else // ! __EMSCRIPTEN__
+
+#include <thread>
+
+#define ReginaGuiThread std::thread
+
+#endif // __EMSCRIPTEN__
+
+#endif
