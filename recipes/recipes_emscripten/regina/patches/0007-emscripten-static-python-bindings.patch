@@ -0,0 +1,49 @@
+/**
+ * Emscripten JS library shim for Regina's wasm32 build.
+ *
+ * This file exists solely so that CPython can be linked statically into
+ * regina-gui (see PYTHON_STATIC_LINK in the top-level CMakeLists.txt).
+ *
+ * CPython's Emscripten glue assumes the -sMAIN_MODULE configuration that
+ * upstream builds and tests it in. Python/emscripten_syscalls.c contains a
+ * startup EM_JS that does, in essence:
+ *
+ *     const origResolveGlobalSymbol = resolveGlobalSymbol;
+ *     resolveGlobalSymbol = function (name, direct = false) {
+ *         const orig = origResolveGlobalSymbol(name, direct);
+ *         if (name === "main") { ...wrap in WebAssembly.promising... }
+ *         return orig;
+ *     };
+ *
+ * i.e. it hooks the dynamic linker's symbol resolver so that, when Python
+ * is the program, main() runs under WebAssembly.promising and can suspend.
+ * resolveGlobalSymbol() is provided by Emscripten's libdylink.js, which is
+ * only linked in for dynamic-linking builds. In a plain static link it does
+ * not exist, so that constructor throws
+ *
+ *     ReferenceError: resolveGlobalSymbol is not defined
+ *
+ * from __wasm_call_ctors, before any Regina code runs. (Upstream is fixing
+ * this by moving the main() wrapping out of libpython entirely -- see
+ * python/cpython#156781 -- since it only makes sense when Python is the
+ * program. Here it is not: Qt owns main().)
+ *
+ * Defining it here gives that constructor something to hook, so startup
+ * proceeds. Nothing in a static build ever calls resolveGlobalSymbol --
+ * it exists for resolving symbols across dynamically loaded side modules,
+ * of which there are none -- so CPython's wrapper is installed and then
+ * never invoked. The lookup below is nonetheless a faithful enough
+ * approximation to behave sensibly if anything ever did call it.
+ */
+
+addToLibrary({
+  $resolveGlobalSymbol: function (name, direct) {
+    var sym;
+    if (typeof Module !== 'undefined' && Module['_' + name]) {
+      sym = Module['_' + name];
+    } else if (typeof wasmExports !== 'undefined') {
+      sym = wasmExports[name] || wasmExports['_' + name];
+    }
+    return { sym: sym, name: name };
+  },
+});
