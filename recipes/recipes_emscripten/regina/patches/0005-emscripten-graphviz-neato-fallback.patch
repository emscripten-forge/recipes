 void Graphviz::render(QSvgWidget* widget, const std::string& dot,
         Renderer renderer) {
+#ifdef __EMSCRIPTEN__
+    // The Emscripten/WASM build of Regina's Graphviz dependency does not
+    // include the "neato" layout plugin (only "core" and "dot"), so fall
+    // back to the "dot" layout engine for any graph that would otherwise
+    // have requested "neato" (e.g., the triangulation dual/face-pairing
