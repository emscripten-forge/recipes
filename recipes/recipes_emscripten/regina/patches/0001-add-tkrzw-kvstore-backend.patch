+    SET(KVStore_DISPLAYNAME "Tkrzw")
+    SET(KVStore_DISPLAYURL "https://dbmx.net/tkrzw/")
+    SET(DB_EXT "tkh")
+  ENDIF (${REGINA_KVSTORE} STREQUAL tkrzw OR KVStore_FOUND)
+ENDIF()
