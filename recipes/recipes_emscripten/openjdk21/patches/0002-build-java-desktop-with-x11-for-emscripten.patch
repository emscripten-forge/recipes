diff --git a/make/modules/java.desktop/Lib.gmk b/make/modules/java.desktop/Lib.gmk
index be1ac3f1f..51fca155f 100644
--- a/make/modules/java.desktop/Lib.gmk
+++ b/make/modules/java.desktop/Lib.gmk
@@ -51,6 +51,19 @@ ifeq ($(call isTargetOs, aix), false)
       -DUSE_PLATFORM_MIDI_IN=TRUE \
       #
 
+  ifeq ($(call isTargetOs, emscripten), true)
+    # No audio or MIDI devices are reachable from wasm: build the common code
+    # only, so Java Sound reports no devices instead of calling missing
+    # platform functions.
+    LIBJSOUND_CFLAGS := \
+        -DX_PLATFORM=X_EMSCRIPTEN \
+        -DUSE_PORTS=FALSE \
+        -DUSE_DAUDIO=FALSE \
+        -DUSE_PLATFORM_MIDI_OUT=FALSE \
+        -DUSE_PLATFORM_MIDI_IN=FALSE \
+        #
+  endif
+
   ifeq ($(call isTargetOs, macosx), true)
     LIBJSOUND_TOOLCHAIN := TOOLCHAIN_LINK_CXX
   endif
diff --git a/make/modules/java.desktop/gensrc/GensrcX11Wrappers.gmk b/make/modules/java.desktop/gensrc/GensrcX11Wrappers.gmk
index 25402ad03..e6fff7dd9 100644
--- a/make/modules/java.desktop/gensrc/GensrcX11Wrappers.gmk
+++ b/make/modules/java.desktop/gensrc/GensrcX11Wrappers.gmk
@@ -32,6 +32,12 @@ GENSRC_X11WRAPPERS_OUTPUTDIR := $(SUPPORT_OUTPUTDIR)/gensrc/java.desktop/sun/awt
 # The pre-calculated offset file are stored here:
 GENSRC_X11WRAPPERS_DATADIR := $(MODULE_SRC)/unix/data/x11wrappergen
 GENSRC_X11WRAPPERS_DATA := $(GENSRC_X11WRAPPERS_DATADIR)/sizes-$(OPENJDK_TARGET_CPU_BITS).txt
+ifeq ($(call isTargetOs, emscripten), true)
+  # Layouts for x11.wasm's headers on wasm32 (KeyCode is an unsigned long
+  # there, which moves the XKB event fields). Generated with the
+  # WrapperGenerator gen_c_source sizer, compiled with emcc and run in node.
+  GENSRC_X11WRAPPERS_DATA := $(GENSRC_X11WRAPPERS_DATADIR)/sizes-wasm32.txt
+endif
 
 # Run the tool on the offset files to generate several Java classes used in awt.
 $(eval $(call SetupExecute, gen_x11wrappers, \
