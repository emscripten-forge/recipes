@@ -45,6 +45,16 @@ void* getProcessHandle() {
     }
 #ifdef __APPLE__
     procHandle = (void*)dlopen(NULL, RTLD_FIRST);
+#elif defined(__EMSCRIPTEN__)
+    /* No dynamic linking: dlopen(NULL) fails, which made every library with a
