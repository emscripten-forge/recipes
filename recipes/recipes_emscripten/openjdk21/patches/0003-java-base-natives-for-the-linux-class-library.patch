+ * ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or
+ * FITNESS FOR A PARTICULAR PURPOSE.  See the GNU General Public License
+ * version 2 for more details (a copy is included in the LICENSE file that
+ * accompanied this code).
+ *
+ * You should have received a copy of the GNU General Public License version
+ * 2 along with this work; if not, write to the Free Software Foundation,
+ * Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301 USA.
+ */
+
+/*
+ * The emscripten port runs the Linux class library, whose NIO classes call
+ * Linux-only natives (src/java.base/linux/native/libnio). Emscripten has no
+ * epoll, eventfd, inotify, sendfile or copy_file_range, so those sources do
+ * not build. This file provides the same entry points:
+ *
+ *   - FileDispatcherImpl: no in-kernel copies, so transfers report
+ *     IOS_UNSUPPORTED and Java falls back to read/write.
+ *   - LinuxNativeDispatcher: mount table access through <mntent.h> (musl),
+ *     no-op fadvise, and directCopy0 reporting "unsupported" so Files.copy
+ *     uses its buffered path.
+ *   - EPoll / EventFD / LinuxWatchService: fail with an IOException or
+ *     UnixException(ENOSYS), which is how the Linux code reports a missing
+ *     kernel facility. Selectors and WatchService are therefore unavailable.
+ */
+
+#include <errno.h>
+#include <mntent.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+#include "jni.h"
+#include "jni_util.h"
+#include "jlong.h"
+#include "nio.h"
+
+#include "sun_nio_ch_FileDispatcherImpl.h"
+
+/* -------------------------------------------------------------- helpers */
+
+static void throwUnixException(JNIEnv *env, int errnum) {
+    jobject x = JNU_NewObjectByName(env, "sun/nio/fs/UnixException", "(I)V", errnum);
+    if (x != NULL) {
+        (*env)->Throw(env, x);
+    }
+}
+
+static void throwUnavailable(JNIEnv *env, const char *what) {
+    JNU_ThrowIOException(env, what);
+}
+
+/* ---------------------------------------------------- FileDispatcherImpl */
+
+JNIEXPORT void JNICALL
+Java_sun_nio_ch_FileDispatcherImpl_init0(JNIEnv *env, jclass klass)
+{
+}
+
+JNIEXPORT jlong JNICALL
+Java_sun_nio_ch_FileDispatcherImpl_transferFrom0(JNIEnv *env, jobject this,
+                                                 jobject srcFDO, jobject dstFDO,
+                                                 jlong position, jlong count,
+                                                 jboolean append)
+{
+    return IOS_UNSUPPORTED;
+}
+
+JNIEXPORT jlong JNICALL
+Java_sun_nio_ch_FileDispatcherImpl_transferTo0(JNIEnv *env, jobject this,
+                                               jobject srcFDO, jlong position,
+                                               jlong count, jobject dstFDO,
+                                               jboolean append)
+{
+    return IOS_UNSUPPORTED;
+}
+
+/* ------------------------------------------------- LinuxNativeDispatcher */
+
+static jfieldID entry_name;
+static jfieldID entry_dir;
+static jfieldID entry_fstype;
+static jfieldID entry_options;
+
+JNIEXPORT void JNICALL
+Java_sun_nio_fs_LinuxNativeDispatcher_init(JNIEnv *env, jclass clazz)
+{
+    clazz = (*env)->FindClass(env, "sun/nio/fs/UnixMountEntry");
+    CHECK_NULL(clazz);
+    entry_name = (*env)->GetFieldID(env, clazz, "name", "[B");
+    CHECK_NULL(entry_name);
+    entry_dir = (*env)->GetFieldID(env, clazz, "dir", "[B");
+    CHECK_NULL(entry_dir);
+    entry_fstype = (*env)->GetFieldID(env, clazz, "fstype", "[B");
+    CHECK_NULL(entry_fstype);
+    entry_options = (*env)->GetFieldID(env, clazz, "opts", "[B");
+    CHECK_NULL(entry_options);
+}
+
+JNIEXPORT jlong JNICALL
+Java_sun_nio_fs_LinuxNativeDispatcher_setmntent0(JNIEnv *env, jclass this,
+                                                 jlong pathAddress, jlong modeAddress)
+{
+    FILE *fp = setmntent((const char *) jlong_to_ptr(pathAddress),
+                         (const char *) jlong_to_ptr(modeAddress));
+    if (fp == NULL) {
+        throwUnixException(env, errno);
+    }
+    return ptr_to_jlong(fp);
+}
+
+static int setBytes(JNIEnv *env, jobject entry, jfieldID field, const char *s)
+{
+    jsize len = (jsize) strlen(s);
+    jbyteArray bytes = (*env)->NewByteArray(env, len);
+    if (bytes == NULL) {
+        return -1;
+    }
+    (*env)->SetByteArrayRegion(env, bytes, 0, len, (const jbyte *) s);
+    (*env)->SetObjectField(env, entry, field, bytes);
+    return 0;
+}
+
+JNIEXPORT jint JNICALL
+Java_sun_nio_fs_LinuxNativeDispatcher_getmntent0(JNIEnv *env, jclass this,
+                                                 jlong value, jobject entry,
+                                                 jlong buffer, jint bufLen)
+{
+    struct mntent ent;
+    struct mntent *m = getmntent_r((FILE *) jlong_to_ptr(value), &ent,
+                                   (char *) jlong_to_ptr(buffer), (int) bufLen);
+    if (m == NULL) {
+        return -1;
+    }
+    if (setBytes(env, entry, entry_name, m->mnt_fsname) != 0 ||
+        setBytes(env, entry, entry_dir, m->mnt_dir) != 0 ||
+        setBytes(env, entry, entry_fstype, m->mnt_type) != 0 ||
+        setBytes(env, entry, entry_options, m->mnt_opts) != 0) {
+        return -1;
+    }
+    return 0;
+}
+
+JNIEXPORT void JNICALL
+Java_sun_nio_fs_LinuxNativeDispatcher_endmntent(JNIEnv *env, jclass this, jlong stream)
+{
+    endmntent((FILE *) jlong_to_ptr(stream));
+}
+
+JNIEXPORT jint JNICALL
+Java_sun_nio_fs_LinuxNativeDispatcher_posix_1fadvise(JNIEnv *env, jclass this,
+                                                     jint fd, jlong offset,
+                                                     jlong len, jint advice)
+{
+    return 0;   /* advisory only */
+}
+
+JNIEXPORT jint JNICALL
+Java_sun_nio_fs_LinuxNativeDispatcher_directCopy0(JNIEnv *env, jclass this,
+                                                  jint dst, jint src,
+                                                  jlong cancelAddress)
+{
+    return IOS_UNSUPPORTED_CASE;   /* caller falls back to a buffered copy */
+}
+
+/* ------------------------------------------------------------------ EPoll */
+
+/* Layout of Linux's struct epoll_event on 32-bit targets (packed). Only used
+ * to size buffers; epoll itself is unavailable. */
+JNIEXPORT jint JNICALL
+Java_sun_nio_ch_EPoll_eventSize(JNIEnv *env, jclass clazz)
+{
+    return 12;
+}
+
+JNIEXPORT jint JNICALL
+Java_sun_nio_ch_EPoll_eventsOffset(JNIEnv *env, jclass clazz)
+{
+    return 0;
+}
+
+JNIEXPORT jint JNICALL
+Java_sun_nio_ch_EPoll_dataOffset(JNIEnv *env, jclass clazz)
+{
+    return 4;
+}
+
+JNIEXPORT jint JNICALL
+Java_sun_nio_ch_EPoll_create(JNIEnv *env, jclass clazz)
+{
+    throwUnavailable(env, "epoll is not available on emscripten");
+    return -1;
+}
+
+JNIEXPORT jint JNICALL
+Java_sun_nio_ch_EPoll_ctl(JNIEnv *env, jclass clazz, jint epfd,
+                          jint opcode, jint fd, jint events)
+{
+    return ENOSYS;
+}
+
+JNIEXPORT jint JNICALL
+Java_sun_nio_ch_EPoll_wait(JNIEnv *env, jclass clazz, jint epfd,
+                           jlong address, jint numfds, jint timeout)
+{
+    throwUnavailable(env, "epoll is not available on emscripten");
+    return -1;
+}
+
+/* ---------------------------------------------------------------- EventFD */
+
+JNIEXPORT jint JNICALL
+Java_sun_nio_ch_EventFD_eventfd0(JNIEnv *env, jclass klazz)
+{
+    throwUnavailable(env, "eventfd is not available on emscripten");
+    return -1;
+}
+
+JNIEXPORT jint JNICALL
+Java_sun_nio_ch_EventFD_set0(JNIEnv *env, jclass klazz, jint efd)
+{
+    throwUnavailable(env, "eventfd is not available on emscripten");
+    return -1;
+}
+
+/* ------------------------------------------------------ LinuxWatchService */
+
+JNIEXPORT jint JNICALL
+Java_sun_nio_fs_LinuxWatchService_eventSize(JNIEnv *env, jclass clazz)
+{
+    return 16;   /* sizeof(struct inotify_event) */
+}
+
+JNIEXPORT jintArray JNICALL
+Java_sun_nio_fs_LinuxWatchService_eventOffsets(JNIEnv *env, jclass clazz)
+{
+    /* wd, mask, cookie, len, name -- as in struct inotify_event */
+    jint arr[5] = { 0, 4, 8, 12, 16 };
+    jintArray result = (*env)->NewIntArray(env, 5);
+    if (result != NULL) {
+        (*env)->SetIntArrayRegion(env, result, 0, 5, arr);
+    }
+    return result;
+}
+
+JNIEXPORT jint JNICALL
+Java_sun_nio_fs_LinuxWatchService_inotifyInit(JNIEnv *env, jclass clazz)
+{
+    throwUnixException(env, ENOSYS);
+    return -1;
+}
+
+JNIEXPORT jint JNICALL
+Java_sun_nio_fs_LinuxWatchService_inotifyAddWatch(JNIEnv *env, jclass clazz,
+                                                  jint fd, jlong address, jint mask)
+{
+    throwUnixException(env, ENOSYS);
+    return -1;
+}
+
+JNIEXPORT void JNICALL
+Java_sun_nio_fs_LinuxWatchService_inotifyRmWatch(JNIEnv *env, jclass clazz,
+                                                 jint fd, jint wd)
+{
+    throwUnixException(env, ENOSYS);
+}
+
+JNIEXPORT void JNICALL
+Java_sun_nio_fs_LinuxWatchService_configureBlocking(JNIEnv *env, jclass clazz,
+                                                    jint fd, jboolean blocking)
+{
+    throwUnixException(env, ENOSYS);
+}
+
+JNIEXPORT void JNICALL
+Java_sun_nio_fs_LinuxWatchService_socketpair(JNIEnv *env, jclass clazz, jintArray sv)
+{
+    throwUnixException(env, ENOSYS);
+}
+
+JNIEXPORT jint JNICALL
+Java_sun_nio_fs_LinuxWatchService_poll(JNIEnv *env, jclass clazz, jint fd1, jint fd2)
+{
+    throwUnixException(env, ENOSYS);
+    return -1;
+}
