+#ifndef OS_EMSCRIPTEN_OS_EMSCRIPTEN_HPP
+#define OS_EMSCRIPTEN_OS_EMSCRIPTEN_HPP
+
+#include "runtime/os.hpp"
+
+// os::Emscripten defines the interface to the Emscripten/WebAssembly runtime.
+//
+// The module runs inside a single WebAssembly linear memory, so most of what a
+// native OS port would query from the kernel is either a compile-time constant
+// or simply unavailable. Anything that has no meaning in a browser sandbox is
+// answered with a conservative constant rather than an error.
+
+class os::Emscripten {
+  friend class os;
+
+ protected:
+
+  static julong _physical_memory;
+  static pthread_t _main_thread;
+
+  static julong available_memory();
+  static julong free_memory();
+  static julong physical_memory() { return _physical_memory; }
+  static void initialize_system_info();
+
+ public:
+
+  static void init_thread_fpu_state();
+  static int  get_fpu_control_word();
+  static void set_fpu_control_word(int fpu_control);
+
+  static pthread_t main_thread(void)                                { return _main_thread; }
+
+  static pid_t gettid();
+
+  static intptr_t* ucontext_get_sp(const ucontext_t* uc);
+  static intptr_t* ucontext_get_fp(const ucontext_t* uc);
+
+  // Real-time clock functions
+  static void clock_init(void);
+
+  // Static replacement for the dynamic loader. WebAssembly modules are linked
+  // statically, so dll_load()/dll_lookup() are answered out of a table built
+  // at link time; see os_emscripten.cpp.
+  static void* dll_lookup_static(const char* name);
+
+  static void print_uptime_info(outputStream* st);
+};
+
+#endif // OS_EMSCRIPTEN_OS_EMSCRIPTEN_HPP
