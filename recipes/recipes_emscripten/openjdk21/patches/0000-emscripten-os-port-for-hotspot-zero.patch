+////////////////////////////////////////////////////////////////////////////////
+// static symbol dispatch table
+//
+// There is no dynamic loader. Everything the VM would normally dlopen() is
+// already linked into the single module, so dll_load() hands back a token
+// standing for the requested library and lookups are answered out of the
+// table below rather than by walking a symbol table at runtime.
+//
+// The table itself cannot live here. It has to name every JNI entry point in
+// libjava/libnio/libzip/libjimage, and those archives are built after libjvm
+// and linked after it. So the embedder generates the table at link time and
+// exposes it through the two weak symbols below; libjvm only holds the lookup
+// logic. If no table was supplied the weak pointer is null and every lookup
+// simply misses, which is also what a build without java.base natives wants.
+//
+// Note that this is what keeps the natives alive at all: with no dlsym there is
+// no other reference to any Java_* function, and wasm-ld would garbage-collect
+// the lot.
+
+extern "C" {
+  struct EmscriptenStaticSymbol {
+    const char* name;
+    void*       addr;
+  };
+
+  // Null-terminated; supplied by the embedder.
+  extern const EmscriptenStaticSymbol emscripten_static_symbols[] __attribute__((weak));
+}
+
+void* os::Emscripten::dll_lookup_static(const char* name) {
+  if (name == nullptr || emscripten_static_symbols == nullptr) {
+    return nullptr;
+  }
+  for (const EmscriptenStaticSymbol* e = emscripten_static_symbols; e->name != nullptr; e++) {
+    if (strcmp(e->name, name) == 0) {
+      return e->addr;
+    }
+  }
+  log_debug(os)("Dynamic loading not supported in Emscripten WASM: %s", name);
+  return nullptr;
+}
+
+void* os::dll_lookup(void* handle, const char* name) {
+  // Deliberately not dlsym(): see above.
+  return os::Emscripten::dll_lookup_static(name);
+}
+
+void* os::get_default_process_handle() {
+  // dlopen(nullptr) is a stub that returns nullptr unless the module was built
+  // with dynamic linking, and callers treat nullptr as failure. There is only
+  // ever one module here, so hand back a stable non-null token; dll_lookup
+  // ignores the handle and answers out of the static table anyway.
+  static int process_handle_token = 0;
+  return &process_handle_token;
+}
+
+void* os::dll_load(const char* filename, char* ebuf, int ebuflen) {
+  log_info(os)("attempting shared library load of %s", filename);
+  // Everything is statically linked; hand back the process handle so the
+  // shared code proceeds to look the entry points up by name.
+  log_debug(os)("Dynamic loading not supported in Emscripten WASM");
+  return os::get_default_process_handle();
+}
