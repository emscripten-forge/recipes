+///////////////////////////////////////////////////////////////////////////////
+// thread stack
+
+size_t os::_compiler_thread_min_stack_allowed = 64 * K;
+size_t os::_java_thread_min_stack_allowed = 64 * K;
+size_t os::_vm_internal_thread_min_stack_allowed = 64 * K;
+
+size_t os::Posix::default_stack_size(os::ThreadType thr_type) {
+  // Every pthread stack is carved out of the single linear memory the
+  // module is given, so keep the defaults modest.
+  return (thr_type == os::compiler_thread ? 2 * M : 512 * K);
+}
+
+static void current_stack_region(address *bottom, size_t *size) {
+  // emscripten_stack_get_base() is the high address the stack grows down
+  // from, emscripten_stack_get_end() the low address it may not pass.
+  // Both are per-thread and are valid on the main thread as well as on
+  // pthreads, which is why they are used here in place of the
+  // pthread_getattr_np()/primordial-thread dance the POSIX ports do.
+  address stack_top = (address) emscripten_stack_get_base();
+  address stack_bottom = (address) emscripten_stack_get_end();
+
+  assert(stack_bottom < stack_top, "sanity");
+  assert(os::current_stack_pointer() >= stack_bottom, "should do");
+  assert(os::current_stack_pointer() < stack_top, "should do");
+
+  *bottom = stack_bottom;
+  *size = stack_top - stack_bottom;
+}
+
+address os::current_stack_base() {
+  address bottom;
+  size_t size;
+  current_stack_region(&bottom, &size);
+  return bottom + size;
+}
+
+size_t os::current_stack_size() {
+  // stack size includes normal stack and HotSpot guard pages
+  address bottom;
+  size_t size;
+  current_stack_region(&bottom, &size);
+  return size;
+}
