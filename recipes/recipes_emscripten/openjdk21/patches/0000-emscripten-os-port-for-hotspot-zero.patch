+static char saved_jvm_path[MAXPATHLEN] = {0};
+
+// Find the full path to the current module, libjvm
+void os::jvm_path(char *buf, jint buflen) {
+  // Error checking.
+  if (buflen < MAXPATHLEN) {
+    assert(false, "must use a large-enough buffer");
+    buf[0] = '\0';
+    return;
+  }
+  // Lazy resolve the path to current module.
+  if (saved_jvm_path[0] != 0) {
+    strcpy(buf, saved_jvm_path);
+    return;
+  }
+
+  // There is no libjvm image and no dladdr() to locate one. The layout the
+  // embedder stages into the module's filesystem is the answer instead:
+  // JAVA_HOME is where the jimage lives, and init_system_properties_values()
+  // walks two components up from the path returned here.
+  // This runs from Arguments::init_system_properties(), before any -D option
+  // is parsed, so -Djava.home cannot be consulted here. The environment is the
+  // only channel the embedder has this early.
+  const char* java_home = ::getenv("JAVA_HOME");
+  if (java_home == nullptr || *java_home == '\0') {
+    java_home = "/opt/jdk";
+  }
+  jio_snprintf(buf, buflen, "%s/lib/%s/libjvm%s",
+               java_home, JVM_VARIANT, JNI_LIB_SUFFIX);
+
+  strncpy(saved_jvm_path, buf, MAXPATHLEN);
+  saved_jvm_path[MAXPATHLEN - 1] = '\0';
+}
