+// The subdirectory of <java_home>/lib that libjvm would live in. This port
+// only ever builds the zero variant, but keep the same shape as the other
+// POSIX ports so the path logic stays recognisable.
+#ifdef ZERO
+  #define JVM_VARIANT "zero"
+#elif defined(COMPILER2)
