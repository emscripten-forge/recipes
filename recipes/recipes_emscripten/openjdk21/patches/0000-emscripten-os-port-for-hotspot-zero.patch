+frame os::current_frame() {
+  // The only thing that calls this is the stack printing code in
+  // VMError::report.  The frame we hand back has a null pc, which is
+  // ignored as an invalid frame, but a plausible sp so that the stack
+  // bounds step can complete.
+  frame dummy = frame();
