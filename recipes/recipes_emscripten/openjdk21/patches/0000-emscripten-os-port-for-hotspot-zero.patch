+// Virtual Memory
+
+static void warn_fail_commit_memory(char* addr, size_t size, bool exec,
+                                    int err) {
+  warning("INFO: os::commit_memory(" INTPTR_FORMAT ", " SIZE_FORMAT
+          ", %d) failed; error='%s' (errno=%d)", (intptr_t)addr, size, exec,
+           os::errno_name(err), err);
+}
+
+// NOTE: the emscripten mmap() emulation carves regions out of the single
+// linear memory. It honours PROT_* only loosely - wasm has no page
+// protection hardware - but the bookkeeping is what the VM depends on here.
+//
+// It also rejects any mapping request that carries an address: an anonymous
+// mmap is serviced by memalign() and the emulation refuses a non-zero addr
+// (and therefore MAP_FIXED) outright with EINVAL. So the reserve/commit split
+// collapses - whatever pd_reserve_memory handed back is already real, usable
+// memory, and commit/uncommit are pure bookkeeping.
+
+bool os::pd_commit_memory(char* addr, size_t size, bool exec) {
+  // Reserved memory is already backed; there is nothing to fault in and no
+  // way to re-map the range at a fixed address. Anything else would fail
+  // every commit, starting with the safepoint polling page.
+  return true;
+}
+
+bool os::pd_commit_memory(char* addr, size_t size, size_t alignment_hint,
+                          bool exec) {
+  // alignment_hint is ignored on this OS
+  return pd_commit_memory(addr, size, exec);
+}
+
+void os::pd_commit_memory_or_exit(char* addr, size_t size, bool exec,
+                                  const char* mesg) {
+  assert(mesg != nullptr, "mesg must be specified");
+  if (!pd_commit_memory(addr, size, exec)) {
+    // add extra info in product mode for vm_exit_out_of_memory():
+    PRODUCT_ONLY(warn_fail_commit_memory(addr, size, exec, errno);)
+    vm_exit_out_of_memory(size, OOM_MMAP_ERROR, "%s", mesg);
+  }
+}
