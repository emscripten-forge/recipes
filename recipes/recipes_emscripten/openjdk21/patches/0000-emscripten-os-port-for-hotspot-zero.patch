+// for timer info max values which include all bits
+#define ALL_64_BITS CONST64(0xFFFFFFFFFFFFFFFF)
+
+////////////////////////////////////////////////////////////////////////////////
+// global variables
+
+julong os::Emscripten::_physical_memory = 0;
+pthread_t os::Emscripten::_main_thread;
+
+////////////////////////////////////////////////////////////////////////////////
+// utility functions
+
+julong os::Emscripten::available_memory() {
+  // The linear memory grows on demand up to a ceiling fixed at link time
+  // (MAXIMUM_MEMORY). Everything between the current heap size and that
+  // ceiling is what the VM can still get, so that is the honest answer to
+  // "how much memory is available".
+  size_t heap_size = emscripten_get_heap_size();
+  size_t heap_max = emscripten_get_heap_max();
+  if (heap_max <= heap_size) {
+    return 0;
+  }
+  return (julong)(heap_max - heap_size);
+}
+
+julong os::available_memory() {
+  return Emscripten::available_memory();
+}
+
+julong os::free_memory() {
+  return Emscripten::available_memory();
+}
+
+julong os::physical_memory() {
+  return Emscripten::physical_memory();
+}
+
+void os::Emscripten::print_uptime_info(outputStream* st) {
+  // There is no machine to have been up; emscripten_get_now() is a
+  // monotonic millisecond clock started when the module was instantiated,
+  // which is the closest thing to an uptime this port has.
+  double now_ms = emscripten_get_now();
+  os::print_dhm(st, "OS uptime:", (long) (now_ms / 1000.0));
+}
+
+void os::Emscripten::initialize_system_info() {
+  // A WebAssembly module has no sysctl to ask. The core count comes from the
+  // host through sysconf(), and the memory ceiling is the one the linker
+  // baked into the module.
+  long cpus = ::sysconf(_SC_NPROCESSORS_ONLN);
+  set_processor_count(cpus >= 1 ? (int)cpus : 1);
+
+  size_t heap_max = emscripten_get_heap_max();
+  if (heap_max == 0) {
+    _physical_memory = 256 * 1024 * 1024;  // fallback
+  } else {
+    _physical_memory = (julong)heap_max;
+  }
+}
+
+void os::init_system_properties_values() {
+  // The layout below is the generic (non-Apple) POSIX one. The module's
+  // in-memory filesystem is populated by the embedder to match it.
+#define DEFAULT_LIBPATH "/lib:/usr/lib"
+#define SYS_EXT_DIR     "/usr/java/packages"
+#define EXTENSIONS_DIR  "/lib/ext"
+
+  // Buffer that fits several sprintfs.
+  char buf[3 * MAXPATHLEN + sizeof(EXTENSIONS_DIR) + sizeof(SYS_EXT_DIR) + 3];
+  char *pslash;
+
+  // sysclasspath, java_home, dll_dir
+  {
+    char *end;
+
+    // Found the full path to libjvm.so.
+    // Now cut the path to <java_home>/jre if we can.
+    os::jvm_path(buf, sizeof(buf));
+
+    if ((pslash = strrchr(buf, '/')) != nullptr) {
+      *pslash = '\0';            // Get rid of /libjvm.so.
+    }
+    if ((pslash = strrchr(buf, '/')) != nullptr) {
+      *pslash = '\0';            // Get rid of /{client|server|hotspot}.
+    }
+    Arguments::set_dll_dir(buf);
+
+    if (pslash != nullptr) {
+      if ((pslash = strrchr(buf, '/')) != nullptr) {
+        *pslash = '\0';          // Get rid of /lib.
+      }
+    }
+    Arguments::set_java_home(buf);
+    if (!set_boot_path('/', ':')) {
+      vm_exit_during_initialization("Failed setting boot class path.", nullptr);
+    }
+    end = buf;
+    (void)end;
+  }
+
+  // Where to look for native libraries.
+  //
+  // Everything is statically linked, so this path never actually loads a
+  // shared object; it is what java.lang.ClassLoader stats before handing a
+  // System.loadLibrary() call down to the (always-succeeding) os::dll_load.
+  // The embedder stages placeholder .so files in <java_home>/lib, so the dll
+  // dir and the JVM variant dir under it have to be on the path or the Java
+  // side throws UnsatisfiedLinkError before the VM is ever asked.
+  {
+    char *ld_library_path;
+    const char *v = ::getenv("LD_LIBRARY_PATH");
+    if (v == nullptr) {
+      v = "";
+    }
+    const char *dll_dir = Arguments::get_dll_dir();
+
+    size_t pathsize = strlen(v) + 1 + 2 * strlen(dll_dir) + sizeof("/" JVM_VARIANT) +
+                      sizeof(SYS_EXT_DIR) + sizeof("/lib/") +
+                      strlen(DEFAULT_LIBPATH) + 5;
+    ld_library_path = NEW_C_HEAP_ARRAY(char, pathsize, mtInternal);
+    jio_snprintf(ld_library_path, pathsize, "%s%s%s:%s/" JVM_VARIANT ":"
+                 SYS_EXT_DIR "/lib:" DEFAULT_LIBPATH,
+                 v, (*v == '\0' ? "" : ":"), dll_dir, dll_dir);
+    Arguments::set_library_path(ld_library_path);
+    FREE_C_HEAP_ARRAY(char, ld_library_path);
+  }
+
+  // Extensions directories.
+  jio_snprintf(buf, sizeof(buf), "%s" EXTENSIONS_DIR ":" SYS_EXT_DIR EXTENSIONS_DIR,
+               Arguments::get_java_home());
+  Arguments::set_ext_dirs(buf);
+
+#undef DEFAULT_LIBPATH
+#undef SYS_EXT_DIR
+#undef EXTENSIONS_DIR
+}
