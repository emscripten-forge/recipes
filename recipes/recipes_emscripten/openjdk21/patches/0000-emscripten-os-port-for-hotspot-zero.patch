+#include "precompiled.hpp"
+#include "logging/log.hpp"
+#include "runtime/os.inline.hpp"
+#include "services/attachListener.hpp"
+
+// The attach mechanism on the other POSIX ports is a UNIX domain socket that a
+// separate client process connects to. A WebAssembly module has neither: it is
+// a single process inside a sandbox with no filesystem the outside world can
+// reach and no way for another process to signal it. So the platform half of
+// the attach listener is present only to satisfy the linker - every entry point
+// reports "unavailable" and the shared code never starts a listener thread.
+
+AttachOperation* AttachListener::dequeue() {
+  // The listener thread is never started, so nothing can ever be queued.
+  return nullptr;
+}
+
+void AttachListener::vm_start() {
+  // No .java_pid file is ever created, so there is no stale one to clean up.
+}
+
+int AttachListener::pd_init() {
+  // Non-zero tells the shared code initialization failed and keeps the
