diff --git a/make/common/NativeCompilation.gmk b/make/common/NativeCompilation.gmk
index 24e76ddc2..43e7fbb4b 100644
--- a/make/common/NativeCompilation.gmk
+++ b/make/common/NativeCompilation.gmk
@@ -38,6 +38,21 @@ endif
 # Create exported symbols file for static libraries
 ################################################################################
 
+# The no-mapfile fallback below reads the archive with nm. The Mach-O form
+# (-m, then keep the __TEXT entries) is what the static build has always used,
+# but llvm-nm ignores -m for wasm objects and prints the plain "addr type name"
+# columns instead, so that filter matches nothing and the pipeline fails.
+# Select the defined text symbols directly for emscripten; its ABI has no
+# leading underscore, so the names are already what the linker expects.
+ifeq ($(OPENJDK_TARGET_OS), emscripten)
+  ARCHIVE_SYMBOLS_CMD = $(NM) $(NMFLAGS) --defined-only
+  ARCHIVE_SYMBOLS_FILTER = $(GREP) " T "
+else
+  ARCHIVE_SYMBOLS_CMD = $(NM) $(NMFLAGS) -m
+  ARCHIVE_SYMBOLS_FILTER = $(GREP) "__TEXT" | \
+      $(EGREP) -v "non-external|private extern|__TEXT,__eh_frame"
+endif
+
 # get the exported symbols from mapfiles and if there
 # is no mapfile, get them from the archive
 define GetSymbols
@@ -53,8 +68,7 @@ define GetSymbols
         $(CUT) -d ' ' -f 3 >>  $$(@D)/$$(basename $$(@F)).symbols || true;\
   else \
     $(ECHO) "Getting symbols from nm"; \
-    $(NM) $(NMFLAGS) -m $$($1_TARGET) | $(GREP)  "__TEXT" | \
-        $(EGREP) -v "non-external|private extern|__TEXT,__eh_frame" | \
+    $(ARCHIVE_SYMBOLS_CMD) $$($1_TARGET) | $(ARCHIVE_SYMBOLS_FILTER) | \
         $(SED) -e  's/.* //' > $$(@D)/$$(basename $$(@F)).symbols; \
   fi
 endef
