+/*
+ * com.sun.management.internal.OperatingSystemImpl for emscripten.
+ *
+ * The unix implementation needs <sys/sysinfo.h>, <sys/swap.h> and /proc,
+ * none of which exist in a wasm module. Here "memory" is the wasm memory:
+ * total = the most it may grow to, free = what is not yet in use. There is
+ * no swap and no host CPU accounting; the process CPU time is the monotonic
+ * run time, and loads are reported as unavailable (-1), as the unix code does
+ * when it cannot read them.
+ */
+
+#include <emscripten/heap.h>
+#include <emscripten/threading.h>
+#include <limits.h>
+#include <sys/resource.h>
+#include <time.h>
+#include <unistd.h>
+
+#include "jni.h"
+#include "com_sun_management_internal_OperatingSystemImpl.h"
+
+JNIEXPORT void JNICALL
+Java_com_sun_management_internal_OperatingSystemImpl_initialize0
+  (JNIEnv *env, jclass cls)
+{
+}
+
+JNIEXPORT jlong JNICALL
+Java_com_sun_management_internal_OperatingSystemImpl_getCommittedVirtualMemorySize0
+  (JNIEnv *env, jobject mbean)
+{
+    return (jlong) emscripten_get_heap_size();
+}
+
+JNIEXPORT jlong JNICALL
+Java_com_sun_management_internal_OperatingSystemImpl_getTotalSwapSpaceSize0
+  (JNIEnv *env, jobject mbean)
+{
+    return 0;
+}
+
+JNIEXPORT jlong JNICALL
+Java_com_sun_management_internal_OperatingSystemImpl_getFreeSwapSpaceSize0
+  (JNIEnv *env, jobject mbean)
+{
+    return 0;
+}
+
+JNIEXPORT jlong JNICALL
+Java_com_sun_management_internal_OperatingSystemImpl_getProcessCpuTime0
+  (JNIEnv *env, jobject mbean)
+{
+    struct timespec ts;
+    if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0) {
+        return -1;
+    }
+    return (jlong) ts.tv_sec * 1000000000LL + ts.tv_nsec;
+}
+
+JNIEXPORT jlong JNICALL
+Java_com_sun_management_internal_OperatingSystemImpl_getFreeMemorySize0
+  (JNIEnv *env, jobject mbean)
+{
+    /* memory the module can still grow into, plus what malloc has free is
+       not tracked separately here */
+    size_t max = emscripten_get_heap_max();
+    size_t cur = emscripten_get_heap_size();
+    return (jlong) (max > cur ? max - cur : 0);
+}
+
+JNIEXPORT jlong JNICALL
+Java_com_sun_management_internal_OperatingSystemImpl_getTotalMemorySize0
+  (JNIEnv *env, jobject mbean)
+{
+    return (jlong) emscripten_get_heap_max();
+}
+
+JNIEXPORT jlong JNICALL
+Java_com_sun_management_internal_OperatingSystemImpl_getOpenFileDescriptorCount0
+  (JNIEnv *env, jobject mbean)
+{
+    return -1;
+}
+
+JNIEXPORT jlong JNICALL
+Java_com_sun_management_internal_OperatingSystemImpl_getMaxFileDescriptorCount0
+  (JNIEnv *env, jobject mbean)
+{
+    struct rlimit rlp;
+    if (getrlimit(RLIMIT_NOFILE, &rlp) == 0) {
+        return (jlong) rlp.rlim_cur;
+    }
+    return -1;
+}
+
+JNIEXPORT jdouble JNICALL
+Java_com_sun_management_internal_OperatingSystemImpl_getCpuLoad0
+  (JNIEnv *env, jobject dummy)
+{
+    return -1.0;
+}
+
+JNIEXPORT jdouble JNICALL
+Java_com_sun_management_internal_OperatingSystemImpl_getProcessCpuLoad0
+  (JNIEnv *env, jobject dummy)
+{
+    return -1.0;
+}
+
+JNIEXPORT jdouble JNICALL
+Java_com_sun_management_internal_OperatingSystemImpl_getSingleCpuLoad0
+  (JNIEnv *env, jobject mbean, jint cpu_number)
+{
+    return -1.0;
+}
+
+JNIEXPORT jint JNICALL
+Java_com_sun_management_internal_OperatingSystemImpl_getHostConfiguredCpuCount0
+  (JNIEnv *env, jobject mbean)
+{
+    return emscripten_num_logical_cores();
+}
+
+JNIEXPORT jint JNICALL
+Java_com_sun_management_internal_OperatingSystemImpl_getHostOnlineCpuCount0
+  (JNIEnv *env, jobject mbean)
+{
+    return emscripten_num_logical_cores();
+}
+
+JNIEXPORT jlong JNICALL
+Java_com_sun_management_internal_OperatingSystemImpl_getHostTotalCpuTicks0
+  (JNIEnv *env, jobject mbean)
+{
+    return -1;
+}
