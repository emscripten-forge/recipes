diff --git a/make/modules/jdk.management/Lib.gmk b/make/modules/jdk.management/Lib.gmk
index a837e841e..06e374547 100644
--- a/make/modules/jdk.management/Lib.gmk
+++ b/make/modules/jdk.management/Lib.gmk
@@ -41,13 +41,17 @@ ifeq ($(call isTargetOs, linux), true)
   endif
 endif
 
-# The emscripten sysroot has neither <sys/swap.h> nor <sys/sysinfo.h>, and the
-# swap/load statistics OperatingSystemImpl.c reports have no meaning inside a
-# wasm sandbox, so this library is not built there.
-ifeq ($(call isTargetOs, emscripten), false)
+# The emscripten sysroot has neither <sys/swap.h> nor <sys/sysinfo.h>, and
+# the swap/load statistics the unix OperatingSystemImpl.c reports have no
+# meaning inside a wasm sandbox: emscripten builds the shared sources plus its
+# own OperatingSystemImpl_emscripten.c instead.
+ifeq ($(call isTargetOs, emscripten), true)
+  LIBMANAGEMENT_EXT_EXCLUDE_FILES := OperatingSystemImpl.c
+endif
 
 $(eval $(call SetupJdkLibrary, BUILD_LIBMANAGEMENT_EXT, \
     NAME := management_ext, \
+    EXCLUDE_FILES := $(LIBMANAGEMENT_EXT_EXCLUDE_FILES), \
     OPTIMIZATION := $(LIBMANAGEMENT_EXT_OPTIMIZATION), \
     DISABLED_WARNINGS_clang_UnixOperatingSystem.c := format-nonliteral, \
     CFLAGS := $(CFLAGS_JDKLIB) $(LIBMANAGEMENT_EXT_CFLAGS), \
@@ -61,5 +65,3 @@ $(eval $(call SetupJdkLibrary, BUILD_LIBMANAGEMENT_EXT, \
 $(BUILD_LIBMANAGEMENT_EXT): $(call FindLib, java.base, java)
 
 TARGETS += $(BUILD_LIBMANAGEMENT_EXT)
-
-endif
