       # Copy app-level options
       self$options <- getCurrentAppState()$options
@@ -1477,7 +1478,7 @@ ShinySession <- R6Class(
               },
               catch = function(cond) {
                 if (inherits(cond, "shiny.custom.error")) {
-                  if (isTRUE(getOption("show.error.messages"))) printError(cond)
+                  .safePrintOutputError(cond)
                   structure(list(), class = "try-error", condition = cond)
                 } else if (inherits(cond, "shiny.output.cancel")) {
                   structure(list(), class = "cancel-output")
@@ -1495,11 +1496,14 @@ ShinySession <- R6Class(
                   # the code below can send the error to the browser.
                   structure(list(), class = "try-error", condition = cond)
                 } else {
-                  if (isTRUE(getOption("show.error.messages"))) printError(cond)
+                  .safePrintOutputError(cond)
                   if (getOption("shiny.sanitize.errors", FALSE)) {
                     cond <- sanitized_error()
                   }
-                  self$unhandledError(cond, close = FALSE)
+                  tryCatch(
+                    self$unhandledError(cond, close = FALSE),
+                    error = function(e) invisible()
+                  )
                   invisible(structure(list(), class = "try-error", condition = cond))
                 }
               }
@@ -1540,6 +1544,12 @@ ShinySession <- R6Class(
               private$sendMessage(recalculating = list(
                 name = name, status = 'recalculated'
               ))
+              # Client leaves progress after recalculated; allow the next
+              # invalidation to send progress again (Chrome wasm refreshes can
+              # re-enter before flushOutput clears progressKeys).
+              if (name %in% private$progressKeys) {
+                private$progressKeys <- setdiff(private$progressKeys, name)
+              }
 
               if (inherits(value, "cancel-output")) {
                 return()
@@ -1591,6 +1601,34 @@ ShinySession <- R6Class(
       if (private$busyCount > 0)
         return()
 
+      # Drop bogus keys (legacy R6 default was the string "character").
+      if (identical(private$progressKeys, "character")) {
+        private$progressKeys <- character(0)
+      }
+      out_names <- names(private$.outputs)
+      private$progressKeys <- intersect(private$progressKeys, out_names)
+
+      # Do not complete a flush while real outputs marked in-progress
+      # (progressKeys) lack a value/error — e.g. wasm plot promise still pending.
+      # Hidden/suspended outputs are invalidated but won't run until shown; don't
+      # block the flush waiting for them.
+      if (length(private$progressKeys) > 0) {
+        pending_keys <- private$progressKeys
+        pending_keys <- pending_keys[!vapply(
+          pending_keys, private$shouldSuspend, logical(1), USE.NAMES = FALSE
+        )]
+        if (length(pending_keys) > 0) {
+          awaiting <- !vapply(pending_keys, function(k) {
+            private$invalidatedOutputValues$containsKey(k) ||
+              private$invalidatedOutputErrors$containsKey(k)
+          }, logical(1), USE.NAMES = FALSE)
+          if (length(awaiting) > 0 && any(awaiting)) {
+            appsNeedingFlush$set(self$token, self)
+            return(invisible())
+          }
+        }
+      }
+
       appsNeedingFlush$remove(self$token)
 
       if (self$isClosed())
@@ -1687,11 +1725,21 @@ ShinySession <- R6Class(
       if (self$closed)
         return()
 
-      if (!id %in% private$progressKeys) {
+      # Legacy R6 default was the string "character", not character(0).
+      if (identical(private$progressKeys, "character")) {
+        private$progressKeys <- character(0)
+      }
+
+      already <- id %in% private$progressKeys
+      if (!already) {
         private$progressKeys <- c(private$progressKeys, id)
       }
 
-      self$sendProgress('binding', list(id = id, persistent = persistent))
+      # Non-persistent progress while already running violates the client
+      # output state machine (e.g. wasm plot deferred across invalidations).
+      if (!already || isTRUE(persistent)) {
+        self$sendProgress('binding', list(id = id, persistent = persistent))
+      }
     },
     sendProgress = function(type, message) {
       private$sendMessage(
