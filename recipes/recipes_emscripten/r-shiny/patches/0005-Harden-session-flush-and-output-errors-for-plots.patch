From: Isabel Paredes <isabel.paredes@quantstack.net>
Date: Fri, 4 Sep 2026 12:46:59 +0200
Subject: [PATCH 5/6] Harden session flush and output errors for plots

---
 R/conditions.R | 20 ++++++++++++++++-
 R/shiny.R      | 60 +++++++++++++++++++++++++++++++++++++++++++++-----
 R/utils.R      | 25 ++++++++++++++++-----
 3 files changed, 92 insertions(+), 13 deletions(-)

diff --git a/R/conditions.R b/R/conditions.R
index 46c4cc9..38432d6 100644
--- a/R/conditions.R
+++ b/R/conditions.R
@@ -205,6 +205,10 @@ getCallCategories <- function(calls) {
 #' @rdname stacktrace
 #' @export
 captureStackTraces <- function(expr) {
+  # Chromium wasm workers have a shallow JS stack; deep stack capture overflows.
+  if (isWasmPlotHost()) {
+    return(force(expr))
+  }
   with_promise_domain(
     createStackTracePromiseDomain(),
     expr
@@ -397,7 +401,21 @@ printError <- function(cond,
   warning(call. = FALSE, immediate. = TRUE, sprintf("Error in %s: %s",
     getCallNames(list(conditionCall(cond))), conditionMessage(cond)))
 
-  printStackTrace(cond, full = full, offset = offset)
+  # On wasm hosts, skip stack traces: they are already omitted in captureStackTraces(),
+  # and printStackTrace() can prevent defineOutput's catch handler from returning
+  # try-error so errors never reach the client (see .safePrintOutputError).
+  if (!isWasmPlotHost()) {
+    printStackTrace(cond, full = full, offset = offset)
+  }
+}
+
+#' Print an output error without aborting error handling on wasm hosts.
+#' @noRd
+.safePrintOutputError <- function(cond) {
+  if (!isTRUE(getOption("show.error.messages"))) {
+    return(invisible())
+  }
+  tryCatch(printError(cond), error = function(e) invisible())
 }
 
 #' @rdname stacktrace
