+          return()
 
         handle <- getOption('shiny.error')
         if (is.function(handle)) handle()
@@ -1605,7 +1617,8 @@ hybrid_chain <- function(expr, ..., catch = NULL, finally = NULL,
 
             valueWithVisible(result)
           }
-        })
+        }
+        if (isWasmPlotHost()) runExpr() else captureStackTraces(runExpr())
       },
       error = function(e) {
         if (!is.null(catch))
