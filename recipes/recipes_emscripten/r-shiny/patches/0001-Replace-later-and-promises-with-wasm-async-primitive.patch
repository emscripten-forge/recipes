diff --git a/R/wasm-async.R b/R/wasm-async.R
new file mode 100644
index 0000000..6957e11
--- /dev/null
+++ b/R/wasm-async.R
@@ -0,0 +1,415 @@
+# Wasm async primitives: later + promises replacements.
+#
+# Chromium dedicated workers throttle later's emscripten_set_timeout backend,
+# so this Shiny build never calls r-later / r-promises. Deferred work uses
+# Shiny timerCallbacks + the Lucent host (SCHEDULE_DELAY / NEED_SERVICE), which
+# are paced with main-thread setTimeout → requestAnimationFrame.
+
+# ---- later replacement -----------------------------------------------------
+
+#' Schedule `func` after `delay` seconds via host-friendly timers.
+#' @noRd
+later <- function(func, delay = 0, loop = NULL) {
+  force(func)
+  millis <- max(0, as.numeric(delay)[1] * 1000)
+  if (!is.finite(millis)) {
+    millis <- 0
+  }
+  scheduleTask(millis, func)
+  invisible()
+}
+
+#' Run due Shiny timer callbacks (stand-in for later::run_now).
+#' @noRd
+run_now <- function(timeoutSecs = 0, all = TRUE, loop = NULL) {
+  # Drain due timers. Cap iterations so a buggy 0-delay reschedule cannot hang.
+  for (i in seq_len(1000L)) {
+    if (!(timerCallbacks$timeToNextEvent() <= 0)) {
+      return(invisible(i > 1L))
+    }
+    if (!isTRUE(timerCallbacks$executeElapsed())) {
+      return(invisible(i > 1L))
+    }
+    if (!isTRUE(all)) {
+      return(invisible(TRUE))
+    }
+  }
+  invisible(TRUE)
+}
+
+#' Seconds until next timer (Inf if none).
+#' @noRd
+next_op_secs <- function(loop = NULL) {
+  ms <- timerCallbacks$timeToNextEvent()
+  if (!is.finite(ms)) {
+    return(Inf)
+  }
+  max(0, ms / 1000)
+}
+
+#' TRUE when no timers are scheduled.
+#' @noRd
+loop_empty <- function(loop = NULL) {
+  !is.finite(timerCallbacks$timeToNextEvent())
+}
+
+#' TRUE when Shiny or wasm-promise timers are due now.
+#' @noRd
+.wasmTimersDue <- function() {
+  isTRUE(timerCallbacks$timeToNextEvent() <= 0) || isTRUE(next_op_secs() <= 0)
+}
+
+#' Run due timer callbacks up to `max` times; returns TRUE if any ran.
+#' @noRd
+.wasmDrainDueTimers <- function(max = 1000L) {
+  max <- as.integer(max[1])
+  if (length(max) == 0L || !is.finite(max) || max < 1L) {
+    max <- 1000L
+  }
+  ran <- FALSE
+  for (i in seq_len(max)) {
+    if (!(timerCallbacks$timeToNextEvent() <= 0)) {
+      break
+    }
+    if (!isTRUE(timerCallbacks$executeElapsed())) {
+      break
+    }
+    ran <- TRUE
+  }
+  ran
+}
+
+# ---- minimal promises replacement ------------------------------------------
+
+.WasmPromise <- function() {
+  env <- new.env(parent = emptyenv())
+  env$state <- "pending" # pending | fulfilled | rejected
+  env$value <- NULL
+  env$reason <- NULL
+  env$onFulfilled <- list()
+  env$onRejected <- list()
+  env$onFinally <- list()
+  structure(env, class = c("wasm_promise", "promise"))
+}
+
+is.promise <- function(x) {
+  inherits(x, "wasm_promise") || inherits(x, "promise")
+}
+
+is.promising <- function(x) {
+  is.promise(x)
+}
+
+as.promise <- function(x) {
+  if (is.promise(x)) {
+    return(x)
+  }
+  promise_resolve(x)
+}
+
+.promise_settle_fulfilled <- function(p, value) {
+  if (!identical(p$state, "pending")) {
+    return(invisible(p))
+  }
+  p$state <- "fulfilled"
+  p$value <- value
+  callbacks <- p$onFulfilled
+  finals <- p$onFinally
+  p$onFulfilled <- list()
+  p$onRejected <- list()
+  p$onFinally <- list()
+  # Force each callback into its own closure — a bare `function() cb(value)`
+  # would see only the last loop binding of `cb` (or none) when it later runs.
+  for (cb in callbacks) {
+    .promise_schedule(local({
+      f <- cb
+      v <- value
+      function() f(v)
+    }))
+  }
+  for (cb in finals) {
+    .promise_schedule(local({
+      f <- cb
+      function() f()
+    }))
+  }
+  invisible(p)
+}
+
+.promise_settle_rejected <- function(p, reason) {
+  if (!identical(p$state, "pending")) {
+    return(invisible(p))
+  }
+  p$state <- "rejected"
+  p$reason <- reason
+  callbacks <- p$onRejected
+  finals <- p$onFinally
+  p$onFulfilled <- list()
+  p$onRejected <- list()
+  p$onFinally <- list()
+  for (cb in callbacks) {
+    .promise_schedule(local({
+      f <- cb
+      r <- reason
+      function() f(r)
+    }))
+  }
+  for (cb in finals) {
+    .promise_schedule(local({
+      f <- cb
+      function() f()
+    }))
+  }
+  invisible(p)
+}
+
+.promise_schedule <- function(func) {
+  force(func)
+  # Defer to next host tick (JS-friendly: host setTimeout/rAF, not later).
+  scheduleTask(0, func)
+  invisible()
+}
+
+promise_resolve <- function(value) {
+  if (is.promise(value)) {
+    return(value)
+  }
+  p <- .WasmPromise()
+  .promise_settle_fulfilled(p, value)
+  p
+}
+
+promise_reject <- function(reason) {
+  p <- .WasmPromise()
+  .promise_settle_rejected(p, reason)
+  p
+}
+
+then <- function(promise, onFulfilled = NULL, onRejected = NULL) {
+  promise <- as.promise(promise)
+  next_p <- .WasmPromise()
+
+  handle_fulfill <- function(value) {
+    if (is.null(onFulfilled)) {
+      .promise_settle_fulfilled(next_p, value)
+      return()
+    }
+    tryCatch(
+      {
+        result <- onFulfilled(value)
+        if (is.promise(result)) {
+          then(
+            result,
+            function(v) .promise_settle_fulfilled(next_p, v),
+            function(e) .promise_settle_rejected(next_p, e)
+          )
+        } else {
+          .promise_settle_fulfilled(next_p, result)
+        }
+      },
+      error = function(e) .promise_settle_rejected(next_p, e)
+    )
+  }
+
+  handle_reject <- function(reason) {
+    if (is.null(onRejected)) {
+      .promise_settle_rejected(next_p, reason)
+      return()
+    }
+    tryCatch(
+      {
+        result <- onRejected(reason)
+        if (is.promise(result)) {
+          then(
+            result,
+            function(v) .promise_settle_fulfilled(next_p, v),
+            function(e) .promise_settle_rejected(next_p, e)
+          )
+        } else {
+          .promise_settle_fulfilled(next_p, result)
+        }
+      },
+      error = function(e) .promise_settle_rejected(next_p, e)
+    )
+  }
+
+  if (identical(promise$state, "fulfilled")) {
+    .promise_schedule(function() handle_fulfill(promise$value))
+  } else if (identical(promise$state, "rejected")) {
+    .promise_schedule(function() handle_reject(promise$reason))
+  } else {
+    promise$onFulfilled <- c(promise$onFulfilled, list(handle_fulfill))
+    promise$onRejected <- c(promise$onRejected, list(handle_reject))
+  }
+  next_p
+}
+
+catch <- function(promise, onRejected) {
+  then(promise, onRejected = onRejected)
+}
+
+# Named distinctly so callers with a `finally` parameter (promise_chain) can
+# invoke this without the parameter shadowing the helper.
+promise_finally <- function(promise, onFinally) {
+  promise <- as.promise(promise)
+  next_p <- .WasmPromise()
+  force(onFinally)
+
+  wrap <- function() {
+    tryCatch(onFinally(), error = function(e) NULL)
+  }
+
+  if (identical(promise$state, "fulfilled")) {
+    .promise_schedule(function() {
+      wrap()
+      .promise_settle_fulfilled(next_p, promise$value)
+    })
+  } else if (identical(promise$state, "rejected")) {
+    .promise_schedule(function() {
+      wrap()
+      .promise_settle_rejected(next_p, promise$reason)
+    })
+  } else {
+    promise$onFinally <- c(promise$onFinally, list(function() {
+      wrap()
+      if (identical(promise$state, "fulfilled")) {
+        .promise_settle_fulfilled(next_p, promise$value)
+      } else {
+        .promise_settle_rejected(next_p, promise$reason)
+      }
+    }))
+  }
+  next_p
+}
+
+finally <- function(promise, onFinally) {
+  promise_finally(promise, onFinally)
+}
+
+`%...>%` <- function(promise, onFulfilled) {
+  then(promise, onFulfilled = onFulfilled)
+}
+
+`%...!%` <- function(promise, onRejected) {
+  then(promise, onRejected = onRejected)
+}
+
+# Promise domains: extra named args (e.g. conn= for renderPrint) must be
+# top-level list fields — callers use domain$conn, matching promises::.
+new_promise_domain <- function(
+  wrapOnFulfilled = identity,
+  wrapOnRejected = identity,
+  wrapSync = force,
+  ...
+) {
+  list(
+    wrapOnFulfilled = wrapOnFulfilled,
+    wrapOnRejected = wrapOnRejected,
+    wrapSync = wrapSync,
+    ...
+  )
+}
+
+# Must live in an unlocked env: package namespace bindings are locked after load,
+# so `.current_promise_domain <<- ...` throws and breaks captureStackTraces /
+# every HTTP request that goes through withLogErrors.
+.wasmAsyncState <- new.env(parent = emptyenv())
+.wasmAsyncState$current_promise_domain <- NULL
+
+with_promise_domain <- function(domain, expr, replace = FALSE) {
+  old <- .wasmAsyncState$current_promise_domain
+  .wasmAsyncState$current_promise_domain <- domain
+  on.exit({
+    .wasmAsyncState$current_promise_domain <- old
+  }, add = TRUE)
+
+  wrapSync <- if (!is.null(domain$wrapSync)) domain$wrapSync else force
+  wrapSync(expr)
+}
+
+#' Like promises::hybrid_then — sync path unless `expr` yields a promise.
+#'
+#' When `tee = TRUE`, run the callback for side effects but return the original
+#' value / rethrow the original error (used by otel reactive-update wrappers).
+#' @noRd
+hybrid_then <- function(
+  expr,
+  on_success = NULL,
+  on_failure = NULL,
+  tee = FALSE,
+  ...
+) {
+  result_is_sync_error <- FALSE
+  result_visible <- withVisible(
+    tryCatch(
+      force(expr),
+      error = function(e) {
+        if (is.null(on_failure)) {
+          stop(e)
+        }
+        recovered <- withVisible(on_failure(e))
+        if (isTRUE(tee)) {
+          stop(e)
+        }
+        result_is_sync_error <<- TRUE
+        if (recovered$visible) recovered$value else invisible(recovered$value)
+      }
+    )
+  )
+
+  if (isTRUE(result_is_sync_error)) {
+    return(
+      if (result_visible$visible) result_visible$value else invisible(result_visible$value)
+    )
+  }
+
+  result <- result_visible$value
+
+  if (is.promising(result)) {
+    return(then(
+      result,
+      onFulfilled = function(value) {
+        if (is.null(on_success)) {
+          return(value)
+        }
+        if (isTRUE(tee)) {
+          tryCatch(on_success(value), error = function(e) NULL)
+          value
+        } else {
+          on_success(value)
+        }
+      },
+      onRejected = if (is.null(on_failure)) {
+        NULL
+      } else {
+        function(err) {
+          if (isTRUE(tee)) {
+            tryCatch(on_failure(err), error = function(e) NULL)
+            stop(err)
+          }
+          on_failure(err)
+        }
+      }
+    ))
+  }
+
+  if (is.null(on_success)) {
+    return(if (result_visible$visible) result else invisible(result))
+  }
+
+  if (isTRUE(tee)) {
+    tryCatch(on_success(result), error = function(e) NULL)
+    return(if (result_visible$visible) result else invisible(result))
+  }
+
+  on_success(result)
+}
+
+# OTEL helpers that used to live on promises — no-ops / passthrough for wasm.
+local_otel_promise_domain <- function(...) {
+  invisible()
+}
+
+with_otel_promise_domain <- function(expr, ...) {
+  force(expr)
+}
