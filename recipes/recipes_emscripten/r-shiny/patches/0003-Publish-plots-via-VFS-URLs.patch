+#' Wasm / Lucent plot rendering (Chromium shallow JS stack).
+#'
+#' Deferred drawPlot + simplified renderPlot; thematic font probing skipped when
+#' showtext/ragg are unavailable.
+
+#' @noRd
+.wasmPatchThematicFontProbe <- function() {
+  if (!isWasmPlotHost()) {
+    return(invisible(FALSE))
+  }
+  if (!"thematic" %in% loadedNamespaces()) {
+    return(invisible(FALSE))
+  }
+  if (isTRUE(getOption("shiny.wasm.thematicFontPatched"))) {
+    return(invisible(TRUE))
+  }
+  tenv <- asNamespace("thematic")
+  has_font_pkgs <- requireNamespace("showtext", quietly = TRUE) ||
+    requireNamespace("ragg", quietly = TRUE)
+  if (!has_font_pkgs && exists("resolve_font_family", envir = tenv, inherits = FALSE)) {
+    unlockBinding("resolve_font_family", tenv)
+    set_fam <- get("set_font_family", envir = tenv, inherits = FALSE)
+    assign("resolve_font_family", function(type = c("base", "grid")) {
+      set_fam("")
+    }, envir = tenv)
+    lockBinding("resolve_font_family", tenv)
+  }
+  options(shiny.wasm.thematicFontPatched = TRUE)
+  invisible(TRUE)
+}
+
+#' Deferred PNG draw for wasm: runs after flushReact via scheduleTask(0).
+#' Restores currentOutputName so thematic getCurrentOutputInfo() works.
+#' @noRd
+drawPlotWasm <- function(name, session, func, width, height, alt, pixelratio, res, ...) {
+  force(name)
+  force(session)
+  force(func)
+  force(width)
+  force(height)
+  force(alt)
+  force(pixelratio)
+  force(res)
+
+  p <- .WasmPromise()
+  ctx <- getCurrentContext()
+  scheduleTask(0, function() {
+    tryCatch({
+      priv <- session$.__enclos_env__$private
+      img <- with_promise_domain(
+        createVarPromiseDomain(priv, "currentOutputName", name),
+        ctx$run(function() {
+          outfile <- tempfile(fileext = ".png")
+          on.exit(unlink(outfile), add = TRUE)
+          device <- startPNG(
+            outfile,
+            width * pixelratio,
+            height * pixelratio,
+            res = res * pixelratio
+          )
+          value <- withVisible(func())
+          if (isTRUE(value$visible)) {
+            utils::capture.output(print(value$value))
+          }
+          coordmap <- tryCatch(
+            getCoordmap(value$value, width * pixelratio, height * pixelratio, res * pixelratio),
+            error = function(e) NULL
+          )
+          alt_txt <- if (anyNA(alt)) getAltText(value$value) else alt
+          grDevices::dev.off(device)
+          dropNulls(list(
+            src = plotPublishPng(name, outfile),
+            width = width,
+            height = height,
+            alt = alt_txt,
+            coordmap = coordmap,
+            error = attr(coordmap, "error", exact = TRUE)
+          ))
+        })
+      )
+      .promise_settle_fulfilled(p, img)
+    }, error = function(e) {
+      .promise_settle_rejected(p, e)
+    })
+  })
+  p
+}
+
+#' Wasm renderPlot: sync dims, no resizeSavedPlot / recordPlot path.
+#' @noRd
+renderPlotWasm <- function(
+  func = NULL,
+  width = "auto",
+  height = "auto",
+  res = 72,
+  ...,
+  alt = NA,
+  env = parent.frame(),
+  quoted = FALSE,
+  execOnResize = FALSE,
+  outputArgs = list(),
+  expr = NULL
+) {
+  if (is.null(func)) {
+    if (is.null(expr)) {
+      stop("`func` or `expr` must be supplied to renderPlotWasm", call. = FALSE)
+    }
+    # When renderPlot passes expr=expr, substitute(expr) inside this frame
+    # captures the symbol `expr`, not the plot body — capture from caller.
+    if (!quoted) {
+      expr <- eval(substitute(substitute(expr)), parent.frame())
+      quoted <- TRUE
+    }
+    func <- installExprFunction(
+      expr, "func", env, quoted = TRUE,
+      label = "renderPlot",
+      ..stacktraceon = TRUE
+    )
+  }
+  force(func)
+  args <- list(...)
+  alt_val <- alt
+
+  renderFunc <- function(shinysession, name, ...) {
+    w <- if (identical(width, "auto")) {
+      shinysession$clientData[[paste0("output_", name, "_width")]]
+    } else {
+      width
+    }
+    h <- if (identical(height, "auto")) {
+      shinysession$clientData[[paste0("output_", name, "_height")]]
+    } else {
+      height
+    }
+    pr <- shinysession$clientData$pixelratio
+    if (is.null(pr)) {
+      pr <- 1
+    }
+    do.call(drawPlotWasm, c(
+      list(name, shinysession, func, w, h, alt_val, pr, res),
+      args
+    ))
+  }
+
+  outputFunc <- plotOutput
+  if (!identical(height, "auto")) {
+    formals(outputFunc)["height"] <- list(NULL)
+  }
+
+  marked <- markRenderFunction(
+    outputFunc,
+    renderFunc,
+    outputArgs,
+    cacheHint = list(userExpr = installedFuncExpr(func), res = res)
+  )
+  class(marked) <- c("shiny.renderPlot", class(marked))
+  marked
+}
