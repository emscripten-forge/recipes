+
+  # Wasm / Lucent plot publishing defaults (overridable before library(shiny)).
+  # Enable URL-backed plots only under the wasm VFS R_HOME so host tests keep
+  # data: URL plot output.
+  if (is.null(getOption("shiny.wasm.plotUrl"))) {
+    options(shiny.wasm.plotUrl = identical(Sys.getenv("R_HOME"), "/lib/R"))
+  }
+  if (is.null(getOption("shiny.wasm.plotCacheDir"))) {
+    options(shiny.wasm.plotCacheDir = "/tmp/shiny-plots")
+  }
+  if (is.null(getOption("shiny.wasm.plotUrlPrefix"))) {
+    options(shiny.wasm.plotUrlPrefix = "shiny-plots")
+  }
+  if (isTRUE(getOption("shiny.wasm.plotUrl"))) {
+    cacheDir <- getOption("shiny.wasm.plotCacheDir", "/tmp/shiny-plots")
+    prefix <- getOption("shiny.wasm.plotUrlPrefix", "shiny-plots")
+    dir.create(cacheDir, recursive = TRUE, showWarnings = FALSE)
+    tryCatch(
+      addResourcePath(prefix, cacheDir),
+      error = function(e) {
+        warning("shiny wasm plot cache resource path: ", conditionMessage(e))
+      }
+    )
+    # Chromium dedicated workers have a small JS stack; hashing sys.calls() on
+    # every promise then (deepstacktrace) overflows during renderPlot.
+    if (is.null(getOption("shiny.deepstacktrace"))) {
+      options(shiny.deepstacktrace = FALSE)
+    }
+  }
 }
 
 
