+#' TRUE on wasm / Lucent in-browser hosts (URL-backed plot cache).
+#' @noRd
+isWasmPlotHost <- function() {
+  isTRUE(getOption("shiny.wasm.plotUrl", FALSE))
+}
+
+on_load({
+  if (isWasmPlotHost()) {
+    setHook(packageEvent("thematic", "onLoad"), function(...) {
+      .wasmPatchThematicFontProbe()
+    })
+    if ("thematic" %in% loadedNamespaces()) {
+      .wasmPatchThematicFontProbe()
+    }
+  }
+})
