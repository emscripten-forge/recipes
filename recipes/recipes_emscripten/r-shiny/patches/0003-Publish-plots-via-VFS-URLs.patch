+# Read PNG bytes from disk. On some wasm backends file.info() can report 0
+# before the flushed size is visible; readBin() is authoritative.
+plotPngFileData <- function(file) {
+  tryCatch(readBin(file, "raw", n = 1e9), error = function(e) raw())
+}
+
+plotPngDataUrl <- function(file, contentType = "image/png") {
+  fileData <- plotPngFileData(file)
+  if (length(fileData) == 0) {
+    return(NULL)
+  }
+  paste0("data:", contentType, ";base64,", rawToBase64(fileData))
+}
+
+plotImgHasSrc <- function(img) {
+  is.character(img$src) && nchar(img$src) > 30L
+}
+
+# Copy a file into the wasm plot cache and return its addResourcePath URL.
+# Returns NULL when shiny.wasm.plotUrl is false or file.copy fails.
+wasmPublishFileUrl <- function(name, file) {
+  if (!isTRUE(getOption("shiny.wasm.plotUrl", FALSE))) {
+    return(NULL)
+  }
+  cacheDir <- getOption("shiny.wasm.plotCacheDir", "/tmp/shiny-plots")
+  dir.create(cacheDir, recursive = TRUE, showWarnings = FALSE)
+  ext <- tools::file_ext(file)
+  if (!nzchar(ext)) {
+    ext <- "bin"
+  }
+  dest <- file.path(cacheDir, paste0(name, ".", ext))
+  if (!isTRUE(file.copy(file, dest, overwrite = TRUE))) {
+    return(NULL)
+  }
+  prefix <- getOption("shiny.wasm.plotUrlPrefix", "shiny-plots")
+  # Millisecond cache-buster: second resolution made rapid input changes reuse
+  # the same URL, so the browser kept showing a cached (stale) PNG.
+  paste0(prefix, "/", name, ".", ext, "?v=", as.character(round(as.numeric(Sys.time()) * 1000)))
+}
+
+# Publish a rendered PNG as either a Shiny static resource URL (wasm) or a
+# data: URL (default). On WASM, prefer the VFS URL path: readBin() right after
+# dev.off() often sees an empty file, while the browser can read it later via
+# addResourcePath() + readVfsFile() without embedding base64 in websocket JSON.
+plotPublishPng <- function(name, pngFile) {
+  url <- wasmPublishFileUrl(name, pngFile)
+  if (!is.null(url)) {
+    return(url)
+  }
+  plotPngDataUrl(pngFile, "image/png")
+}
