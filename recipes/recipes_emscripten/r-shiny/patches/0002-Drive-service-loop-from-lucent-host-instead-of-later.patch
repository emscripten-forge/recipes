@@ -0,0 +1,124 @@
+# Wasm / Lucent host service bridge.
+#
+# This Shiny build only runs under a browser host (Lucent). The host owns the
+# service loop via MessageChannel / rAF → serviceOnce(). After each SERVICE_TICK
+# the host arms the next delay from SERVICE_STATUS.nextDelayMs. scheduleTask()
+# outside a tick still uses scheduleHostDelay / requestHostService. There is no
+# later-based self-scheduling and no idle heartbeat.
+
+# Ask the JS host for an immediate service wake (NEED_SERVICE).
+.wasmHostRequestService <- function() {
+  tryCatch(
+    httpuv:::httpuv_eval_js(
+      "if (globalThis.Module && Module.httpuv && typeof Module.httpuv.requestHostService === 'function') { Module.httpuv.requestHostService(); }"
+    ),
+    error = function(e) invisible()
+  )
+  invisible()
+}
+
+# Ask the JS host to wake after `delayMs` (SCHEDULE_DELAY → setTimeout → MessageChannel).
+.wasmHostScheduleDelay <- function(delayMs) {
+  delayMs <- suppressWarnings(as.numeric(delayMs)[1])
+  if (length(delayMs) == 0 || !is.finite(delayMs)) {
+    return(invisible())
+  }
+  delayMs <- max(0, delayMs)
+  delay_js <- format(delayMs, scientific = FALSE, trim = TRUE)
+  tryCatch(
+    httpuv:::httpuv_eval_js(sprintf(
+      "if (globalThis.Module && Module.httpuv && typeof Module.httpuv.scheduleHostDelay === 'function') { Module.httpuv.scheduleHostDelay(%s); }",
+      delay_js
+    )),
+    error = function(e) invisible()
+  )
+  invisible()
+}
+
+# Ms until the next timerCallbacks deadline, or Inf when idle.
+# No idle heartbeat: when nothing is scheduled the host waits for push wakes
+# (NEED_SERVICE from HTTP/WS, scheduleTask, or visibilitychange).
+.wasmHostNextDelayMs <- function() {
+  delay <- timerCallbacks$timeToNextEvent()
+  if (!is.finite(delay)) {
+    return(Inf)
+  }
+  max(0, delay)
+}
+
+.wasmHostMaybeScheduleNext <- function() {
+  if (!isRunning() || isTRUE(.globals$stopped)) {
+    return(invisible())
+  }
+  delay_ms <- .wasmHostNextDelayMs()
+  if (!is.finite(delay_ms)) {
+    return(invisible())
+  }
+  if (delay_ms <= 0) {
+    .wasmHostRequestService()
+  } else {
+    .wasmHostScheduleDelay(delay_ms)
+  }
+  invisible()
+}
+
+#' Defer work to the next host service turn via [scheduleTask()] (0ms).
+#' @param callback Zero-argument function.
+#' @keywords internal
+#' @noRd
+.wasmHostDefer <- function(callback) {
+  force(callback)
+  scheduleTask(0, callback)
+  invisible()
+}
+
+#' Suspend the host-driven service loop
+#'
+#' Bumps the internal service-generation token. Used by Lucent while pushing
+#' HTTP work through `evalR`.
+#'
+#' @seealso [resumeServiceLoop()], [serviceOnce()], [startApp()]
+#' @export
+suspendServiceLoop <- function() {
+  if (!isRunning()) {
+    return(invisible())
+  }
+  .globals$serviceGeneration <- (.globals$serviceGeneration %||% 0L) + 1L
+  invisible()
+}
+
+#' Resume the host-driven service loop
+#'
+#' Signals the host for an immediate [serviceOnce()] tick.
+#'
+#' @seealso [suspendServiceLoop()], [serviceOnce()], [startApp()]
+#' @export
+resumeServiceLoop <- function() {
+  if (!isRunning()) {
+    return(invisible())
+  }
+  .wasmHostRequestService()
+  invisible()
+}
+
+#' Run one host-driven Shiny service tick
+#'
+#' Runs [serviceApp()] (which batch-drains due timers and reactive flushes).
+#' The Lucent host learns the next wake delay from `SERVICE_STATUS.nextDelayMs`
+#' (via `serviceOnceHadWork`); this function does not call `scheduleHostDelay`.
+#'
+#' @return Invisibly, `TRUE` if another immediate host tick is warranted,
+#'   otherwise `FALSE`.
+#' @seealso [suspendServiceLoop()], [resumeServiceLoop()]
+#' @export
+serviceOnce <- function() {
+  had_work <- FALSE
+  has_srv <- !is.null(getShinyOption("server", default = NULL))
+  if (has_srv) {
+    serviceApp()
+    # Continue while timers are due OR a session still needs flushOutput (e.g.
+    # progressKeys awaiting a value after renderUI — must not report idle).
+    had_work <- .wasmTimersDue() || appsNeedingFlush$size() > 0L
+  }
+  invisible(had_work)
+}
