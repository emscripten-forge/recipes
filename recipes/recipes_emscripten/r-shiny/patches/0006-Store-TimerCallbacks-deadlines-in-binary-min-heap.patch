+# ---- Binary min-heap for timer deadlines (1-based) -------------------------
+# Each entry is a list(time=, scheduled=, id=). Replaces sorted data.frame +
+# rbind/order which was O(n log n) per schedule.
+
+.timerHeapSwap <- function(heap, i, j) {
+  tmp <- heap[[i]]
+  heap[[i]] <- heap[[j]]
+  heap[[j]] <- tmp
+  heap
+}
+
+.timerHeapSiftUp <- function(heap, i) {
+  while (i > 1L) {
+    parent <- as.integer(i / 2L)
+    if (heap[[parent]]$time <= heap[[i]]$time) {
+      break
+    }
+    heap <- .timerHeapSwap(heap, parent, i)
+    i <- parent
+  }
+  heap
+}
+
+.timerHeapSiftDown <- function(heap, i) {
+  n <- length(heap)
+  repeat {
+    left <- 2L * i
+    right <- left + 1L
+    smallest <- i
+    if (left <= n && heap[[left]]$time < heap[[smallest]]$time) {
+      smallest <- left
+    }
+    if (right <= n && heap[[right]]$time < heap[[smallest]]$time) {
+      smallest <- right
+    }
+    if (identical(smallest, i)) {
+      break
+    }
+    heap <- .timerHeapSwap(heap, i, smallest)
+    i <- smallest
+  }
+  heap
+}
+
+.timerHeapPush <- function(heap, entry) {
+  heap[[length(heap) + 1L]] <- entry
+  .timerHeapSiftUp(heap, length(heap))
+}
+
+.timerHeapPopMin <- function(heap) {
+  n <- length(heap)
+  if (n == 0L) {
+    return(list(heap = heap, entry = NULL))
+  }
+  entry <- heap[[1L]]
+  if (n == 1L) {
+    return(list(heap = list(), entry = entry))
+  }
+  heap[[1L]] <- heap[[n]]
+  heap[[n]] <- NULL
+  list(heap = .timerHeapSiftDown(heap, 1L), entry = entry)
+}
+
+.timerHeapRemoveAt <- function(heap, idx) {
+  n <- length(heap)
+  if (idx < 1L || idx > n) {
+    return(heap)
+  }
+  if (idx == n) {
+    heap[[n]] <- NULL
+    return(heap)
+  }
+  heap[[idx]] <- heap[[n]]
+  heap[[n]] <- NULL
+  if (length(heap) == 0L) {
+    return(heap)
+  }
+  heap <- .timerHeapSiftUp(heap, idx)
+  .timerHeapSiftDown(heap, idx)
+}
+
+.timerEmptyElapsed <- function() {
+  data.frame(
+    time = numeric(),
+    scheduled = numeric(),
+    id = integer(),
+    stringsAsFactors = FALSE
+  )
+}
