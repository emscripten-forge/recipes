diff --git a/numba/core/wasm_trace.py b/numba/core/wasm_trace.py
new file mode 100644
index 0000000..b39fded
--- /dev/null
+++ b/numba/core/wasm_trace.py
@@ -0,0 +1,28 @@
+"""Small, opt-in educational trace for Numba's browser compilation path."""
+
+import os
+import sys
+
+
+def level():
+    if sys.platform != "emscripten":
+        return 0
+    value = os.environ.get("NUMBA_WASM_TRACE", "0").strip().lower()
+    if value in ("", "0", "false", "off", "no"):
+        return 0
+    if value in ("2", "verbose", "full"):
+        return 2
+    return 1
+
+
+def log(stage, message):
+    if level():
+        print(f"[Numba/WASM:{stage}] {message}", flush=True)
+
+
+def ir_summary(func_ir):
+    if func_ir is None:
+        return "no Numba IR"
+    blocks = len(func_ir.blocks)
+    statements = sum(len(block.body) for block in func_ir.blocks.values())
+    return f"{blocks} block(s), {statements} statement(s)"
