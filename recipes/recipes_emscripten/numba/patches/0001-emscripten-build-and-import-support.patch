@@ -7,6 +7,16 @@ import re
 import sys
 import warnings
 
+# Numba's native helper extensions provide functions that generated code calls
+# by name.  MCJIT learns those names through llvmlite.add_symbol().  Emscripten
+# instead resolves them when a JIT-produced SIDE_MODULE is dlopen()'d, so the
+# extensions must enter the process-wide dynamic symbol scope when first
+# imported.
+if sys.platform == "emscripten":
+    import os as _os
+    sys.setdlopenflags(sys.getdlopenflags() | _os.RTLD_GLOBAL)
+    del _os
+
 
