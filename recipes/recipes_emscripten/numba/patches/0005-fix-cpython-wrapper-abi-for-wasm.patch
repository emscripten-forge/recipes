+    def _unpack_tuple_wasm(self, args, n_min, n_max, objs):
+        """Non-variadic PyArg_UnpackTuple equivalent for WASM."""
+        i32 = ir.IntType(32)
+        result_ptr = self.builder.alloca(i32, name="unpack_result")
+        self.builder.store(ir.Constant(i32, 0), result_ptr)
+
+        size = self.tuple_size(args)
+        too_few = self.builder.icmp_signed(
+            "<", size, ir.Constant(self.py_ssize_t, int(n_min))
+        )
+        too_many = self.builder.icmp_signed(
+            ">", size, ir.Constant(self.py_ssize_t, int(n_max))
+        )
+        bad_count = self.builder.or_(too_few, too_many)
+
+        with self.builder.if_else(bad_count) as (then, otherwise):
+            with then:
+                self._err_bad_argument()
+            with otherwise:
+                for index, obj_ptr in enumerate(objs):
+                    item = self.tuple_getitem(args, index)
+                    self.builder.store(item, obj_ptr)
+                self.builder.store(ir.Constant(i32, 1), result_ptr)
+
+        return self.builder.load(result_ptr, name="unpack_ok")
