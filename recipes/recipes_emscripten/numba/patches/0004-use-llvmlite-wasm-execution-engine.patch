+class WasmJitEngine:
+    """JitEngine-compatible adapter around llvmlite's WASM engine."""
+
+    def __init__(self, wasm_engine):
+        self._ee = wasm_engine
+        self._defined_symbols = set()
+
+    def is_symbol_defined(self, name):
+        return name in self._defined_symbols
+
+    def _load_defined_symbols(self, module):
+        for values in (module.functions, module.global_variables):
+            self._defined_symbols.update(
+                value.name for value in values if not value.is_declaration
+            )
+
+    def add_module(self, module):
+        self._load_defined_symbols(module)
+        wasm_trace.log(
+            "wasm",
+            f"handing LLVM module {module.name!r} to llvmlite",
         )
+        return self._ee.add_module(module)
+
+    def add_global_mapping(self, gv, addr):
+        self._defined_symbols.add(gv.name)
+
+    def finalize_object(self):
+        return self._ee.finalize_object()
+
+    def get_function_address(self, name):
+        address = self._ee.get_function_address(name)
+        wasm_trace.log(
+            "wrapper",
+            f"{name!r} is callable at WASM table index {address}",
+        )
+        return address
+
+    def get_global_value_address(self, name):
+        return self._ee.get_global_value_address(name)
+
+    def set_object_cache(self, *args, **kwargs):
+        return self._ee.set_object_cache(*args, **kwargs)
+
+    def enable_jit_events(self):
+        return False
 
 
