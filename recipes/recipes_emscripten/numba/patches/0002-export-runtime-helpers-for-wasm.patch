diff --git a/numba/_numba_common.h b/numba/_numba_common.h
index d458e42..7b27a27 100644
--- a/numba/_numba_common.h
+++ b/numba/_numba_common.h
@@ -10,7 +10,15 @@
  * but are not exposed outside of a shared library or executable.
  * Note this is default behaviour for global symbols under Windows.
  */
-#if defined(_MSC_VER)
+#if defined(__EMSCRIPTEN__)
+    /*
+     * Generated WASM SIDE_MODULEs resolve Numba runtime helpers by name.
+     * Keep those helpers visible from the extension SIDE_MODULE that owns
+     * them.  Native builds retain Numba's usual hidden-symbol policy.
+     */
+    #define VISIBILITY_HIDDEN __attribute__ ((visibility("default")))
+    #define VISIBILITY_GLOBAL __attribute__ ((visibility("default")))
+#elif defined(_MSC_VER)
     #define VISIBILITY_HIDDEN
     #define VISIBILITY_GLOBAL __declspec(dllexport)
 #elif (__has_attribute(visibility) || (defined(__GNUC__) && __GNUC__ >= 4))
